  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fi",
    "@value" : "Asiakkaalla on tämä rooli (hakija, käyttäjä tai etuuden saaja). Sama asiakas voi olla useassa roolissa samanaikaisesti tai eri yhteyksissä."
  }, {
    "@language" : "en",
    "@value" : "The customer has this role (applicant, user or beneficiary). The same customer may hold several roles simultaneously or in different contexts."
