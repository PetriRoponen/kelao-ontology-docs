    "@id" : "_:genid1"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://kela.fi/ontology/kelao#roleOfCustomer"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relation stating a role (applicant, user or beneficiary) in which a customer acts."
  }, {
    "@language" : "fi",
    "@value" : "Suhde, joka ilmaisee roolin (hakija, käyttäjä tai etuudensaaja), jossa asiakas toimii."
  } ],
