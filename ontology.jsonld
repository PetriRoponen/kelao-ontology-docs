  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://iri.suomi.fi/terminology/kela/c529"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fi",
    "@value" : "Asumisedellytys (sanasto c529): etuudenhakijan täytyy asua Suomessa, EU- tai Eta-maassa tai Sveitsissä."
