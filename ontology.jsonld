    "@value" : "municipality group"
  } ],
  "http://www.w3.org/2004/02/skos/core#relatedMatch" : [ {
    "@id" : "https://iri.suomi.fi/terminology/kela/c552"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "fi",
    "@value" : "Käytetään kelao:Municipality-instansseilla. Lähdeontologiassa nimellä kuntaryhma."
  } ]
}, {
  "@id" : "https://kela.fi/ontology/kelao#noteworthy",
