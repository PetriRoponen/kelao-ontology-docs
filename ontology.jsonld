}, {
  "@id" : "https://kela.fi/ontology/kelao#inhibiting",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://purl.org/dc/terms/source" : [ {
    "@id" : "https://iri.suomi.fi/terminology/kela/c66"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fi",
    "@value" : "Esimerkiksi työkyvyttömyyseläke on estävä etuus ansiopäivärahan, yleistuen ja opintotuen suhteen. Käsite: sanasto c66 (estävä etuus)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://kela.fi/ontology/kelao#Benefit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://kela.fi/ontology/kelao"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fi",
    "@value" : "estävä etuus"
  }, {
    "@language" : "sv",
    "@value" : "hindrande förmån"
  }, {
    "@language" : "en",
    "@value" : "inhibiting benefit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://kela.fi/ontology/kelao#Benefit"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relation stating a benefit taken into account that prevents this benefit from being granted to the applicant."
  }, {
    "@language" : "fi",
    "@value" : "Suhde, joka ilmaisee huomioon otettavan etuuden, jonka vuoksi etuudenhakijalle ei myönnetä tätä etuutta."
  }, {
    "@language" : "sv",
    "@value" : "förmån som ska beaktas och på grund av vilken den förmånssökande inte beviljas en annan förmån"
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "fi",
    "@value" : "estävä etuus"
  }, {
    "@language" : "sv",
    "@value" : "hindrande förmån"
  }, {
    "@language" : "en",
    "@value" : "inhibiting benefit"
  } ],
  "http://www.w3.org/2004/02/skos/core#relatedMatch" : [ {
    "@id" : "https://iri.suomi.fi/terminology/kela/c66"
  } ],
