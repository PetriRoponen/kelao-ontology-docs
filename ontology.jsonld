  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "fi",
    "@value" : "Tieto siitä, edellyttääkö etuuden saaminen asumisedellytyksen täyttymistä."
  }, {
    "@language" : "en",
    "@value" : "Whether entitlement to the benefit requires that the residence condition is met."
  }, {
    "@language" : "sv",
    "@value" : "krav enligt vilket en förmånssökande ska bo i Finland, ett EU-land, ett EES-land eller Schweiz och en förmånslåtare vid sin död måste bo i något av dessa länder för att förmånssökanden ska ha rätt till en förmån"
  } ],
