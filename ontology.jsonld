  } ]
}, {
  "@id" : "https://kela.fi/ontology/kelao#processingTime",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fi",
    "@value" : "Arvo ilmaistaan xsd:duration-muodossa. Käsittelyaika arkipäivinä ilmaistaan samalla ominaisuudella (esim. 5,1 arkipäivää = P5DT19H12M); päällekkäinen ominaisuus kelao:processingTimeBusinessDays on poistettu tämän vuoksi versiossa 0.5.1."
  }, {
    "@language" : "en",
    "@value" : "Expressed in xsd:duration format. Processing time in business days is expressed with the same property (e.g. 5.1 business days = P5DT19H12M); the overlapping property kelao:processingTimeBusinessDays was removed for this reason in version 0.5.1."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://kela.fi/ontology/kelao#Benefit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "https://kela.fi/ontology/kelao"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "sv",
    "@value" : "handläggningstid"
  }, {
    "@language" : "fi",
    "@value" : "käsittelyaika"
  }, {
    "@language" : "en",
    "@value" : "processing time"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#duration"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Average processing time of an application from receipt to decision."
  }, {
    "@language" : "fi",
    "@value" : "Hakemuksen keskimääräinen käsittelyaika hakemuksen saapumisesta päätökseen."
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@language" : "fi",
    "@value" : "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."
  }, {
    "@language" : "en",
    "@value" : "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "sv",
    "@value" : "handläggningstid"
  }, {
    "@language" : "fi",
    "@value" : "käsittelyaika"
  }, {
    "@language" : "en",
    "@value" : "processing time"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "fi",
    "@value" : "xsd:duration ei kuulu OWL 2 DL -datatyyppikarttaan, mutta on tuettu kaikissa KELAO-kohdejärjestelmissä (GraphDB, Fuseki)."
  } ]
