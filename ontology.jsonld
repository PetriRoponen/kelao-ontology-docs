  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fi",
    "@value" : "Alue kuuluu tähän valtioon. Käytetään maakunnille, hyvinvointialueille, työllisyysalueille ja tarvittaessa suoraan kunnille."
  }, {
    "@language" : "en",
    "@value" : "The area belongs to this country. Used for regions, wellbeing service counties, employment areas and, where needed, directly for municipalities."
  } ],
