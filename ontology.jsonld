  }, {
    "@language" : "sv",
    "@value" : "Grupp av kommuner som bildats för beräkning av bostadsbidrag för pensionstagare, allmänt bostadsbidrag och studiestödets bostadstillägg och som den kommun där den förmånssökandes bostad finns tillhör på basis av hur dyrt boendet är."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "fi",
    "@value" : "kuntaryhmä"
  }, {
