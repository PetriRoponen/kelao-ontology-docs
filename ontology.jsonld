  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relation stating the benefit in whose calculation or means test an income item is taken into account."
  }, {
    "@language" : "fi",
    "@value" : "Suhde, joka ilmaisee etuuden, jonka määrää laskettaessa tai tarveharkinnassa tuloerä otetaan huomioon."
