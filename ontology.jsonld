    "@id" : "https://kela.fi/ontology/kelao"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is part of area"
  }, {
    "@language" : "fi",
    "@value" : "on osa aluetta"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://kela.fi/ontology/kelao#Location"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://kela.fi/ontology/kelao#containsArea"
  } ],
