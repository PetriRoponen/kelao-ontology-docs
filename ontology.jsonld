  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "fi",
    "@value" : "Täydentää suhteita kelao:inhibiting ja kelao:reducing (vrt. sanaston huomioon otettava etuus, c63). Nimi ja käyttöala tarkistettava."
