            rdfs:comment "Unique identifier in Wikidata."@en ,
                         "Maantieteellisen alueen Wikidata-tunniste."@fi ;
            rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
            rdfs:label "wikidata id"@en ,
                       "wikidata-tunniste"@fi ;
            skos:prefLabel "wikidata id"@en ,
                                  "wikidata-tunniste"@fi ;
            skos:scopeNote "Käytetään kelao:Location-instansseilla. Lähdeontologiassa nimellä wikiDataId."@fi .


#################################################################
#    Classes
#################################################################

###  http://data.europa.eu/eli/ontology#LegalResource
eli:LegalResource rdf:type owl:Class .


###  http://purl.org/vocab/cpsv#PublicService
cpsv:PublicService rdf:type owl:Class .


###  http://schema.org/DigitalDocument
schema:DigitalDocument rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
skos:ConceptScheme rdf:type owl:Class .


###  http://www.w3.org/ns/org#Organization
org:Organization rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Agent
prov:Agent rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Entity
prov:Entity rdf:type owl:Class .


###  https://kela.fi/ontology/kelao#Appeal
:Appeal rdf:type owl:Class ;
        rdfs:subClassOf prov:Entity ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Appeal"@en ,
                "Muutoksenhaku"@fi ,
                "Ändringssökande"@sv ;
        skos:altLabel "oikaisuvaatimus"@fi ,
                "valitus"@fi ;
        skos:definition "An applicant's request for rectification of or appeal against a decision."@en ,
                "Hakijan päätökseen kohdistama oikaisuvaatimus tai valitus."@fi ;
        skos:prefLabel "Appeal"@en ,
                "Muutoksenhaku"@fi ,
                "Ändringssökande"@sv .


###  https://kela.fi/ontology/kelao#Applicant
:Applicant rdf:type owl:Class ;
        rdfs:subClassOf prov:Agent ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Applicant"@en ,
                "Hakija"@fi ,
                "Sökande"@sv ;
        skos:definition "A natural or legal person who applies for a benefit or service, or to whom the right to apply has been transferred."@en ,
                "Henkilö tai oikeushenkilö, joka hakee etuutta tai palvelua, tai jolle hakuoikeus on siirtynyt."@fi ;
        skos:prefLabel "Applicant"@en ,
                "Hakija"@fi ,
                "Sökande"@sv ;
        rdfs:comment "Henkilö tai organisaatio, joka hakee etuutta"@fi ;
        skos:altLabel "Etuudenhakija"@fi, "Förmånssökande"@sv ;
        rdfs:seeAlso <https://iri.suomi.fi/terminology/kela/c74> ;
        skos:scopeNote "Hakija on prosessirooli. kelao:User on sovelluksen käyttäjä; sama henkilö voi olla molempia."@fi .


###  https://kela.fi/ontology/kelao#Application
:Application rdf:type owl:Class ;
        rdfs:subClassOf prov:Entity ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Ansökan"@sv ,
                "Application"@en ,
                "Hakemus"@fi ;
        rdfs:seeAlso <https://iri.suomi.fi/terminology/kela/c77> ;
        skos:altLabel "Ansökan om förmån"@sv ,
                "Etuushakemus"@fi ,
                "Förmånsansökan"@sv ;
        skos:definition "An applicant's request for a benefit or service. Filing initiates processing of the case."@en ,
                "Asiakirja, jolla etuudenhakija esittää pyynnön tai hänen puolestaan ja hänen suostumuksellaan esitetään pyyntö saada jotain etuutta."@fi ,
                "Hakijan etuutta tai palvelua koskeva hakemus. Hakemuksen vireilletulo käynnistää asian käsittelyn. Etuushakemus on hakemuksen alaluokka."@fi ;
        skos:prefLabel "Ansökan"@sv ,
                "Application"@en ,
                "Hakemus"@fi ;
        skos:scopeNote "Conceptual class only. The KELAO knowledge graph does not contain applicant-level instances — personal data is processed in Kela's operational systems."@en ,
                "Käsitteellinen luokka. KELAO-tietämysgraafi ei sisällä hakijakohtaisia instansseja — henkilötiedot käsitellään Kelan operatiivisissa järjestelmissä."@fi .


###  https://kela.fi/ontology/kelao#Attachment
:Attachment rdf:type owl:Class ;
        rdfs:subClassOf schema:DigitalDocument ;
        rdfs:comment "An application attachment, e.g. a receipt, certificate or form."@en ,
                "Hakemuksen liite, esim. tosite, todistus tai lomake."@fi ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Attachment"@en ,
                "Bilaga"@sv ,
                "Liite"@fi ;
        skos:definition "Hakemukseen liitettävä lisämateriaali, joka täydentää tai todentaa hakemuksen tietoja."@fi ,
                "Supplementary material attached to an application that completes or substantiates the application's information."@en ;
        skos:prefLabel "Attachment"@en ,
                "Bilaga"@sv ,
                "Liite"@fi ;
        skos:scopeNote "Liitettä tarvitaan joskus hakemuksen liitteeksi; pakollisuus on hakemus- tai etuuskohtaista (kuvataan SHACLissa, ei luokkatasolla)."@fi .


###  https://kela.fi/ontology/kelao#Benefit
:Benefit rdf:type owl:Class ;
         rdfs:subClassOf cpsv:PublicService ;
         rdfs:comment "A social security benefit or allowance. General class — use subclasses for instances."@en ,
                "FPA:s förmåner är sociala förmåner. Ibland används också termen socialförsäkringsförmåner."@sv ,
                "Sosiaaliturvan etuus tai tuki. Yleinen luokka — käytä alaluokkia instansseissa. Kelan etuudet ovat sosiaalietuuksia. Joskus käytetään myös termiä sosiaaliturvaetuus."@fi ;
         rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
         rdfs:label "Benefit"@en ,
                "Etuus"@fi ,
                "Förmån"@sv ;
         rdfs:seeAlso <https://iri.suomi.fi/terminology/verotus/c66> ;
         skos:altLabel "Social benefit"@en ,
                "Sosiaalietuus"@fi ,
                "Tuki"@fi ;
         skos:definition "Nyttighet vars ekonomiska värde kan fastställas och som beviljas utgående från mottagarens ställning eller livssituation på grunder som fastställts i förväg."@sv ,
                """Taloudelliselta arvoltaan määriteltävissä oleva hyödyke, joka myönnetään saajan aseman tai elämäntilanteen perusteella ennalta määritellyin perustein.
            Verotus: suoritus, joka maksetaan saajan aseman tai elämäntilanteen perusteella ennalta määritellyin perustein
            """@fi ,
                "A social security benefit or allowance."@en ;
         skos:exactMatch <https://iri.suomi.fi/terminology/kela/c60> ;
         skos:prefLabel "Benefit"@en ,
                "Etuus"@fi ,
                "Förmån"@sv .


###  https://kela.fi/ontology/kelao#BenefitComponent
:BenefitComponent rdf:type owl:Class ;
        rdfs:subClassOf :Benefit ;
        owl:disjointWith :StandaloneBenefit ;
        rdfs:comment "Benefit Component"@en ,
                "Osa suurempaa etuuskokonaisuutta."@fi ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Benefit Component"@en ,
                             "Etuuden osa"@fi ;
        skos:altLabel "etuusosa"@fi , "sub-benefit"@en ;
        skos:definition "An independent and separately processed part of a benefit that can be granted only if the benefit in which the part belongs is also granted."@en ,
                "Etuuden itsenäinen, erikseen käsiteltävä osa, joka voidaan myöntää vain, jos myös etuus, jonka osa on kyseessä, on myönnetty."@fi ;
        skos:example "Esimerkiksi opintotuessa etuuden osia ovat opintoraha, asumislisä ja opintolainan valtiontakaus; lesken- ja lapseneläkkeessä osia ovat perus- ja täydennysmäärät."@fi ,
                "For example, the study grant, housing supplement and government guarantee for student loan are parts of the financial aid for students."@en ;
        skos:prefLabel "Benefit Component"@en ,
                "Etuuden osa"@fi .


###  https://kela.fi/ontology/kelao#BenefitGroup
:BenefitGroup rdf:type owl:Class ;
        skos:definition "Kelan etuuksien ryhmittelyssä käytettävä luokka, joka kokoaa toisiinsa liittyvät etuudet yhteen ryhmään."@fi ,
                "A category used to group related Kela benefits together."@en ;
        rdfs:subClassOf skos:Concept ,
                [ rdf:type owl:Restriction ;
                  owl:onProperty skos:inScheme ;
                  owl:hasValue <http://kela.fi/kg/EtuusryhmaScheme> ] ;
        rdfs:comment "Benefit group"@en ,
                "Kelan etuusryhmitys"@fi ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Benefit Group"@en ,
                "Etuusryhmä"@fi ;
        skos:prefLabel "Benefit Group"@en ,
                "Etuusryhmä"@fi .


###  https://kela.fi/ontology/kelao#Decision
:Decision rdf:type owl:Class ;
          rdfs:subClassOf prov:Entity ;
          rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
          rdfs:label "Beslut"@sv ,
                "Decision"@en ,
                "Päätös"@fi ;
          rdfs:seeAlso <https://iri.suomi.fi/terminology/kela/c78> ;
          skos:altLabel "beslut om förmån"@sv ,
                "etuuspäätös"@fi ,
                "förmånsbeslut"@sv ;
          skos:definition "An authority's resolution on an application; grants or rejects the requested benefit in full or in part."@en ,
                "Viranomaisen ratkaisu hakemukseen; myöntää tai hylkää haetun etuuden kokonaan tai osittain."@fi ;
          skos:prefLabel "Beslut"@sv ,
                "Decision"@en ,
                "Päätös"@fi .


###  https://kela.fi/ontology/kelao#LegalResource
:LegalResource rdf:type owl:Class ;
               rdfs:subClassOf eli:LegalResource ;
               rdfs:comment "A work in a legislative corpus. This applies to acts that have been legally enacted (whether or not they are still in force). A legal resource can represent a legal act or any component of a legal act, like an article. Legal resources can be linked together using properties defined in the model."@en ,
                            "Lainsäädäntöaineistoon kuuluva teos. Tämä koskee lainvoimaisesti säädettyjä lakeja (riippumatta siitä, ovatko ne vielä voimassa). Oikeudellinen resurssi voi edustaa säädöstä tai mitä tahansa säädöksen osaa, kuten artiklaa. Oikeudelliset resurssit voidaan linkittää toisiinsa mallissa määriteltyjen ominaisuuksien avulla."@fi ;
               rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
               rdfs:label "Juridisk resurs"@sv ,
                          "Legal Resource"@en ,
                          "Säädös"@fi ;
               skos:prefLabel "Juridisk resurs"@sv ,
                          "Legal Resource"@en ,
                          "Säädös"@fi ;
               skos:definition "Tekstikokonaisuus, joka sisältää julkisen vallan antamia yleisesti noudatettaviksi tarkoitettuja säännöksiä."@fi ,
                        "Text containing provisions issued by public authorities that are to be observed generally."@en ;
               skos:exactMatch schema:Legislation ;
               skos:example "Examples of statutes are acts and decrees as well as legal provisions issued by authorities."@en ,
                        "Säädöksiä ovat esimerkiksi lait ja asetukset sekä viranomaisten antamat oikeussäännöt."@fi .


###  https://kela.fi/ontology/kelao#LegalResourcePart
:LegalResourcePart rdf:type owl:Class ;
        rdfs:subClassOf eli:LegalResource ;
        rdfs:comment """Lain tai asetuksen osa (luku, pykälä, momentti, kohta yms.).
          Tämä luokka on tarkoitettu erottamaan kokonaiset lait niiden osista. EU-asetuksissa ym. on myös muu jaottelu kuin Suomessa."""@fi ,
                "Legal Resource Part"@en ,
                "Osa laista riippumatta siitä, onko kyseessä luku, pykälä vai momentti."@fi ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Lagdel"@sv ,
                "Lain osa"@fi ,
                "Legal Resource Part"@en ;
        skos:definition "Lain tai asetuksen osa riippumatta siitä, onko kyseessä luku, pykälä vai momentti"@fi ;
        skos:example "Kansaneläkelain 23 §"@fi ;
        skos:prefLabel "Lagdel"@sv ,
                "Lain osa"@fi ,
                "Legal Resource Part"@en .


###  https://kela.fi/ontology/kelao#LifeSituation
:LifeSituation rdf:type owl:Class ;
                rdfs:subClassOf skos:Concept ,
                [ rdf:type owl:Restriction ;
                  owl:onProperty skos:inScheme ;
                  owl:hasValue <http://kela.fi/kg/ElamantilanneluokitusScheme> ] ;
                rdfs:comment """Elämäntilanne on kansalaisen elämän muutosvaihe tai tilanne, johon liittyy julkisten palvelujen ja etuuksien tarve. Yksittäiset elämäntilanteet muodostavat elämäntilanneluokituksen (skos:ConceptScheme). Luokitus on luonnos; pohjana on käytetty
        DVV:n elämäntapahtumaluokitusta, joka perustuu EU-luokitukseen."""@fi ,
        "A life situation is a phase of change or circumstance in a citizen's life associated with a need for public services and benefits. Individual life situations form the life-situation classification (a skos:ConceptScheme)."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Elämäntilanne"@fi ,
                "Livssituation"@sv ,
                "Life Situation"@en ;
        skos:definition "Elämäntilanteilla tarkoitetaan sellaisia muutosvaiheita, joita kuvaa väliaikaisuus, erityisten palvelujen ja tiedon tarve sekä niihin kohdennetut palvelut."@fi ,
                "Life situations refer to phases of change characterized by temporary nature, the need for special services and information, and services targeted to them."@en ;
        skos:prefLabel "Elämäntilanne"@fi ,
                "Livssituation"@sv ,
                "Life Situation"@en .


###  https://kela.fi/ontology/kelao#Organisation
:Organisation rdf:type owl:Class ;
        skos:definition "Toimija, joka on henkilöiden muodostama yhteenliittymä ja jolla on yhteinen tavoite ja tarkoituksenmukainen rakenne."@fi ,
                "An actor that is an association of individuals with a common goal and a purposeful structure."@en ;
        rdfs:subClassOf org:Organization ;
        rdfs:comment "An actor that is an association of individuals with a common goal and a purposeful structure"@en ,
                "Toimija, joka on henkilöiden muodostama yhteenliittymä ja jolla on yhteinen tavoite ja tarkoituksenmukainen rakenne"@fi ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Organisaatio"@fi ,
                "Organisation"@sv ,
                "Organization"@en ;
        skos:broadMatch m8g:PublicOrganisation ;
        skos:closeMatch foaf:Organization ;
        skos:exactMatch ptv:Organization , schema:Organization ;
        skos:prefLabel "Organisaatio"@fi ,
                "Organisation"@sv ,
                "Organization"@en ;
        skos:scopeNote """KELAO-kontekstissa vastaa PTV:n Organization-käsitettä ja 
        schema.org/Organization-käsitettä. Käytetään kuvaamaan kaikkia 
         toimijaorganisaatioita sektorirajat ylittäen (julkinen, yksityinen, 
         kolmas sektori). EU Core Public Organisation on tämän erikoistapaus."""@fi .


###  https://kela.fi/ontology/kelao#Service
:Service rdf:type owl:Class ;
         rdfs:subClassOf cpsv:PublicService ;
         rdfs:comment "A social-security-related service, e.g. an application or advisory service."@en ,
                      "Sosiaaliturvaan liittyvä palvelu, esim. hakemus- tai neuvontapalvelu."@fi ;
         rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
         rdfs:label "Palvelu"@fi ,
                "Service"@en ,
                "Tjänst"@sv ;
         skos:definition "An activity by which a service provider responds to a customer's need."@en ,
                "Toiminto, jolla palveluntoteuttaja vastaa asiakkaan tarpeeseen."@fi ;
         skos:exactMatch ptv:Service ;
         skos:prefLabel "Palvelu"@fi ,
                "Service"@en ,
                "Tjänst"@sv ;
         skos:scopeNote "Ydinmallissa palvelu liitetään etuuteen (kelao:relatedService) ja se on käytettävissä palvelukanavien kautta (kelao:hasServiceChannel). Palvelukanava (kelao:ServiceChannel) ja palvelupiste (kelao:ServiceUnit) kuuluvat ydinmalliin; laajempi PTV-metatieto (esim. rahoitustyyppi, palveluluokitus, kohderyhmät) jää edelleen ydinmallin ulkopuolelle."@fi ,
                "In the core model a service is linked to a benefit (kelao:relatedService) and is accessible through service channels (kelao:hasServiceChannel). Service channels (kelao:ServiceChannel) and service units (kelao:ServiceUnit) are part of the core model; broader PTV metadata (e.g. funding type, service classification, target groups) remains outside it."@en .


###  https://kela.fi/ontology/kelao#StandaloneBenefit
:StandaloneBenefit rdf:type owl:Class ;
        skos:definition "Kokonainen, itsenäinen etuus, joka voidaan myöntää sellaisenaan ja joka voi koostua osaetuuksista (etuuden osista)."@fi ,
                "A complete, self-standing benefit that can be granted on its own and may consist of benefit components."@en ;
                   rdfs:subClassOf :Benefit ;
                   rdfs:comment "Kokonainen, itsenäinen etuus."@fi ;
                   rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                   rdfs:label "Itsenäinen etuus"@fi ,
                              "Standalone Benefit"@en ;
                   skos:prefLabel "Itsenäinen etuus"@fi ,
                            "Standalone Benefit"@en .


###  https://kela.fi/ontology/kelao#StatuteType
:StatuteType rdf:type owl:Class ;
        skos:definition "Säädöksen tyyppi sen antajan ja oikeudellisen aseman mukaan, esimerkiksi laki, asetus tai EU-asetus. Tyypit määritellään erillisessä SKOS-luokituksessa."@fi ,
                "The type of a statute according to its issuer and legal status, e.g. an act, a decree or an EU regulation. The types are defined in a separate SKOS classification."@en ;
             rdfs:subClassOf skos:Concept ,
                [ rdf:type owl:Restriction ;
                  owl:onProperty skos:inScheme ;
                  owl:hasValue <http://kela.fi/kg/saadostyyppi-luokitus> ] ;
             rdfs:comment "Statute type classification (draft). The Skos-classification has 13 classes for example EU regulation, Decree, Agreement, Government decree, and Presidential decree."@en ,
                          "Säädöksen tyyppi määritellään skos-luokituksessa StatuteType. Luokitus on luonnos. Sisältää Kelaan soveltuvan sekä suomalaisen että eu-lainsäädännön"@fi ;
             rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
             rdfs:label "Författningstyp"@sv ,
                        "Statute Type"@en ,
                        "Säädöstyyppi"@fi ;
             skos:prefLabel "Författningstyp"@sv ,
                    "Statute Type"@en ,
                    "Säädöstyyppi"@fi .


###  https://kela.fi/ontology/kelao#User
:User rdf:type owl:Class ;
      rdfs:subClassOf prov:Agent ;
      rdfs:comment "Application user, user."@en ,
                   "Sovelluksen käyttäjä, esim. verkkosovelluksen käyttäjä."@fi ;
      rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
      rdfs:label "Användare"@sv ,
                 "Käyttäjä"@fi ,
                 "User"@en ;
      skos:definition "A human actor or agent, user or application user"@en ,
                "Sovelluksen käyttäjä, agentti tms."@fi ;
      skos:prefLabel "Användare"@sv ,
                "Käyttäjä"@fi ,
                "User"@en .


###  https://kela.fi/ontology/kelao#Country
:Country rdf:type owl:Class ;
        skos:definition "Valtio. Käytetään esimerkiksi asumisedellytyksen ja rajat ylittävien tilanteiden kuvaamiseen."@fi ,
                "A country or state, used e.g. to express residence requirements and cross-border situations."@en ;
         rdfs:subClassOf :Location ;
         rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
         rdfs:comment "A country / state. Used e.g. to express residence requirements and cross-border situations."@en ,
                "Valtio. Käytetään esim. asumisedellytyksen ja kansainvälisten tilanteiden kuvaamiseen."@fi ;
         rdfs:label "Country"@en ,
                "Valtio"@fi ,
                "Stat"@sv ;
         skos:exactMatch schema:Country ;
         skos:prefLabel "Country"@en ,
                "Valtio"@fi ,
                "Stat"@sv ;
         skos:scopeNote "Lähdeontologiassa kuvattu suoraan schema:Country-luokkana; ydinmallissa määritelty omana luokkana ja linkitetty skos:exactMatch-suhteella."@fi .


###  https://kela.fi/ontology/kelao#DataProduct
:DataProduct rdf:type owl:Class ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:comment "A managed and governed collection of data with a purpose, value, ownership and life-cycle that meets consumer needs, e.g. a report or other benefit-related data product."@en ,
                "Hallittu ja omistettu tietokokonaisuus, jolla on tarkoitus, arvo ja elinkaari ja joka vastaa tiedon hyödyntäjän tarpeisiin. Esimerkiksi raportti tai muu etuuteen liittyvä tietotuote."@fi ;
        rdfs:label "Data Product"@en ,
                "Informationsprodukt"@sv ,
                "Tietotuote"@fi ;
        skos:definition "A data product is a product that facilitates an end goal through the use of data."@en ,
                "Tietotuote on tuote, joka helpottaa lopputavoitteen saavuttamista datan avulla."@fi ;
        skos:prefLabel "Data Product"@en ,
                "Informationsprodukt"@sv ,
                "Tietotuote"@fi ;
        skos:scopeNote "Itsenäinen luokka. Mahdollinen linkitys ulkoiseen data product -sanastoon (esim. DPROD) jätetty myöhempään harmonisointiin."@fi .


###  https://kela.fi/ontology/kelao#Location
:Location rdf:type owl:Class ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:comment "A geographic area used e.g. to describe a place of residence, a service operating area, or the location of a service unit. Superclass for municipalities, wellbeing service counties, regions and countries."@en ,
                "Maantieteellinen alue, jota voidaan käyttää esim. asuinpaikan, palvelun toiminta-alueen tai palvelupisteen sijainnin kuvaamiseen. Yliluokka kunnille, hyvinvointialueille, maakunnille ja valtioille."@fi ;
        rdfs:label "Location"@en ,
                "Plats"@sv ,
                "Sijainti"@fi ;
        skos:altLabel "Geographic Area"@en , "Place"@en ,
                 "Maantieteellinen alue"@fi ;
        skos:closeMatch locn:Location ;
        skos:definition "Any geographic area, irrespective of size or administrative level."@en ,
                "Mikä tahansa maantieteellinen alue koosta tai hallinnollisesta tasosta riippumatta."@fi ;
        skos:prefLabel "Location"@en ,
                "Plats"@sv ,
                "Sijainti"@fi ;
        skos:scopeNote "Ydinmallissa nimi on harmonisoitu Location-muotoon ja linkitetty W3C Location Core -sanastoon (locn:Location)."@fi .


###  https://kela.fi/ontology/kelao#Municipality
:Municipality rdf:type owl:Class ;
        skos:definition "Suomen kunta. Kunnat tunnistetaan Suomi.fi-koodiston URI-tunnisteilla."@fi ,
                "A Finnish municipality. Municipalities are identified using Suomi.fi code list URIs."@en ;
        rdfs:subClassOf :Location ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        #rdfs:comment "A Finnish municipality. Municipalities are identified using Suomi.fi code list URIs."@en ,
        #       "Suomen kunta. Kunnat tunnistetaan Suomi.fi-koodiston URI-tunnisteilla."@fi ;
        rdfs:label "Municipality"@en ,
                "Kommun"@sv ,
                "Kunta"@fi ;
        skos:prefLabel "Municipality"@en ,
                "Kommun"@sv ,
                "Kunta"@fi ;
        skos:scopeNote "Suomen kunnat, Suomi.fi URI:t."@fi .


###  https://kela.fi/ontology/kelao#Region
:Region rdf:type owl:Class ;
        skos:definition "Maakunta. Kuntien muodostama alueellisen kehittämisen ja suunnittelun yksikkö."@fi ,
                "A region (maakunta): an areal unit of regional development and planning composed of municipalities."@en ;
        rdfs:subClassOf :Location ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:comment "A region (maakunta): an areal unit of regional development and planning composed of municipalities."@en ,
                "Maakunta. Kuntien muodostama alueellisen kehittämisen ja suunnittelun yksikkö."@fi ;
        rdfs:label "Maakunta"@fi ,
                "Region"@en ,
                "Landskap"@sv ;
        skos:prefLabel "Maakunta"@fi ,
                "Region"@en ,
                "Landskap"@sv .


###  https://kela.fi/ontology/kelao#ServiceChannel
:ServiceChannel rdf:type owl:Class ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:comment "A service channel: the way a customer accesses a service, e.g. e-service, web page, printable form, telephone service or a physical service point. A single service may have several alternative or sequential channels."@en ,
                "Palvelu- tai asiointikanava: tapa, jolla asiakas saa palvelun käyttöönsä. Kanava voi olla esimerkiksi verkkoasiointi, verkkosivu, tulostettava lomake, puhelinasiointi tai fyysinen palvelupaikka. Yhdellä palvelulla voi olla useita vaihtoehtoisia tai peräkkäisiä kanavia."@fi ;
        rdfs:label "Palvelukanava"@fi ,
                "Service Channel"@en ,
                "Servicekanal"@sv ;
        skos:closeMatch ptv:ServiceChannel ;
        skos:definition "Tapa, jolla asiakas saa palvelun käyttöönsä."@fi ,
                "The way in which a customer accesses a service."@en ;
        skos:prefLabel "Palvelukanava"@fi ,
                "Service Channel"@en ,
                "Servicekanal"@sv ;
        skos:scopeNote "Linkitetty PTV:n ServiceChannel-käsitteeseen vain skos:closeMatch-suhteella, koska ptv: on epävakaa nimiavaruus."@fi .


###  https://kela.fi/ontology/kelao#ServiceUnit
:ServiceUnit rdf:type owl:Class ;
             rdfs:subClassOf :ServiceChannel ;
             rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
             rdfs:comment "A service unit (service point) with a physical location. Service unit data has been combined from Kela's internal sources and PTV service-channel data (entity matching)."@en ,
                """Palvelupisteet voivat olla sekä yksityisten että julkishallinnon toimijoiden ylläpitämiä. Vrt. asiointipiste.
Joissain palvelupisteissä on asiakastietokoneita, joilla asiakkaat voivat asioida myös itsenäisesti.
Kelan palvelupisteissä tarjotaan Kelan palveluja, ja niissä työskentelee Kelan palveluasiantuntijoita. Kelan palvelupiste voi sijaita myös muualla kuin Kelan omissa tiloissa.
Palvelupiste, jolla on fyysinen sijainti. Palvelupisteiden tiedot on yhdistetty Kelan sisäisestä lähteestä ja PTV:n palvelukanavatiedoista (entity matching)."""@fi ;
             rdfs:label "Palvelupiste"@fi ,
                        "Service Unit"@en ,
                        "Serviceställe"@sv ;
             skos:altLabel "Palveluyksikkö"@fi ;
             skos:closeMatch ptv:ServiceChannel ;
             skos:definition "A physically located service point at which a service is provided."@en ,
                        "Toimipiste, jota ylläpitää pääsääntöisesti yksi toimija ja jossa voi saada kyseisen toimijan tai muiden toimijoiden tarjoamia palveluja."@fi ;
             skos:prefLabel "Palvelupiste"@fi ,
                        "Service Unit"@en ,
                        "Serviceställe"@sv ;
             skos:scopeNote "Palvelupiste on palvelukanavan erikoistapaus, siksi rdfs:subClassOf kelao:ServiceChannel."@fi .


###  https://kela.fi/ontology/kelao#WellbeingServiceCounty
:WellbeingServiceCounty rdf:type owl:Class ;
        skos:definition "Hyvinvointialue. Suomen sosiaali- ja terveydenhuollon sekä pelastustoimen järjestämisestä vastaava itsehallinnollinen alue."@fi ,
                "A wellbeing services county: a self-governing area responsible for organising health, social and rescue services in Finland."@en ;
        rdfs:subClassOf :Location ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        #rdfs:comment "A wellbeing services county: a self-governing area responsible for organising health, social and rescue services in Finland."@en ,
        #       "Hyvinvointialue. Suomen sosiaali- ja terveydenhuollon sekä pelastustoimen järjestämisestä vastaava itsehallinnollinen alue."@fi ;
        rdfs:label "Hyvinvointialue"@fi ,
                "Wellbeing Service County"@en ,
                "Välfärdsområde"@sv ;
        skos:prefLabel "Hyvinvointialue"@fi ,
                "Wellbeing Service County"@en ,
                "Välfärdsområde"@sv .


#################################################################
#    Annotations
#################################################################

:alternative rdfs:comment "An established acronym or alternative name for the legal resource."@en ,
                          "Säädöksen vakiintunut lyhenne tai vaihtoehtoinen nimi."@fi ;
             rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
             rdfs:label "lain lyhenne"@fi ,
                        "law acronym"@en ;
             skos:exactMatch dct:alternative ;
             skos:prefLabel "lain lyhenne"@fi ,
                        "law acronym"@en ;
             skos:scopeNote "Käytetään kelao:LegalResource-instansseilla. Kuvaa säädöksen vakiintuneen lyhenteen, esim. 'KEL' tai 'SHL'."@fi .

#################################################################
# KELAO-lisäys: Asiakas (Customer) ja roolisuhteet
# Malli: hakija, käyttäjä ja saaja ovat asiakkaan rooleja.
# Sama asiakas voi esiintyä useassa roolissa eri yhteyksissä.
#################################################################

:Customer rdf:type owl:Class ;
        skos:definition "Henkilö tai yhteisö, joka saa tai jolla on mahdollisuus saada arvoa Kelan tarjoamasta palvelusta."@fi ,
                "A person or community that receives, or has the possibility to receive, value from a service provided by Kela."@en ;
        skos:scopeNote """Asiakkaat voivat olla ulkoisia tai sisäisiä. Asiakkaat voivat olla henkilöasiakkaita tai yhteisöasiakkaita. 
                Kelan asiakas saa joko suoraan tai välillisesti Kelan tarjoamaa palvelua, kuten esimerkiksi Kelan etuutta tai Kelan tuottamaa tietopalvelua. Yleiskielessä asiakkaalla tarkoitetaan toimijaa, joka hankkii tai saa palveluja tai hankkii tuotteita. 
                Tällainen toimija voi olla henkilö, henkilöryhmä tai organisaatio. Eepoksessa käytetään termiä "customer" puhuttaessa Kelan henkilöasiakkaista.
                """@fi ;
        rdfs:subClassOf prov:Agent ;
        rdfs:comment "Asiakas: henkilö tai taho, jolla on asiakkuus sosiaaliturvan toimeenpanijaan. Asiakas on pysyvä identiteetti, johon tilannekohtaiset roolit (hakija, käyttäjä, etuuden saaja) kiinnittyvät roolisuhteen kautta."@fi ,
                "Customer: a person or party having a customer relationship with the social security administrator. The customer is the persistent identity to which contextual roles (applicant, user, beneficiary) are attached via the role-of-customer relation."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Asiakas"@fi ,
                "Customer"@en ,
                "Kund"@sv ;
        skos:prefLabel "Asiakas"@fi ,
                "Customer"@en ,
                "Kund"@sv .

:roleOfCustomer rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
        rdfs:domain [ rdf:type owl:Class ;
                      owl:unionOf ( :Applicant :User :Beneficiary )
                    ] ;
        rdfs:range :Customer ;
        owl:inverseOf :hasCustomerRole ;
        rdfs:comment "Rooli (hakija, käyttäjä tai etuuden saaja) kuuluu tälle asiakkaalle. Funktionaalinen: yksi rooli-instanssi kiinnittyy täsmälleen yhteen asiakkaaseen."@fi ,
                     "The role (applicant, user or beneficiary) belongs to this customer. Functional: one role instance is attached to exactly one customer."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "asiakkaan roolina"@fi ,
                   "role of customer"@en ;
        skos:prefLabel "asiakkaan roolina"@fi ,
                "role of customer"@en .

:hasCustomerRole rdf:type owl:ObjectProperty ;
        rdfs:domain :Customer ;
        rdfs:range [ rdf:type owl:Class ;
                     owl:unionOf ( :Applicant :User :Beneficiary )
                   ] ;
        owl:inverseOf :roleOfCustomer ;
        rdfs:comment "Asiakkaalla on tämä rooli (hakija, käyttäjä tai etuuden saaja). Sama asiakas voi olla useassa roolissa samanaikaisesti tai eri yhteyksissä."@fi ,
                     "The customer has this role (applicant, user or beneficiary). The same customer may hold several roles simultaneously or in different contexts."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "asiakkaan rooli"@fi ,
                "has customer role"@en ;
        skos:prefLabel "asiakkaan rooli"@fi ,
                "has customer role"@en .

#################################################################
# KELAO-lisäykset: aluehierarkia + sosiaaliturvan ydinkäsitteet
# Lisättäväksi versioon 0.3.x -> 0.4.0 (luonnos)
#################################################################

#################################################################
# OSA 1: ALUEHIERARKIA
# Malli: yksi geneerinen transitiivinen osa-alue-ominaisuus
# (isPartOfArea), jonka aliominaisuuksia hallinnolliset
# kuulumissuhteet ovat. Transitiivinen sulkeuma muodostuu
# geneerisellä tasolla; aliominaisuudet pysyvät yksiaskelisina.
#################################################################

:isPartOfArea rdf:type owl:ObjectProperty ,
                       owl:TransitiveProperty ;
        rdfs:domain :Location ;
        rdfs:range :Location ;
        owl:inverseOf :containsArea ;
        rdfs:comment "Alue on osa toista maantieteellistä aluetta. Transitiivinen yleisominaisuus, jonka aliominaisuuksia hallinnolliset kuulumissuhteet (kunta-hyvinvointialue, kunta-maakunta, alue-valtio) ovat."@fi ,
                "A geographic area is part of another geographic area. Transitive generic property; specific administrative containment relations are its subproperties."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "on osa aluetta"@fi ,
                "is part of area"@en ;
        skos:prefLabel "on osa aluetta"@fi ,
                "is part of area"@en ;
        skos:closeMatch schema:containedInPlace ,
                <http://www.geonames.org/ontology#parentFeature> .

:containsArea rdf:type owl:ObjectProperty ,
                       owl:TransitiveProperty ;
        rdfs:domain :Location ;
        rdfs:range :Location ;
        owl:inverseOf :isPartOfArea ;
        rdfs:comment "Alue sisältää toisen maantieteellisen alueen. Käänteisominaisuus ominaisuudelle 'on osa aluetta'."@fi ,
                "A geographic area contains another geographic area. Inverse of 'is part of area'."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "sisältää alueen"@fi ,
                   "contains area"@en ;
        skos:prefLabel "sisältää alueen"@fi ,
                "contains area"@en ;
        skos:closeMatch schema:containsPlace .

:belongsToRegion rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :isPartOfArea ;
        rdfs:domain :Municipality ;
        rdfs:range :Region ;
        rdfs:comment "Kunta kuuluu tähän maakuntaan. Rinnakkainen hierarkia hyvinvointialueeseen kuulumisen kanssa: kunta kuuluu sekä maakuntaan että hyvinvointialueeseen."@fi ,
                "The municipality belongs to this region (maakunta). Parallel to wellbeing service county membership; the two hierarchies are independent."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "kuuluu maakuntaan"@fi ,
                   "belongs to region"@en ;
        skos:prefLabel "kuuluu maakuntaan"@fi ,
                "belongs to region"@en .

:belongsToCountry rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :isPartOfArea ;
        rdfs:domain :Location ;
        rdfs:range :Country ;
        rdfs:comment "Alue kuuluu tähän valtioon. Käytetään maakunnille, hyvinvointialueille, työllisyysalueille ja tarvittaessa suoraan kunnille."@fi ,
                "The area belongs to this country. Used for regions, wellbeing service counties, employment areas and, where needed, directly for municipalities."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "kuuluu valtioon"@fi ,
                   "belongs to country"@en ;
        skos:prefLabel "kuuluu valtioon"@fi ,
                "belongs to country"@en .

:EmploymentArea rdf:type owl:Class ;
        skos:definition "Kuntien muodostama, julkisten työvoimapalveluiden järjestämisestä vastaava lakisääteinen alue (TE-palvelut 2025 -uudistus)."@fi ,
                "A statutory area formed by municipalities responsible for organising public employment services (Finnish TE services reform 2025)."@en ;
        rdfs:subClassOf :Location ;
        rdfs:comment "Työllisyysalue: kuntien muodostama työvoimapalveluiden järjestämisvastuualue (TE-palvelut 2025 -uudistus)."@fi ,
                "Employment area: a statutory area formed by municipalities responsible for organising public employment services (Finnish TE services reform 2025)."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Työllisyysalue"@fi ,
                "Employment area"@en ,
                "Sysselsättningsområde"@sv ;
        skos:prefLabel "Työllisyysalue"@fi ,
                "Employment area"@en ,
                "Sysselsättningsområde"@sv .

:belongsToEmploymentArea rdf:type owl:ObjectProperty ;
        rdfs:subPropertyOf :isPartOfArea ;
        rdfs:domain :Municipality ;
        rdfs:range :EmploymentArea ;
        rdfs:comment "Kunta kuuluu tähän työllisyysalueeseen. Ei pakollinen: esim. Ahvenanmaan kunnilla ei ole työllisyysaluetta."@fi ,
                "The municipality belongs to this employment area. Optional: e.g. municipalities in Åland have no employment area."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "kuuluu työllisyysalueeseen"@fi ,
                   "belongs to employment area"@en ;
        skos:prefLabel "kuuluu työllisyysalueeseen"@fi ,
                "belongs to employment area"@en .

### Olemassa olevan ominaisuuden kytkentä hierarkiaan.
### Pelkkä lisäaksiooma - ei korvaa nykyisiä väitteitä.
:belongsToWellbeingServiceCounty rdfs:subPropertyOf :isPartOfArea .

### Ominaisuusketju: palvelupisteen sijainti periytyy aluehierarkiassa ylöspäin.
### hasLocation o isPartOfArea -> hasLocation
### Esim. sijaitsee Rovaniemellä => sijaitsee Lapissa => sijaitsee Suomessa.
### HUOM: vaatii OWL2-RL-rulesetin GraphDB:ssä (prp-spo2).
:hasLocation owl:propertyChainAxiom ( :hasLocation :isPartOfArea ) .

### Domainin laajennus: sijainti koskee sekä organisaatiota että palvelupistettä.
:hasLocation rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Organisation :ServiceUnit )
                         ] .

#################################################################
# OSA 2: SOSIAALITURVAN YDINKÄSITTEET
#################################################################

### Kelpoisuuskriteeri #########################################

:EligibilityCriterion rdf:type owl:Class ;
        skos:definition "Yksittäinen ehto, jonka täyttyminen vaikuttaa oikeuteen saada etuus, esimerkiksi ikäraja, asumisedellytys, tuloraja tai työssäoloehto."@fi ,
                "An individual condition affecting entitlement to a benefit, e.g. an age limit, residence requirement, income limit or employment condition."@en ;
        rdfs:subClassOf prov:Entity ;
        rdfs:comment "Etuuskriteeri: yksittäinen ehto, jonka täyttyminen vaikuttaa oikeuteen saada etuus (esim. ikäraja, asumisedellytys, tuloraja, työssäoloehto). Reifioituna luokkana kriteeri voi kantaa oman lakiperustansa ja parametrinsa."@fi ,
                "Eligibility criterion: an individual condition affecting entitlement to a benefit (e.g. age limit, residence requirement, income limit, employment condition). Reified so that each criterion can carry its own legal basis and parameters."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Etuuskriteeri"@fi ,
                "Eligibility criterion"@en ;
        skos:prefLabel "Etuuskriteeri"@fi ,
                "Eligibility criterion"@en ;
        skos:closeMatch m8g:Criterion .

:hasEligibilityCriterion rdf:type owl:ObjectProperty ;
        rdfs:domain :Benefit ;
        rdfs:range :EligibilityCriterion ;
        owl:inverseOf :isCriterionFor ;
        rdfs:comment "Etuudella on tämä kelpoisuuskriteeri."@fi ,
                     "The benefit has this eligibility criterion."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "kriteerinä"@fi ,
                   "has eligibility criterion"@en ;
        skos:prefLabel "kriteerinä"@fi ,
                       "has eligibility criterion"@en .

:isCriterionFor rdf:type owl:ObjectProperty ;
        rdfs:domain :EligibilityCriterion ;
        rdfs:range :Benefit ;
        owl:inverseOf :hasEligibilityCriterion ;
        rdfs:comment "Kriteeri koskee tätä etuutta."@fi ,
                "The criterion applies to this benefit."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "on kriteeri etuudelle"@fi ,
                "is criterion for"@en ;
        skos:prefLabel "on kriteeri etuudelle"@fi ,
                "is criterion for"@en .

:criterionLegalBasis rdf:type owl:ObjectProperty ;
        rdfs:domain :EligibilityCriterion ;
        rdfs:range :LegalResource ;
        rdfs:comment "Kriteerin oikeusperusta: viittaus säädökseen tai sen osaan (ELI-URI, pykälätaso)."@fi ,
                "Legal basis of the criterion: reference to a legal resource or its subdivision (ELI URI, section level)."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "kriteerin oikeusperusta"@fi ,
                "criterion legal basis"@en ;
        skos:prefLabel "kriteerin oikeusperusta"@fi ,
                "criterion legal basis"@en .


### Tulo #######################################################

:Income rdf:type owl:Class ;
        skos:definition "Henkilön tai saajayksikön tuloerä, esimerkiksi palkka, yrittäjätulo, pääomatulo tai etuustulo, joka voidaan ottaa huomioon etuuden tulovähenteisyydessä tai tarveharkinnassa."@fi ,
                "An income item of a person or recipient unit — e.g. wage, self-employment income, capital income or benefit income — that may be taken into account in a benefit's income or means testing."@en ;
        rdfs:subClassOf prov:Entity ;
        rdfs:comment "Tulo: henkilön tai saajayksikön tuloerä (esim. palkka, yrittäjätulo, pääomatulo, etuustulo), joka voidaan ottaa huomioon etuuden tulovähenteisyydessä tai tarveharkinnassa."@fi ,
                "Income: an income item of a person or recipient unit (e.g. wage, self-employment income, capital income, benefit income) that may be taken into account in means testing."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Tulo"@fi ,
                "Income"@en ,
                "Inkomst"@sv ;
        skos:prefLabel "Tulo"@fi ,
                "Income"@en ,
                "Inkomst"@sv .

:hasIncome rdf:type owl:ObjectProperty ;
        rdfs:domain prov:Agent ;
        rdfs:range :Income ;
        rdfs:comment "Henkilöllä on tämä tuloerä."@fi ,
                "The agent has this income item."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "tulona"@fi ,
                "has income"@en ;
        skos:prefLabel "tulona"@fi ,
                "has income"@en .

:incomeConsideredIn rdf:type owl:ObjectProperty ;
        rdfs:domain :Income ;
        rdfs:range :Benefit ;
        rdfs:comment "Tuloerä otetaan huomioon tämän etuuden tulovähenteisyydessä tai tarveharkinnassa."@fi ,
                     "The income item is taken into account in the means testing of this benefit."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "huomioidaan etuudessa"@fi ,
                   "income considered in"@en ;
        skos:prefLabel "huomioidaan etuudessa"@fi ,
                       "income considered in"@en .


### Etuuden saaja ##############################################

:Beneficiary rdf:type owl:Class ;
        skos:definition "Toimija, joka saa etuutta. Saaja erotetaan hakijasta ja maksun saajasta, jotka voivat olla eri tahoja."@fi ,
                "An agent who receives a benefit. The beneficiary is distinguished from the applicant and from the payment recipient, which may be different parties."@en ;
        rdfs:subClassOf prov:Agent ;
        rdfs:comment "Etuuden saaja. Erotetaan hakijasta: esim. lapsilisän hakija on huoltaja, ja maksun saaja voi olla eri henkilö tai taho (esim. kunta tai vuokranantaja)."@fi ,
                      "Beneficiary: recipient of a benefit. Distinguished from the applicant: e.g. child benefit is applied for by a guardian, and the payment recipient may be a different party."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Etuuden saaja"@fi ,
                   "Beneficiary"@en ,
                   "Förmånstagare"@sv ;
        skos:prefLabel "Etuuden saaja"@fi ,
                "Beneficiary"@en ,
                "Förmånstagare"@sv .

:receivesBenefit rdf:type owl:ObjectProperty ;
        rdfs:domain :Beneficiary ;
        rdfs:range :Benefit ;
        rdfs:comment "Saaja saa tätä etuutta."@fi ,
                "The beneficiary receives this benefit."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "saa etuutta"@fi ,
                "receives benefit"@en ;
        skos:prefLabel "saa etuutta"@fi ,
                "receives benefit"@en .

### Maksu ######################################################

:Payment rdf:type owl:Class ;
        skos:definition "Ratkaisun perusteella maksettu etuussuoritus tai sen maksuerä, joka kytkee ratkaisun, etuuden ja saajan rahavirtaan."@fi ,
                "A benefit disbursement, or an instalment of one, made on the basis of a decision, linking the decision, benefit and recipient to the money flow."@en ;
        rdfs:subClassOf prov:Entity ;
        rdfs:comment "Maksu tai maksuerä: ratkaisun perusteella maksettu etuussuoritus. Kytkee ratkaisun, etuuden ja saajan rahavirtaan."@fi ,
                "Payment or instalment: a benefit disbursement made on the basis of a decision. Links the decision, benefit and recipient to the money flow."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Maksu"@fi ,
                "Payment"@en ,
                "Betalning"@sv ;
        skos:prefLabel "Maksu"@fi ,
                "Payment"@en ,
                "Betalning"@sv .

:paymentOf rdf:type owl:ObjectProperty ;
        rdfs:domain :Payment ;
        rdfs:range :Benefit ;
        rdfs:comment "Maksu on tämän etuuden suoritus."@fi ,
                     "The payment is a disbursement of this benefit."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "etuuden maksu"@fi ,
                   "payment of"@en ;
        skos:prefLabel "etuuden maksu"@fi ,
                       "payment of"@en .

:paymentBasedOnDecision rdf:type owl:ObjectProperty ;
        rdfs:domain :Payment ;
        rdfs:range :Decision ;
        rdfs:comment "Maksu perustuu tähän ratkaisuun."@fi ,
                     "The payment is based on this decision."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "perustuu ratkaisuun"@fi ,
                   "payment based on decision"@en ;
        skos:prefLabel "perustuu ratkaisuun"@fi ,
                       "payment based on decision"@en .

:paymentRecipient rdf:type owl:ObjectProperty ;
        rdfs:domain :Payment ;
        rdfs:range prov:Agent ;
        rdfs:comment "Maksun saaja. Voi olla muu kuin hakija (esim. vuokranantaja tai kunta)."@fi ,
                "Recipient of the payment. May differ from the applicant (e.g. landlord or municipality)."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "maksun saajana"@fi ,
                   "payment recipient"@en ;
        skos:prefLabel "maksun saajana"@fi ,
                       "payment recipient"@en .

### Takaisinperintä ############################################

:Recovery rdf:type owl:Class ;
        skos:definition "Liikaa tai perusteetta maksetun etuuden periminen takaisin saajalta."@fi ,
                "The reclaiming from the recipient of a benefit that was paid in excess or without grounds."@en ;
        rdfs:subClassOf prov:Entity ;
        rdfs:comment "Takaisinperintä: liikaa tai perusteetta maksetun etuuden perintä takaisin saajalta."@fi ,
                      "Recovery: reclaiming a benefit paid in excess or without grounds from the recipient."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Takaisinperintä"@fi ,
                   "Recovery"@en ,
                   "Återkrav"@sv ;
        skos:altLabel "Claim for recovery"@en ;
        skos:prefLabel "Takaisinperintä"@fi ,
                "Recovery"@en ,
                "Återkrav"@sv .

:recoveryConcerns rdf:type owl:ObjectProperty ;
        rdfs:domain :Recovery ;
        rdfs:range :Payment ;
        rdfs:comment "Takaisinperintä kohdistuu tähän maksuun."@fi ,
                "The recovery concerns this payment."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "kohdistuu maksuun"@fi ,
                   "recovery concerns"@en ;
        skos:prefLabel "kohdistuu maksuun"@fi ,
                       "recovery concerns"@en .


### Muutoksenhakuelin ##########################################

:AppealBody rdf:type owl:Class ;
        skos:definition "Valitus- ja oikaisuvaatimusasioita käsittelevä toimielin, esimerkiksi sosiaaliturva-asioiden muutoksenhakulautakunta tai vakuutusoikeus."@fi ,
                "A body that handles appeals and requests for rectification, e.g. the Social Security Appeal Board or the Insurance Court."@en ;
        rdfs:subClassOf :Organisation ;
        rdfs:comment "Muutoksenhakuelin: valitusasioita käsittelevä toimielin, esim. sosiaaliturva-asioiden muutoksenhakulautakunta (SAMU) tai vakuutusoikeus."@fi ,
                "Appeal body: an organisation handling appeals, e.g. the Social Security Appeal Board (SAMU) or the Insurance Court."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Muutoksenhakuelin"@fi ,
                "Appeal body"@en ,
                "Besvärsinstans"@sv ;
        skos:prefLabel "Muutoksenhakuelin"@fi ,
                "Appeal body"@en ,
                "Besvärsinstans"@sv .

:appealHandledBy rdf:type owl:ObjectProperty ;
        rdfs:domain :Appeal ;
        rdfs:range :AppealBody ;
        rdfs:comment "Valituksen käsittelee tämä muutoksenhakuelin."@fi ,
                "The appeal is handled by this appeal body."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "käsittelevä muutoksenhakuelin"@fi ,
                "appeal handled by"@en ;
        skos:prefLabel "käsittelevä muutoksenhakuelin"@fi ,
                "appeal handled by"@en .


#################################################################
# KELAO-lisäys 0.4.1: Disjointness-aksioomat
#################################################################

# Aluetyypit ovat toisensa poissulkevia: yksi alue-instanssi kuuluu
# täsmälleen yhteen näistä hallinnollisista tyypeistä. Huom. Country ja
# Municipality ovat eri granulariteettitasoja; ne pidetään erillisinä,
# koska yksikään instanssi ei ole samanaikaisesti kunta ja valtio.
[] rdf:type owl:AllDisjointClasses ;
   owl:members ( :Municipality :Region :Country :EmploymentArea :WellbeingServiceCounty ) ;
   rdfs:comment "Hallinnolliset aluetyypit ovat toisensa poissulkevia."@fi ,
                "The administrative area types are mutually disjoint."@en .

# Etuuden rakennerooli: itsenäinen etuus vs. etuuden osa. Vahvistaa
# olemassa olevan BenefitComponent owl:disjointWith StandaloneBenefit
# -väittämän osaksi eksplisiittistä disjointness-ryhmää.
# HUOM: Asiakasrooleja (Applicant, User, Beneficiary) EI merkitä
# disjunkteiksi, koska malli sallii saman asiakkaan esiintyä useassa
# roolissa (esim. hakija joka on myös etuuden saaja).

#################################################################
# KELAO-lisäys 0.4.1: SKOS-käsitekaaviot (ConceptScheme)
# Luokat BenefitGroup, StatuteType ja LifeSituation saavat kukin
# owl:hasValue-restriktion skos:inScheme -ominaisuudella, joka
# luokittelee jokaisen käsitteen automaattisesti oikeaan kaavioon:
#   BenefitGroup  -> <http://kela.fi/kg/EtuusryhmaScheme>
#   StatuteType   -> <http://kela.fi/kg/saadostyyppi-luokitus>
#   LifeSituation -> <http://kela.fi/kg/ElamantilanneluokitusScheme>
# Itse kaaviot (skos:ConceptScheme) ja niiden käsitteet määritellään
# luokitusdatassa (Etuusryhma-skos.ttl, Statute-type-skos.ttl,
# Elamantilanneluokitus-skos.ttl), ei tässä ydinontologiassa.
#################################################################
