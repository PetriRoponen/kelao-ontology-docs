@prefix cpsv: <http://purl.org/vocab/cpsv#> .
@prefix cv: <http://data.europa.eu/m8g/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix kelao: <https://kela.fi/ontology/kelao#> .
@prefix kelaterm: <https://iri.suomi.fi/terminology/kela/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ptv: <http://iri.suomi.fi/model/suomiptv2/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:abstract a owl:AnnotationProperty .

dcterms:contributor a owl:AnnotationProperty .

dcterms:created a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

skos:ConceptScheme a owl:Class .

skos:broadMatch a owl:AnnotationProperty .

skos:changeNote a owl:AnnotationProperty .

skos:closeMatch a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:editorialNote a owl:AnnotationProperty .

skos:exactMatch a owl:AnnotationProperty .

skos:example a owl:AnnotationProperty .

skos:note a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .

skos:relatedMatch a owl:AnnotationProperty .

skos:scopeNote a owl:AnnotationProperty .

kelao:LegalResourcePart a owl:Class ;
    rdfs:label "Legal Resource Part"@en,
        "Lain osa"@fi,
        "Lagdel"@sv ;
    rdfs:comment "Esimerkiksi kansaneläkelain 23 §. Erottaa kokonaiset säädökset niiden osista; EU-säädöksissä jaottelu (artikla, kohta) poikkeaa kansallisesta."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf eli:LegalResource ;
    skos:definition "A structural part of a statute, such as a chapter, section, subsection or paragraph."@en,
        "Säädöksen rakenteellinen osa, kuten luku, pykälä, momentti tai kohta."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:example "Kansaneläkelain 23 §"@fi ;
    skos:prefLabel "Legal Resource Part"@en,
        "Lain osa"@fi,
        "Lagdel"@sv .

kelao:abbreviation a owl:DatatypeProperty ;
    rdfs:label "abbreviation"@en,
        "lyhenne"@fi ;
    rdfs:comment "Internal abbreviation used by Kela for the benefit."@en,
        "Kelan sisäisesti käyttämä etuuden lyhenne"@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Abbreviation of a benefit used internally by Kela."@en,
        "Etuuden lyhenne, jota Kela käyttää sisäisesti."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "abbreviation"@en,
        "lyhenne"@fi .

kelao:advancePayment a owl:ObjectProperty ;
    rdfs:label "advance payment"@en,
        "ennakkosuoritus"@fi ;
    rdfs:comment "Käytetään etuuksien välisen ennakkosuoritussuhteen kuvaamiseen. Käyttöala tarkistettava."@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating that a benefit may be paid as an advance for the waiting period of another benefit."@en,
        "Suhde, joka ilmaisee, että etuutta voidaan maksaa ennakkona toisen etuuden odotusajalta."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "advance payment"@en,
        "ennakkosuoritus"@fi ;
    kelao:relationshipAbbreviation "ENN"^^xsd:string .

kelao:alternative a owl:AnnotationProperty ;
    rdfs:label "law acronym"@en,
        "lain lyhenne"@fi ;
    rdfs:comment "An established acronym or alternative name for the legal resource."@en,
        "Säädöksen vakiintunut lyhenne tai vaihtoehtoinen nimi."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subPropertyOf skos:altLabel ;
    skos:exactMatch dcterms:alternative ;
    skos:prefLabel "law acronym"@en,
        "lain lyhenne"@fi ;
    skos:scopeNote "Käytetään kelao:LegalResource-instansseilla. Kuvaa säädöksen vakiintuneen lyhenteen, esim. 'KEL' tai 'SHL'."@fi .

kelao:amount a owl:DatatypeProperty ;
    rdfs:label "amount"@en,
        "määrä"@fi ;
    rdfs:comment "The amount of money."@en,
        "Käytetään etuuden, maksun, tuloerän ja takaisinperinnän määrälle. Valuutta oletusarvoisesti euro."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf schema:amount ;
    skos:definition "Monetary amount in euros."@en,
        "Rahamäärä euroina."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "amount"@en,
        "määrä"@fi .

kelao:appealDate a owl:DatatypeProperty ;
    rdfs:label "appeal date"@en,
        "muutoksenhaun päivä"@fi ;
    rdfs:comment "Date the appeal was filed."@en,
        "Päivä jolloin muutoksenhaku jätettiin."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:date ;
    skos:definition "Date on which the appeal was lodged."@en,
        "Päivä, jona muutoksenhaku on jätetty."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "appeal date"@en,
        "muutoksenhaun päivä"@fi ;
    skos:scopeNote "Käytetään kelao:Appeal-instansseilla (xsd:date)."@fi .

kelao:appealHandledBy a owl:ObjectProperty ;
    rdfs:label "appeal handled by"@en,
        "käsittelevä muutoksenhakuelin"@fi ;
    rdfs:comment "The appeal is handled by this appeal body."@en,
        "Valituksen käsittelee tämä muutoksenhakuelin."@fi ;
    rdfs:domain kelao:Appeal ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:AppealBody ;
    skos:definition "Relation stating the appeal body that handles the appeal."@en,
        "Suhde, joka ilmaisee muutoksenhakuelimen, joka käsittelee muutoksenhaun."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "appeal handled by"@en,
        "käsittelevä muutoksenhakuelin"@fi .

kelao:appealsDecision a owl:ObjectProperty ;
    rdfs:label "appeals decision"@en,
        "kohdistuu päätökseen"@fi ;
    rdfs:comment "The decision the appeal is directed against."@en,
        "Päätös, johon muutoksenhaku kohdistuu."@fi ;
    rdfs:domain kelao:Appeal ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Decision ;
    skos:definition "Relation stating the decision that the appeal concerns."@en,
        "Suhde, joka ilmaisee päätöksen, johon muutoksenhaku kohdistuu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "appeals decision"@en,
        "kohdistuu päätökseen"@fi .

kelao:applicationConcerns a owl:ObjectProperty ;
    rdfs:label "application concerns"@en,
        "hakemus koskee etuutta"@fi ;
    rdfs:comment "The benefit the application concerns."@en,
        "Etuus jota hakemus koskee."@fi ;
    rdfs:domain kelao:Application ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating the benefit that the application concerns."@en,
        "Suhde, joka ilmaisee etuuden, jota hakemus koskee."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "application concerns"@en,
        "hakemus koskee etuutta"@fi .

kelao:applicationStatus a owl:DatatypeProperty ;
    rdfs:label "application status"@en,
        "hakemuksen tila"@fi ;
    rdfs:comment "Processing status of the application."@en,
        "Esimerkiksi vireillä, käsittelyssä tai ratkaistu. Arvojoukko koodistona 0.6:ssa."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Processing status of an application."@en,
        "Hakemuksen käsittelyn tila."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "application status"@en,
        "hakemuksen tila"@fi ;
    skos:scopeNote "Käytetään kelao:Application-instansseilla. Esim. 'vireillä', 'käsittelyssä', 'ratkaistu'."@fi .

kelao:appliesFor a owl:ObjectProperty ;
    rdfs:label "applies for"@en,
        "hakee etuutta"@fi ;
    rdfs:comment "The applicant applies for this benefit."@en,
        "Hakija hakee tätä etuutta."@fi ;
    rdfs:domain kelao:Applicant ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating the benefit that the applicant applies for."@en,
        "Suhde, joka ilmaisee etuuden, jota hakija hakee."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "applies for"@en,
        "hakee etuutta"@fi .

kelao:areaCode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "area code"@en,
        "aluekoodi"@fi ;
    rdfs:comment "Official area code (e.g. municipality number or wellbeing service county identifier)."@en,
        "Esimerkiksi kuntanumero tai hyvinvointialueen tunnus. Yleinen ominaisuus; korvaa aluetyyppikohtaiset koodiominaisuudet."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Official code of an area in a national code list."@en,
        "Alueen virallinen koodi kansallisessa koodistossa."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "area code"@en,
        "aluekoodi"@fi ;
    skos:scopeNote "Käytetään kelao:Location-instansseilla (ja sen alaluokilla)."@fi .

kelao:attachmentInOmaKela a owl:DatatypeProperty ;
    rdfs:label "is attachment in OmaKela"@en,
        "onko liite OmaKelassa"@fi ;
    rdfs:comment "Whether the attachment can be requested or reported in OmaKela."@en,
        "Onko liite haettavissa tai ilmoitettavissa OmaKelassa."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the attachment can be submitted in the OmaKela e-service."@en,
        "Tieto siitä, voiko liitteen toimittaa OmaKela-asiointipalvelussa."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "is attachment in OmaKela"@en,
        "onko liite OmaKelassa"@fi ;
    skos:scopeNote "Käytetään kelao:Attachment-instansseilla (xsd:boolean)."@fi .

kelao:attachmentUri a owl:DatatypeProperty ;
    rdfs:label "attachment uri"@en,
        "liitteen uri"@fi ;
    rdfs:comment "URI link to where the attachment can be found."@en,
        "URI-linkki liitteeseen, josta liite löytyy."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:anyURI ;
    skos:definition "Web address where the attachment form or instructions are available."@en,
        "Verkko-osoite, josta liitelomake tai -ohje on saatavilla."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "attachment uri"@en,
        "liitteen uri"@fi ;
    skos:scopeNote "Käytetään kelao:Attachment-instansseilla (xsd:anyURI)."@fi .

kelao:belongsToCountry a owl:ObjectProperty ;
    rdfs:label "belongs to country"@en,
        "kuuluu valtioon"@fi ;
    rdfs:comment "The area belongs to this country. Used for regions, wellbeing service counties, employment areas and, where needed, directly for municipalities."@en,
        "Alue kuuluu tähän valtioon. Käytetään maakunnille, hyvinvointialueille, työllisyysalueille ja tarvittaessa suoraan kunnille."@fi ;
    rdfs:domain kelao:Location ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Country ;
    rdfs:subPropertyOf kelao:isPartOfArea ;
    skos:definition "Relation stating the country to which an area belongs."@en,
        "Suhde, joka ilmaisee valtion, johon alue kuuluu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "belongs to country"@en,
        "kuuluu valtioon"@fi .

kelao:belongsToEmploymentArea a owl:ObjectProperty ;
    rdfs:label "belongs to employment area"@en,
        "kuuluu työllisyysalueeseen"@fi ;
    rdfs:comment "The municipality belongs to this employment area. Optional: e.g. municipalities in Åland have no employment area."@en,
        "Kunta kuuluu tähän työllisyysalueeseen. Ei pakollinen: esim. Ahvenanmaan kunnilla ei ole työllisyysaluetta."@fi ;
    rdfs:domain kelao:Municipality ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:EmploymentArea ;
    rdfs:subPropertyOf kelao:isPartOfArea ;
    skos:definition "Relation stating the employment area to which a municipality belongs."@en,
        "Suhde, joka ilmaisee työllisyysalueen, johon kunta kuuluu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "belongs to employment area"@en,
        "kuuluu työllisyysalueeseen"@fi .

kelao:belongsToRegion a owl:ObjectProperty ;
    rdfs:label "belongs to region"@en,
        "kuuluu maakuntaan"@fi ;
    rdfs:comment "The municipality belongs to this region (maakunta). Parallel to wellbeing service county membership; the two hierarchies are independent."@en,
        "Kunta kuuluu tähän maakuntaan. Rinnakkainen hierarkia hyvinvointialueeseen kuulumisen kanssa: kunta kuuluu sekä maakuntaan että hyvinvointialueeseen."@fi ;
    rdfs:domain kelao:Municipality ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Region ;
    rdfs:subPropertyOf kelao:isPartOfArea ;
    skos:definition "Relation stating the region to which a municipality belongs."@en,
        "Suhde, joka ilmaisee maakunnan, johon kunta kuuluu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "belongs to region"@en,
        "kuuluu maakuntaan"@fi .

kelao:belongsToWellbeingServiceCounty a owl:ObjectProperty ;
    rdfs:label "belongs to wellbeing service county"@en,
        "kuuluu hyvinvointialueeseen"@fi ;
    rdfs:comment "Kunta kuuluu tähän hyvinvointialueeseen."@fi ;
    rdfs:domain kelao:Municipality ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:WellbeingServiceCounty ;
    rdfs:subPropertyOf kelao:isPartOfArea ;
    skos:definition "Relation stating the wellbeing services county to which a municipality belongs."@en,
        "Suhde, joka ilmaisee hyvinvointialueen, johon kunta kuuluu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "belongs to wellbeing service county"@en,
        "kuuluu hyvinvointialueeseen"@fi .

kelao:broaderBenefit a owl:ObjectProperty ;
    rdfs:label "broader benefit"@en,
        "laajempi etuus"@fi ;
    rdfs:comment "Käsitehierarkia, ei osa–kokonaisuus-suhde (vrt. kelao:isPartOfBenefit). Esimerkiksi opintoraha → opintotuki."@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating the broader benefit under which a benefit is conceptually subsumed."@en,
        "Suhde, joka ilmaisee laajemman etuuskokonaisuuden, johon etuus käsitteellisesti sisältyy."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "broader benefit"@en,
        "laajempi etuus"@fi .

kelao:calculationBase a owl:DatatypeProperty ;
    rdfs:label "calculation base"@en,
        "laskentaperuste"@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Basis on which the amount of a benefit is calculated."@en,
        "Peruste, jonka mukaan etuuden määrä lasketaan."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "calculation base"@en,
        "laskentaperuste"@fi .

kelao:criterionLegalBasis a owl:ObjectProperty ;
    rdfs:label "criterion legal basis"@en,
        "kriteerin oikeusperusta"@fi ;
    rdfs:comment "Legal basis of the criterion: reference to a legal resource or its subdivision (ELI URI, section level)."@en,
        "Kriteerin oikeusperusta: viittaus säädökseen tai sen osaan (ELI-URI, pykälätaso)."@fi ;
    rdfs:domain kelao:EligibilityCriterion ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:LegalResource ;
    skos:definition "Relation stating the statute or part of a statute on which an eligibility criterion is based."@en,
        "Suhde, joka ilmaisee säädöksen tai sen osan, johon etuuskriteeri perustuu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "criterion legal basis"@en,
        "kriteerin oikeusperusta"@fi .

kelao:currentVersion a owl:DatatypeProperty ;
    rdfs:label "current version uri"@en,
        "ajantasaisen lainosan URI"@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:anyURI ;
    skos:definition "Web address of the current version of a part of a statute."@en,
        "Säädöksen osan ajantasaisen version verkko-osoite."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "current version uri"@en,
        "ajantasaisen lainosan URI"@fi .

kelao:date_document a owl:DatatypeProperty ;
    rdfs:label "date of document"@en,
        "säädöksen päiväys"@fi ;
    dcterms:source eli:date_document ;
    rdfs:comment "Date of adoption or signature of the legal resource (yyyy-mm-dd)."@en,
        "Säädöksen hyväksymis- tai allekirjoituspäivä muodossa vvvv-kk-pp."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf eli:date_document ;
    skos:definition "Date on which the statute was adopted or signed."@en,
        "Päivä, jona säädös on hyväksytty tai allekirjoitettu."@fi ;
    skos:exactMatch schema:legislationDate ;
    skos:prefLabel "date of document"@en,
        "säädöksen päiväys"@fi ;
    skos:scopeNote "Käytetään kelao:LegalResource-instansseilla."@fi .

kelao:decisionDate a owl:DatatypeProperty ;
    rdfs:label "decision date"@en,
        "päätöspäivä"@fi ;
    rdfs:comment "Date the decision was issued."@en,
        "Päivä jolloin päätös annettiin."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:date ;
    skos:definition "Date on which the decision was issued."@en,
        "Päivä, jona päätös on annettu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "decision date"@en,
        "päätöspäivä"@fi ;
    skos:scopeNote "Käytetään kelao:Decision-instansseilla (xsd:date)."@fi .

kelao:decisionOutcome a owl:DatatypeProperty ;
    rdfs:label "decision outcome"@en,
        "päätöksen lopputulos"@fi ;
    rdfs:comment "Outcome of the decision."@en,
        "Esimerkiksi myönnetty, hylätty tai osittain myönnetty. Arvojoukko koodistona 0.6:ssa."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Outcome of the decision."@en,
        "Päätöksen ratkaisun lopputulos."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "decision outcome"@en,
        "päätöksen lopputulos"@fi ;
    skos:scopeNote "Käytetään kelao:Decision-instansseilla. Esim. 'myönnetty', 'hylätty', 'osittain myönnetty'."@fi .

kelao:filingDate a owl:DatatypeProperty ;
    rdfs:label "filing date"@en,
        "vireilletulopäivä"@fi ;
    rdfs:comment "Date the application was filed and became pending."@en,
        "Hakemuksen vireilletulopäivä."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:date ;
    skos:definition "Date on which the application became pending."@en,
        "Päivä, jona hakemus on tullut vireille."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "filing date"@en,
        "vireilletulopäivä"@fi ;
    skos:scopeNote "Käytetään kelao:Application-instansseilla (xsd:date). Päivä jolloin hakemus tuli vireille."@fi .

kelao:financing a owl:DatatypeProperty ;
    rdfs:label "financing"@en,
        "rahoitus"@fi,
        "financsieringen"@sv ;
    rdfs:comment "How the financing is organized"@en,
        "Esimerkiksi valtion rahoitus, vakuutusmaksurahoitus tai näiden yhdistelmä."@fi,
        "Hur finansieringen är organiserad"@sv ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "The way in which the financing of a benefit is arranged."@en,
        "Tapa, jolla etuuden rahoitus on järjestetty."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "financing"@en,
        "rahoitus"@fi,
        "financsieringen"@sv .

kelao:hasApplication a owl:ObjectProperty ;
    rdfs:label "has application"@en,
        "jätti hakemuksen"@fi ;
    rdfs:comment "An application submitted by the applicant."@en,
        "Hakijan jättämä hakemus."@fi ;
    rdfs:domain kelao:Applicant ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Application ;
    skos:definition "Relation stating an application submitted by the applicant."@en,
        "Suhde, joka ilmaisee hakijan jättämän hakemuksen."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "has application"@en,
        "jätti hakemuksen"@fi .

kelao:hasAttachment a owl:ObjectProperty ;
    rdfs:label "has attachment"@en,
        "hakemuksen liite"@fi ;
    rdfs:comment "An attachment belonging to the application."@en,
        "Hakemukseen liittyvä liite."@fi ;
    rdfs:domain kelao:Application ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Attachment ;
    skos:definition "Relation stating an attachment belonging to an application."@en,
        "Suhde, joka ilmaisee hakemukseen kuuluvan liitteen."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "has attachment"@en,
        "hakemuksen liite"@fi .

kelao:hasBenefitGroup a owl:ObjectProperty ;
    rdfs:label "has benefit group"@en,
        "etuusryhmä"@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:BenefitGroup ;
    skos:definition "Relation stating the benefit group into which a benefit is classified."@en,
        "Suhde, joka ilmaisee etuusryhmän, johon etuus on luokiteltu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "has benefit group"@en,
        "etuusryhmä"@fi .

kelao:hasBenefitPart a owl:ObjectProperty ;
    rdfs:label "has benefit part"@en,
        "etuudella on osa"@fi ;
    rdfs:domain kelao:StandaloneBenefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:BenefitComponent ;
    owl:inverseOf kelao:isPartOfBenefit ;
    skos:definition "Relation stating a benefit component of which a standalone benefit consists."@en,
        "Suhde, joka ilmaisee etuuden osan, josta itsenäinen etuus koostuu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "has benefit part"@en,
        "etuudella on osa"@fi .

kelao:hasConcept a owl:ObjectProperty ;
    rdfs:label "has concept"@en,
        "on käsite"@fi ;
    rdfs:comment "Käytetään linkitykseen Kelan terminologisen sanaston ja muiden SKOS-sanastojen käsitteisiin."@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range skos:Concept ;
    skos:definition "Relation linking a benefit to a vocabulary concept that describes it."@en,
        "Suhde, joka liittää etuuteen sitä kuvaavan sanaston käsitteen."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "has concept"@en,
        "on käsite"@fi .

kelao:hasCustomerRole a owl:ObjectProperty ;
    rdfs:label "has customer role"@en,
        "asiakkaan rooli"@fi ;
    rdfs:comment "The customer has this role (applicant, user or beneficiary). The same customer may hold several roles simultaneously or in different contexts."@en,
        "Asiakkaalla on tämä rooli (hakija, käyttäjä tai etuuden saaja). Sama asiakas voi olla useassa roolissa samanaikaisesti tai eri yhteyksissä."@fi ;
    rdfs:domain kelao:Customer ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( kelao:Applicant kelao:Beneficiary kelao:User ) ] ;
    owl:inverseOf kelao:roleOfCustomer ;
    skos:definition "Relation stating a role (applicant, user or beneficiary) in which a customer acts."@en,
        "Suhde, joka ilmaisee roolin (hakija, käyttäjä tai etuudensaaja), jossa asiakas toimii."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "has customer role"@en,
        "asiakkaan rooli"@fi .

kelao:hasDecision a owl:ObjectProperty ;
    rdfs:label "has decision"@en,
        "hakemuksen päätös"@fi ;
    rdfs:comment "The decision issued on the application."@en,
        "Hakemukseen annettu päätös."@fi ;
    rdfs:domain kelao:Application ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Decision ;
    skos:definition "Relation stating the decision issued on an application."@en,
        "Suhde, joka ilmaisee hakemukseen annetun päätöksen."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "has decision"@en,
        "hakemuksen päätös"@fi .

kelao:hasIncome a owl:ObjectProperty ;
    rdfs:label "has income"@en,
        "tulona"@fi ;
    rdfs:comment "The agent has this income item."@en,
        "Henkilöllä on tämä tuloerä."@fi ;
    rdfs:domain prov:Agent ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Income ;
    skos:definition "Relation stating an income item of an agent."@en,
        "Suhde, joka ilmaisee toimijan tuloerän."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "has income"@en,
        "tulona"@fi .

kelao:hasProvider a owl:ObjectProperty ;
    rdfs:label "has provider"@en,
        "vastuuorganisaatio"@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Organisation ;
    skos:definition "Relation stating the organisation responsible for administering a benefit."@en,
        "Suhde, joka ilmaisee organisaation, joka vastaa etuuden toimeenpanosta."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "has provider"@en,
        "vastuuorganisaatio"@fi .

kelao:hasServiceChannel a owl:ObjectProperty ;
    rdfs:label "has channel"@en,
        "kanava"@fi ;
    rdfs:comment "A service has service channels. Services are accessible through service channels."@en,
        "Palvelulla on palvelukanava. Palvelu on käytettävissä palvelukanavien kautta."@fi ;
    rdfs:domain kelao:Service ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:ServiceChannel ;
    skos:closeMatch ptv:hasServiceChannel ;
    skos:definition "Relation stating a service channel through which a service is available."@en,
        "Suhde, joka ilmaisee palvelukanavan, jonka kautta palvelu on käytettävissä."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "has channel"@en,
        "kanava"@fi .

kelao:has_part a owl:ObjectProperty ;
    rdfs:label "has part"@en,
        "on osa säädöstä"@fi,
        "är del av"@sv ;
    dcterms:source eli:has_part ;
    rdfs:comment "Statute has part"@en,
        "ELI-ontologian eli:has_part-ominaisuuden aliominaisuus; nimi noudattaa siksi ELI:n snake_case-käytäntöä."@fi ;
    rdfs:domain kelao:LegalResource ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:LegalResource ;
    rdfs:subPropertyOf eli:has_part,
        schema:hasPart ;
    skos:definition "Relation stating a structural part of a legal resource."@en,
        "Suhde, joka ilmaisee säädöksen rakenteellisen osan."@fi ;
    skos:prefLabel "has part"@en,
        "on osa säädöstä"@fi,
        "är del av"@sv .

kelao:homepage a owl:DatatypeProperty ;
    rdfs:label "homepage"@en,
        "kotisivu"@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:anyURI ;
    skos:definition "Address of the web page describing a benefit."@en,
        "Etuutta kuvaavan verkkosivun osoite."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:exactMatch ptv:homePage ;
    skos:prefLabel "homepage"@en,
        "kotisivu"@fi ;
    skos:scopeNote "Käytetään kelao:Benefit-instansseilla etuuden kotisivuun viittaamisessa."@fi .

kelao:id_local a owl:DatatypeProperty ;
    rdfs:label "local identifier"@en,
        "paikallinen tunniste"@fi ;
    dcterms:source eli:id_local ;
    rdfs:comment "National identifier of the legal resource in the form number/year."@en,
        "Säädöksen kansallinen tunniste muodossa numero/vuosi."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf eli:id_local ;
    skos:definition "National identifier of a statute in the form number/year."@en,
        "Säädöksen kansallinen tunniste muodossa numero/vuosi."@fi ;
    skos:exactMatch schema:legislationIdentifier ;
    skos:prefLabel "local identifier"@en,
        "paikallinen tunniste"@fi ;
    skos:scopeNote """Käytetään kelao:LegalResource-instansseilla. 
         Arvo on säädöksen kansallinen numero/vuosi-tunniste, 
         esim. '404/1948' tai '1301/2007'."""@fi .

kelao:incomeConsideredIn a owl:ObjectProperty ;
    rdfs:label "income considered in"@en,
        "huomioidaan etuudessa"@fi ;
    rdfs:comment "The income item is taken into account in the means testing of this benefit."@en,
        "Tuloerä otetaan huomioon tämän etuuden tulovähenteisyydessä tai tarveharkinnassa."@fi ;
    rdfs:domain kelao:Income ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating the benefit in whose calculation or means test an income item is taken into account."@en,
        "Suhde, joka ilmaisee etuuden, jonka määrää laskettaessa tai tarveharkinnassa tuloerä otetaan huomioon."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "income considered in"@en,
        "huomioidaan etuudessa"@fi .

kelao:indexLinked a owl:DatatypeProperty ;
    rdfs:label "index linked"@en,
        "indeksisidonnainen"@fi ;
    rdfs:comment "Esimerkiksi kansaneläkeindeksi (sanasto c520). Arvojoukko koodistona 0.6:ssa."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Index to which the amount of a benefit is linked."@en,
        "Indeksi, johon etuuden määrä on sidottu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "index linked"@en,
        "indeksisidonnainen"@fi ;
    skos:relatedMatch kelaterm:c520 .

kelao:inhibiting a owl:ObjectProperty ;
    rdfs:label "inhibiting benefit"@en,
        "estävä etuus"@fi,
        "hindrande förmån"@sv ;
    dcterms:source kelaterm:c66 ;
    rdfs:comment "Esimerkiksi työkyvyttömyyseläke on estävä etuus ansiopäivärahan, yleistuen ja opintotuen suhteen. Käsite: sanasto c66 (estävä etuus)."@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating a benefit taken into account that prevents this benefit from being granted to the applicant."@en,
        "Suhde, joka ilmaisee huomioon otettavan etuuden, jonka vuoksi etuudenhakijalle ei myönnetä tätä etuutta."@fi,
        "förmån som ska beaktas och på grund av vilken den förmånssökande inte beviljas en annan förmån"@sv ;
    skos:prefLabel "inhibiting benefit"@en,
        "estävä etuus"@fi,
        "hindrande förmån"@sv ;
    skos:relatedMatch kelaterm:c66 ;
    kelao:relationshipAbbreviation "EST"^^xsd:string .

kelao:investigate a owl:ObjectProperty ;
    rdfs:label "benefit to investigate"@en,
        "selvitä etuus"@fi ;
    rdfs:comment "Käyttöala ja nimi tarkistettava 0.6:ssa; verbimuotoinen nimi poikkeaa käytännöstä."@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating another benefit whose entitlement must be examined before this benefit is decided."@en,
        "Suhde, joka ilmaisee toisen etuuden, jonka saamisen edellytykset on selvitettävä ennen tämän etuuden ratkaisemista."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "benefit to investigate"@en,
        "selvitä etuus"@fi ;
    kelao:relationshipAbbreviation "SEL"^^xsd:string .

kelao:isCriterionFor a owl:ObjectProperty ;
    rdfs:label "is criterion for"@en,
        "on kriteeri etuudelle"@fi ;
    rdfs:comment "The criterion applies to this benefit."@en,
        "Kriteeri koskee tätä etuutta."@fi ;
    rdfs:domain kelao:EligibilityCriterion ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    owl:inverseOf kelao:hasEligibilityCriterion ;
    skos:definition "Relation stating the benefit for which the criterion is an eligibility condition."@en,
        "Suhde, joka ilmaisee etuuden, jonka myöntämisedellytys kriteeri on."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "is criterion for"@en,
        "on kriteeri etuudelle"@fi .

kelao:isEligibleFor a owl:ObjectProperty ;
    rdfs:label "is eligible for"@en,
        "on oikeutettu etuuteen"@fi ;
    rdfs:comment "User or applicant has been determined eligible for the benefit."@en,
        "Käsitteellinen suhde: perustuu esiselvitykseen tai päätökseen. Tietämysgraafi ei sisällä henkilökohtaisia oikeustietoja."@fi ;
    rdfs:domain kelao:User ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating a benefit to which the user has been found entitled."@en,
        "Suhde, joka ilmaisee etuuden, johon käyttäjä on todettu oikeutetuksi."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "is eligible for"@en,
        "on oikeutettu etuuteen"@fi .

kelao:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude"@en,
        "leveysaste"@fi ;
    dcterms:source <https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.1/> ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:decimal ;
    skos:definition "The geographic coordinate that specifies the north / south position of the geometry on the Earth's surface."@en,
        "Sijainnin leveysaste WGS84-koordinaatistossa."@fi ;
    skos:exactMatch geo:lat ;
    skos:prefLabel "latitude"@en,
        "leveysaste"@fi ;
    skos:scopeNote "Käytetään kelao:Location-instansseilla. Linkitetty WGS84-sanastoon (geo:lat)."@fi .

kelao:legalReference a owl:ObjectProperty ;
    rdfs:label "has legal reference"@en,
        "on lakiviittaus"@fi ;
    rdfs:comment "Etuus tai palvelu perustuu tähän lakiin tai säädökseen."@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:LegalResource ;
    skos:definition "Relation stating the statute on which a benefit is based."@en,
        "Suhde, joka ilmaisee säädöksen, johon etuus perustuu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "has legal reference"@en,
        "on lakiviittaus"@fi .

kelao:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude"@en,
        "pituusaste"@fi ;
    dcterms:source <https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.1/> ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:decimal ;
    skos:definition "The geographic coordinate that specifies the east / west position of the Geometry on the Earth's surface."@en,
        "Sijainnin pituusaste WGS84-koordinaatistossa."@fi ;
    skos:exactMatch geo:long ;
    skos:prefLabel "longitude"@en,
        "pituusaste"@fi ;
    skos:scopeNote "Käytetään kelao:Location-instansseilla. Linkitetty WGS84-sanastoon (geo:long)."@fi .

kelao:maximumAge a owl:DatatypeProperty ;
    rdfs:label "maximum age"@en,
        "yläikäraja"@fi,
        "övre åldersgräns"@sv ;
    rdfs:comment "Maximum age limit"@en ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:integer ;
    skos:definition "Age above which a person is not entitled to the benefit."@en,
        "Ikä, jonka ylittänyt henkilö ei ole oikeutettu etuuteen."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "maximum age"@en,
        "yläikäraja"@fi,
        "övre åldersgräns"@sv .

kelao:meansTest a owl:DatatypeProperty ;
    rdfs:label "means test"@en,
        "tarveharkinta"@fi,
        "behovsprövning"@sv ;
    dcterms:source kelaterm:c688 ;
    rdfs:comment "Determining entitlement to benefits requires a means test."@en,
        "Vapaamuotoinen selitys etuuden tarveharkinnasta. Käsite: sanasto c688 (tarveharkinta)."@fi,
        "För att fastställa rätten till förmåner krävs en behovsprövning."@sv ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Description of how the criteria for granting a benefit are applied to a person’s need."@en,
        "Kuvaus siitä, miten etuuksien tai palvelujen myöntämisen kriteerejä sovelletaan henkilön tarpeeseen."@fi,
        "Tillämpning av kriterierna för beviljande av förmåner eller service på en persons behov."@sv ;
    skos:prefLabel "means test"@en,
        "tarveharkinta"@fi,
        "behovsprövning"@sv ;
    skos:relatedMatch kelaterm:c688 .

kelao:meansTestedIncome a owl:ObjectProperty ;
    rdfs:label "means-tested income"@en,
        "tarveharkinnan tulo"@fi ;
    rdfs:comment "Vrt. kelao:incomeConsideredIn (tuloerä → etuus). Päällekkäisyys tarkistettava 0.6:ssa."@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating another benefit that is counted as income in the means test of this benefit."@en,
        "Suhde, joka ilmaisee toisen etuuden, joka otetaan tulona huomioon tämän etuuden tarveharkinnassa."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "means-tested income"@en,
        "tarveharkinnan tulo"@fi .

kelao:minimumAge a owl:DatatypeProperty ;
    rdfs:label "minimum age"@en,
        "alaikäraja"@fi,
        "nedre åldersgräns"@sv ;
    rdfs:comment "Minimum age limit"@en ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:integer ;
    skos:definition "Age a person must have reached to be entitled to the benefit."@en,
        "Ikä, jonka henkilön on täytettävä ollakseen oikeutettu etuuteen."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "minimum age"@en,
        "alaikäraja"@fi,
        "nedre åldersgräns"@sv .

kelao:minimumAmount a owl:ObjectProperty ;
    rdfs:label "minimum amount benefit"@en,
        "minimimääräinen etuus"@fi ;
    rdfs:comment "Käyttöala tarkistettava: nykyinen kommentti (\"minimimääräinen etuus\") ei kerro suhteen suuntaa."@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating the benefit that determines the minimum amount of this benefit."@en,
        "Suhde, joka ilmaisee etuuden, joka määrää tämän etuuden vähimmäismäärän."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "minimum amount benefit"@en,
        "minimimääräinen etuus"@fi ;
    kelao:relationshipAbbreviation "MIN"^^xsd:string .

kelao:municipalityGroup a owl:DatatypeProperty ;
    rdfs:label "municipality group"@en,
        "kuntaryhmä"@fi ;
    dcterms:source kelaterm:c552 ;
    rdfs:comment "Kela's municipality group for general housing allowance: I, II, III or IV."@en,
        "Yleisen asumistuen kuntaryhmäluokitus: I, II, III tai IV."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Group of municipalities formed on the basis of housing costs, used in calculating housing allowances and the housing supplement of student aid."@en,
        "Asumisen kalleuden perusteella muodostettu kuntien ryhmä, johon kunta on luokiteltu asumistukien ja opintotuen asumislisän laskemista varten."@fi,
        "Grupp av kommuner som bildats för beräkning av bostadsbidrag för pensionstagare, allmänt bostadsbidrag och studiestödets bostadstillägg och som den kommun där den förmånssökandes bostad finns tillhör på basis av hur dyrt boendet är."@sv ;
    skos:prefLabel "municipality group"@en,
        "kuntaryhmä"@fi ;
    skos:relatedMatch kelaterm:c552 ;
    skos:scopeNote "Käytetään kelao:Municipality-instansseilla. Lähdeontologiassa nimellä kuntaryhma."@fi .

kelao:noteworthy a owl:ObjectProperty ;
    rdfs:label "benefit to be noted"@en,
        "huomautus"@fi ;
    rdfs:comment "Täydentää suhteita kelao:inhibiting ja kelao:reducing (vrt. sanaston huomioon otettava etuus, c63). Nimi ja käyttöala tarkistettava."@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating another benefit to be noted when deciding this benefit without preventing or reducing it."@en,
        "Suhde, joka ilmaisee toisen etuuden, joka on otettava huomioon tätä etuutta ratkaistaessa ilman että se estää tai vähentää etuutta."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "benefit to be noted"@en,
        "huomautus"@fi ;
    skos:relatedMatch kelaterm:c63 ;
    kelao:relationshipAbbreviation "HUO"^^xsd:string .

kelao:partIdentifier a owl:DatatypeProperty ;
    rdfs:label "part identifier"@en,
        "osan tunniste"@fi ;
    rdfs:comment "Esim. '23' pykälälle, '1' momentille, 'a' kohdalle"@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Identifier of a part of a statute."@en,
        "Säädöksen osan tunnus."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "part identifier"@en,
        "osan tunniste"@fi .

kelao:partOrder a owl:DatatypeProperty ;
    rdfs:label "part order"@en,
        "järjestysnumero"@fi ;
    rdfs:comment "Part order of the statute"@en,
        "Osan järjestysnumero (esim. 1, 2, 3...)"@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:integer ;
    skos:definition "Ordinal number of a part of a statute."@en,
        "Säädöksen osan järjestysnumero."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "part order"@en,
        "järjestysnumero"@fi .

kelao:partText a owl:DatatypeProperty ;
    rdfs:label "part text"@en,
        "lainosan teksti"@fi ;
    rdfs:comment "Part text of the statute"@en,
        "Lainosan esim. pykälän teksti"@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Text of a part of a statute."@en,
        "Säädöksen osan teksti."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "part text"@en,
        "lainosan teksti"@fi .

kelao:partType a owl:DatatypeProperty ;
    rdfs:label "part type"@en,
        "osan tyyppi"@fi ;
    rdfs:comment "Esimerkiksi luku, pykälä, momentti tai kohta."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Kind of a part of a statute."@en,
        "Säädöksen osan laji."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:example "momentti"@fi,
        "pykälä"@fi ;
    skos:prefLabel "part type"@en,
        "osan tyyppi"@fi .

kelao:paymentBasedOnDecision a owl:ObjectProperty ;
    rdfs:label "payment based on decision"@en,
        "perustuu ratkaisuun"@fi ;
    rdfs:comment "The payment is based on this decision."@en,
        "Maksu perustuu tähän ratkaisuun."@fi ;
    rdfs:domain kelao:Payment ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Decision ;
    skos:definition "Relation stating the decision on which a payment is based."@en,
        "Suhde, joka ilmaisee päätöksen, johon maksu perustuu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "payment based on decision"@en,
        "perustuu ratkaisuun"@fi .

kelao:paymentOf a owl:ObjectProperty ;
    rdfs:label "payment of"@en,
        "etuuden maksu"@fi ;
    rdfs:comment "The payment is a disbursement of this benefit."@en,
        "Maksu on tämän etuuden suoritus."@fi ;
    rdfs:domain kelao:Payment ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating the benefit of which the payment is a disbursement."@en,
        "Suhde, joka ilmaisee etuuden, jonka suoritus maksu on."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "payment of"@en,
        "etuuden maksu"@fi .

kelao:paymentRecipient a owl:ObjectProperty ;
    rdfs:label "payment recipient"@en,
        "maksun saajana"@fi ;
    dcterms:source kelaterm:c76 ;
    rdfs:comment "Recipient of the payment. May differ from the applicant (e.g. landlord or municipality)."@en,
        "Maksunsaaja ei aina ole sama kuin etuudensaaja, esimerkiksi alaikäisen etuudensaajan huoltaja, kunta tai vuokranantaja."@fi ;
    rdfs:domain kelao:Payment ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range prov:Agent ;
    skos:definition "Relation stating the person or organisation to whom a monetary benefit is paid."@en,
        "Suhde, joka ilmaisee henkilön tai organisaation, jolle rahallinen etuus maksetaan."@fi,
        "Person eller organisation som en ekonomisk förmån betalas till."@sv ;
    skos:prefLabel "payment recipient"@en,
        "maksun saajana"@fi ;
    skos:relatedMatch kelaterm:c76 .

kelao:postOffice a owl:DatatypeProperty ;
    rdfs:label "post office"@en,
        "postitoimipaikka"@fi ;
    rdfs:comment "Post office; searched by postal code."@en,
        "Postitoimipaikka. Haetaan postinumeron perusteella."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Post office (postal locality)."@en,
        "Postitoimipaikka."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "post office"@en,
        "postitoimipaikka"@fi ;
    skos:scopeNote "Käytetään kelao:ServiceChannel- ja kelao:ServiceUnit-instansseilla."@fi .

kelao:postalCode a owl:DatatypeProperty ;
    rdfs:label "postal code"@en,
        "postinumero"@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Postal code."@en,
        "Postinumero."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:exactMatch schema:postalCode ;
    skos:prefLabel "postal code"@en,
        "postinumero"@fi ;
    skos:scopeNote "Käytetään kelao:ServiceChannel- ja kelao:ServiceUnit-instansseilla."@fi .

kelao:processingTime a owl:DatatypeProperty ;
    rdfs:label "processing time"@en,
        "käsittelyaika"@fi,
        "handläggningstid"@sv ;
    rdfs:comment "Expressed in xsd:duration format. Processing time in business days is expressed with the same property (e.g. 5.1 business days = P5DT19H12M); the overlapping property kelao:processingTimeBusinessDays was removed for this reason in version 0.5.1."@en,
        "Arvo ilmaistaan xsd:duration-muodossa. Käsittelyaika arkipäivinä ilmaistaan samalla ominaisuudella (esim. 5,1 arkipäivää = P5DT19H12M); päällekkäinen ominaisuus kelao:processingTimeBusinessDays on poistettu tämän vuoksi versiossa 0.5.1."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:duration ;
    skos:definition "Average processing time of an application from receipt to decision."@en,
        "Hakemuksen keskimääräinen käsittelyaika hakemuksen saapumisesta päätökseen."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "processing time"@en,
        "käsittelyaika"@fi,
        "handläggningstid"@sv ;
    skos:scopeNote "xsd:duration ei kuulu OWL 2 DL -datatyyppikarttaan, mutta on tuettu kaikissa KELAO-kohdejärjestelmissä (GraphDB, Fuseki)."@fi .

kelao:purpose a owl:DatatypeProperty ;
    rdfs:label "purpose"@en,
        "tarkoitus"@fi,
        "syftet med förmånen"@sv ;
    rdfs:comment "The purpose of the benefit"@en,
        "Etuuden tarkoitus"@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Purpose for which the benefit has been enacted."@en,
        "Tarkoitus, jota varten etuus on säädetty."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "purpose"@en,
        "tarkoitus"@fi,
        "syftet med förmånen"@sv .

kelao:receivesBenefit a owl:ObjectProperty ;
    rdfs:label "receives benefit"@en,
        "saa etuutta"@fi ;
    rdfs:comment "The beneficiary receives this benefit."@en,
        "Saaja saa tätä etuutta."@fi ;
    rdfs:domain kelao:Beneficiary ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating the benefit that a beneficiary receives."@en,
        "Suhde, joka ilmaisee etuuden, jota etuudensaaja saa."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "receives benefit"@en,
        "saa etuutta"@fi .

kelao:recipientUnit a owl:DatatypeProperty ;
    rdfs:label "recipient unit"@en,
        "saajayksikkö"@fi,
        "mottagande enhet"@sv ;
    rdfs:comment "Esimerkiksi henkilö, ruokakunta (sanasto c544) tai perhe."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Unit to which the benefit is granted and on the basis of which its amount is calculated."@en,
        "Yksikkö, jolle etuus myönnetään ja jonka perusteella etuuden määrä lasketaan."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "recipient unit"@en,
        "saajayksikkö"@fi,
        "mottagande enhet"@sv ;
    skos:relatedMatch kelaterm:c544 .

kelao:recoveryConcerns a owl:ObjectProperty ;
    rdfs:label "recovery concerns"@en,
        "kohdistuu maksuun"@fi ;
    rdfs:comment "The recovery concerns this payment."@en,
        "Takaisinperintä kohdistuu tähän maksuun."@fi ;
    rdfs:domain kelao:Recovery ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Payment ;
    skos:definition "Relation stating the payment that a recovery concerns."@en,
        "Suhde, joka ilmaisee maksun, johon takaisinperintä kohdistuu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "recovery concerns"@en,
        "kohdistuu maksuun"@fi .

kelao:reducing a owl:ObjectProperty ;
    rdfs:label "reducing benefit"@en,
        "vähentävä etuus"@fi ;
    dcterms:source kelaterm:c65 ;
    rdfs:comment "Käsite: sanasto c65 (vähentävä etuus)."@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating a benefit taken into account that reduces the amount of this benefit."@en,
        "Suhde, joka ilmaisee huomioon otettavan etuuden, joka vähentää tämän etuuden määrää."@fi,
        "förmån som ska beaktas och som minskar beloppet av en annan förmån"@sv ;
    skos:prefLabel "reducing benefit"@en,
        "vähentävä etuus"@fi ;
    skos:relatedMatch kelaterm:c65 ;
    kelao:relationshipAbbreviation "VÄH"^^xsd:string .

kelao:relatedBenefit a owl:ObjectProperty ;
    rdfs:label "has related benefit"@en,
        "säädös koskee etuutta"@fi ;
    rdfs:comment "Käänteinen suunta suhteelle kelao:legalReference. Label \"säädös koskee etuutta\" lyhennettävä."@fi ;
    rdfs:domain kelao:LegalResource ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating a benefit that a statute concerns."@en,
        "Suhde, joka ilmaisee etuuden, jota säädös koskee."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "has related benefit"@en,
        "säädös koskee etuutta"@fi .

kelao:relatedService a owl:ObjectProperty ;
    rdfs:label "related service"@en,
        "etuuteen liittyvä palvelu"@fi ;
    rdfs:comment "A service related to the benefit, e.g. an application or advisory service."@en,
        "Etuuteen liittyvä palvelu, esim. hakemus- tai neuvontapalvelu."@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Service ;
    skos:definition "Relation stating a service related to a benefit."@en,
        "Suhde, joka ilmaisee etuuteen liittyvän palvelun."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "related service"@en,
        "etuuteen liittyvä palvelu"@fi .

kelao:relatedToLifeSituation a owl:ObjectProperty ;
    rdfs:label "related to life situation"@en,
        "liittyy elämäntilanteeseen"@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:LifeSituation ;
    owl:inverseOf kelao:isLifeSituationFor ;
    skos:definition "Relation stating a life situation to which a benefit is related."@en,
        "Suhde, joka ilmaisee elämäntilanteen, johon etuus liittyy."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "related to life situation"@en,
        "liittyy elämäntilanteeseen"@fi .

kelao:relationshipAbbreviation a owl:AnnotationProperty ;
    rdfs:label "Relationship abbreviation"@en,
        "Relaation lyhenne"@fi ;
    rdfs:comment "Relationship abbreviation"@en,
        "Relaation lyhenne"@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    skos:prefLabel "Relationship abbreviation"@en,
        "Relaation lyhenne"@fi .

kelao:requiresEmploymentHistory a owl:DatatypeProperty ;
    rdfs:label "requires employment history"@en,
        "vaatii työhistorian"@fi ;
    dcterms:source kelaterm:c678 ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether entitlement to the benefit requires that the employment condition is met."@en,
        "Tieto siitä, edellyttääkö etuuden saaminen työssäoloehdon täyttymistä."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "requires employment history"@en,
        "vaatii työhistorian"@fi ;
    skos:relatedMatch kelaterm:c678 .

kelao:residenceRequired a owl:DatatypeProperty ;
    rdfs:label "residence required"@en,
        "vaatii asumisen Suomessa"@fi ;
    dcterms:source kelaterm:c529 ;
    rdfs:comment "Asumisedellytys (sanasto c529): etuudenhakijan täytyy asua Suomessa, EU- tai Eta-maassa tai Sveitsissä."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:boolean ;
    skos:altLabel "asumisedellytys"@fi,
        "bosättningskrav"@sv ;
    skos:definition "Whether entitlement to the benefit requires that the residence condition is met."@en,
        "Tieto siitä, edellyttääkö etuuden saaminen asumisedellytyksen täyttymistä."@fi,
        "krav enligt vilket en förmånssökande ska bo i Finland, ett EU-land, ett EES-land eller Schweiz och en förmånslåtare vid sin död måste bo i något av dessa länder för att förmånssökanden ska ha rätt till en förmån"@sv ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "residence required"@en,
        "vaatii asumisen Suomessa"@fi ;
    skos:relatedMatch kelaterm:c529 .

kelao:residesInMunicipality a owl:ObjectProperty ;
    rdfs:label "resides in municipality"@en,
        "asuu kunnassa"@fi ;
    rdfs:comment "Hakijan tai ruokakunnan asuinkunta."@fi ;
    rdfs:domain kelao:Applicant ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Municipality ;
    skos:definition "Relation stating the municipality in which the applicant resides."@en,
        "Suhde, joka ilmaisee kunnan, jossa hakija asuu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "resides in municipality"@en,
        "asuu kunnassa"@fi ;
    skos:scopeNote "Käsitteellinen suhde. KELAO-tietämysgraafi ei sisällä hakijakohtaisia instansseja."@fi .

kelao:serviceChannelId a owl:DatatypeProperty ;
    rdfs:label "service channel id"@en,
        "palvelukanavan tunniste"@fi ;
    rdfs:comment "Unique identifier of the service channel in PTV."@en,
        "Palvelukanavan yksilöivä tunniste Palvelutietovarannossa."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Unique identifier of a service channel in the Finnish Service Catalogue (PTV)."@en,
        "Palvelukanavan yksilöivä tunniste Palvelutietovarannossa (PTV)."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "service channel id"@en,
        "palvelukanavan tunniste"@fi ;
    skos:scopeNote "Käytetään kelao:ServiceChannel-instansseilla."@fi .

kelao:serviceHours a owl:DatatypeProperty ;
    rdfs:label "service hours"@en,
        "palvelun aukioloajat"@fi ;
    rdfs:comment "Service opening hours."@en ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Opening hours of a service unit."@en,
        "Palvelupisteen aukioloajat."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "service hours"@en,
        "palvelun aukioloajat"@fi ;
    skos:scopeNote "Käytetään kelao:ServiceUnit-instansseilla."@fi .

kelao:serviceUnitOrganization a owl:ObjectProperty ;
    rdfs:label "service unit organisation"@en,
        "palvelupisteen organisaatio"@fi ;
    rdfs:comment "Service unit has organisation"@en,
        "Palvelupisteen vastuuorganisaatio."@fi ;
    rdfs:domain kelao:ServiceUnit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Organisation ;
    owl:inverseOf kelao:hasServiceUnit ;
    skos:definition "Relation stating the organisation responsible for a service unit."@en,
        "Suhde, joka ilmaisee palvelupisteestä vastaavan organisaation."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "service unit organisation"@en,
        "palvelupisteen organisaatio"@fi .

kelao:serviceUnitType a owl:DatatypeProperty ;
    rdfs:label "service unit type"@en,
        "palvelupisteen tyyppi"@fi ;
    rdfs:comment "Type of service unit."@en,
        "Esimerkiksi Kelan palvelupiste, yhteispalvelupiste tai pop up -palvelupiste (sanasto c863). Arvojoukko koodistona 0.6:ssa."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Type of a service unit."@en,
        "Palvelupisteen tyyppi."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "service unit type"@en,
        "palvelupisteen tyyppi"@fi ;
    skos:scopeNote "Käytetään kelao:ServiceUnit-instansseilla."@fi .

kelao:streetAddress a owl:DatatypeProperty ;
    rdfs:label "street address"@en,
        "katuosoite"@fi ;
    rdfs:comment "Street address. Service units do not have a separate visiting address."@en,
        "Katuosoite. Palvelupisteissä ei ole erikseen käyntiosoitetta."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:string ;
    skos:definition "Street address of a service unit."@en,
        "Palvelupisteen katuosoite."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:exactMatch schema:streetAddress ;
    skos:prefLabel "street address"@en,
        "katuosoite"@fi ;
    skos:scopeNote "Käytetään kelao:ServiceUnit-instansseilla."@fi .

kelao:taxable a owl:DatatypeProperty ;
    rdfs:label "taxable"@en,
        "verotettava"@fi,
        "beskattningsbar"@sv ;
    rdfs:comment "Is the benefit taxable"@en,
        "Onko etuus verotettava vai ei"@fi,
        "Är förmånen skattepliktig"@sv ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the benefit is taxable income."@en,
        "Tieto siitä, onko etuus veronalaista tuloa."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:note "Tiedot löytyvät myös sivulta https://www.kela.fi/verotus"@fi ;
    skos:prefLabel "taxable"@en,
        "verotettava"@fi,
        "beskattningsbar"@sv .

kelao:type_document a owl:ObjectProperty ;
    rdfs:label "type of document"@en,
        "säädöksen tyyppi"@fi,
        "type"@sv ;
    dcterms:source eli:type_document ;
    rdfs:comment "Statute type"@en,
        "ELI-ontologian eli:type_document-ominaisuuden aliominaisuus; nimi noudattaa ELI:n käytäntöä. Arvot ovat kelao:StatuteType-yksilöitä."@fi ;
    rdfs:domain kelao:LegalResource ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:StatuteType ;
    rdfs:subPropertyOf eli:type_document,
        schema:legislationType ;
    skos:definition "Relation stating the kind of a legal resource."@en,
        "Suhde, joka ilmaisee säädöksen lajin."@fi ;
    skos:prefLabel "type of document"@en,
        "säädöksen tyyppi"@fi,
        "type"@sv .


kelao:validFrom a owl:DatatypeProperty ;
    rdfs:label "valid from"@en,
        "voimassa alkaen"@fi,
        "början av giltighet"@sv ;
    dcterms:source kelaterm:c70 ;
    rdfs:comment "Start date of benefit validity"@en,
        "Etuuden voimassaoloaika (sanasto c70): ajanjakso, jona etuus on voimassa."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:date ;
    skos:definition "Date from which the benefit is in force."@en,
        "Päivä, josta alkaen etuus on voimassa."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:exactMatch schema:startDate ;
    skos:prefLabel "valid from"@en,
        "voimassa alkaen"@fi,
        "början av giltighet"@sv ;
    skos:relatedMatch kelaterm:c70 .

kelao:validTo a owl:DatatypeProperty ;
    rdfs:label "valid to"@en,
        "voimassa asti"@fi,
        "tills giltigt"@sv ;
    dcterms:source kelaterm:c70 ;
    rdfs:comment "End date of benefit validity"@en,
        "Etuuden voimassaolon loppu"@fi,
        "Förmånen gäller till och med datumet"@sv ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:date ;
    skos:definition "Date until which the benefit is in force."@en,
        "Päivä, johon asti etuus on voimassa."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:exactMatch schema:endDate ;
    skos:prefLabel "valid to"@en,
        "voimassa asti"@fi,
        "tills giltigt"@sv ;
    skos:relatedMatch kelaterm:c70 .

kelao:versionDate a owl:DatatypeProperty ;
    rdfs:label "version date"@en,
        "versiointipäivä"@fi ;
    dcterms:source eli:version_date ;
    rdfs:comment "The point-in-time at which the provided description of the legislation is valid."@en,
        "Päivämäärä, jolloin säädöksen tämä versio on voimassa."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range xsd:date ;
    rdfs:subPropertyOf eli:version_date ;
    skos:definition "Date on which this version of the statute entered into force."@en,
        "Päivä, jona säädöksen tämä versio on tullut voimaan."@fi ;
    skos:exactMatch schema:legislationDateVersion ;
    skos:prefLabel "version date"@en,
        "versiointipäivä"@fi ;
    skos:scopeNote "Käytetään kelao:LegalResource-instansseilla. Kuvaa hetken, jolloin säädöksen kyseinen versio on voimassa."@fi .

<http://kela.fi/kg/ElamantilanneluokitusScheme> a owl:NamedIndividual .

<http://kela.fi/kg/EtuusryhmaScheme> a owl:NamedIndividual .

<http://kela.fi/kg/saadostyyppi-luokitus> a owl:NamedIndividual .

dcterms:identifier a owl:DatatypeProperty .

schema:DigitalDocument a owl:Class .

schema:amount a owl:DatatypeProperty .

schema:hasPart a owl:ObjectProperty .

schema:legislationType a owl:ObjectProperty .

xsd:duration a rdfs:Datatype .

skos:altLabel a owl:AnnotationProperty .

org:Organization a owl:Class .

kelao:AppealBody a owl:Class ;
    rdfs:label "Appeal body"@en,
        "Muutoksenhakuelin"@fi,
        "Besvärsinstans"@sv ;
    dcterms:source kelaterm:c748 ;
    rdfs:comment "Appeal body: an organisation handling appeals, e.g. the Social Security Appeal Board (SAMU) or the Insurance Court."@en,
        "Kelan toiminnassa esimerkiksi sosiaaliturva-asioiden muutoksenhakulautakunta (SAMU), opintotuen muutoksenhakulautakunta, vakuutusoikeus ja hallinto-oikeudet."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf kelao:Organisation ;
    skos:definition "A body that handles appeals and is external to the authority that issued the decision."@en,
        "Muutoksenhakuja käsittelevä, päätöksen tehneestä viranomaisesta ulkopuolinen toimielin."@fi,
        "Organ som behandlar sökande av ändring och är fristående från den myndighet som fattat beslutet."@sv ;
    skos:exactMatch kelaterm:c748 ;
    skos:prefLabel "Appeal body"@en,
        "Muutoksenhakuelin"@fi,
        "Besvärsinstans"@sv .

kelao:Attachment a owl:Class ;
    rdfs:label "Attachment"@en,
        "Liite"@fi,
        "Bilaga"@sv ;
    dcterms:source "Kelan MOT-sanakirja"@fi ;
    rdfs:comment "An application attachment, e.g. a receipt, certificate or form."@en,
        "Hakemuksen liite, esim. tosite, todistus tai lomake."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf schema:DigitalDocument ;
    skos:definition "Additional material received from a customer, or material provided to the customer in connection with an outgoing document."@en,
        "Asiakkaalta vastaanotettu lisämateriaali tai lähtevän asiakirjan yhteydessä asiakkaalle välitettävä lisämateriaali."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "Attachment"@en,
        "Liite"@fi,
        "Bilaga"@sv ;
    skos:scopeNote "Liitettä tarvitaan joskus hakemuksen liitteeksi; pakollisuus on hakemus- tai etuuskohtaista (kuvataan SHACLissa, ei luokkatasolla)."@fi .

kelao:BenefitGroup a owl:Class ;
    rdfs:label "Benefit Group"@en,
        "Etuusryhmä"@fi ;
    dcterms:source "Kelan MOT-sanakirja"@fi ;
    rdfs:comment "Etuusryhmät ovat skos:Concept-yksilöitä erillisessä luokituksessa (skos:ConceptScheme); yksittäinen etuus liitetään ryhmään ominaisuudella kelao:hasBenefitGroup."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://kela.fi/kg/EtuusryhmaScheme> ;
            owl:onProperty skos:inScheme ],
        skos:Concept ;
    skos:definition "A group of benefits that share a similar purpose or other defined logical connection, on the basis of which they have been classified as belonging together."@en,
        "Joukko etuuksia, joilla on samankaltainen tarkoitus tai muu määritelty looginen yhteenkuuluvuus, joiden perusteella ne on luokiteltu kuuluvaksi yhteen."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "Benefit Group"@en,
        "Etuusryhmä"@fi .

kelao:Recovery a owl:Class ;
    rdfs:label "Recovery"@en,
        "Takaisinperintä"@fi,
        "Återkrav"@sv ;
    rdfs:comment "Recovery: reclaiming a benefit paid in excess or without grounds from the recipient."@en,
        "Takaisinperinnästä annetaan etuuspäätös. Kohdistuu maksuun (kelao:recoveryConcerns)."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf prov:Entity ;
    skos:altLabel "Claim for recovery"@en ;
    skos:definition "A procedure by which a benefit paid in excess or without grounds is reclaimed."@en,
        "Menettely, jossa liikaa tai perusteetta maksettu etuus peritään takaisin."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "Recovery"@en,
        "Takaisinperintä"@fi,
        "Återkrav"@sv .

kelao:StatuteType a owl:Class ;
    rdfs:label "Statute Type"@en,
        "Säädöstyyppi"@fi,
        "Författningstyp"@sv ;
    rdfs:comment "Statute type classification (draft). The Skos-classification has 13 classes for example EU regulation, Decree, Agreement, Government decree, and Presidential decree."@en,
        "Esimerkiksi laki, valtioneuvoston asetus, EU-asetus tai sopimus. Lajit ovat skos:Concept-yksilöitä erillisessä luokituksessa (luonnos)."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://kela.fi/kg/saadostyyppi-luokitus> ;
            owl:onProperty skos:inScheme ],
        skos:Concept ;
    skos:definition "The kind of a statute according to its issuer and legal status."@en,
        "Säädöksen laji sen antajan ja oikeudellisen aseman mukaan."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "Statute Type"@en,
        "Säädöstyyppi"@fi,
        "Författningstyp"@sv .

kelao:containsArea a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "contains area"@en,
        "sisältää alueen"@fi ;
    rdfs:comment "A geographic area contains another geographic area. Inverse of 'is part of area'."@en,
        "Alue sisältää toisen maantieteellisen alueen. Käänteisominaisuus ominaisuudelle 'on osa aluetta'."@fi ;
    rdfs:domain kelao:Location ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Location ;
    skos:closeMatch schema:containsPlace ;
    skos:definition "Relation stating that an area contains another geographic area."@en,
        "Suhde, joka ilmaisee, että alue sisältää toisen maantieteellisen alueen."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "contains area"@en,
        "sisältää alueen"@fi .

kelao:hasEligibilityCriterion a owl:ObjectProperty ;
    rdfs:label "has eligibility criterion"@en,
        "kriteerinä"@fi ;
    rdfs:comment "The benefit has this eligibility criterion."@en,
        "Etuudella on tämä kelpoisuuskriteeri."@fi ;
    rdfs:domain kelao:Benefit ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:EligibilityCriterion ;
    skos:definition "Relation stating an eligibility criterion of a benefit."@en,
        "Suhde, joka ilmaisee etuuden myöntämisedellytyksen."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "has eligibility criterion"@en,
        "kriteerinä"@fi .

kelao:hasLocation a owl:ObjectProperty ;
    rdfs:label "is located in"@en,
        "sijaitsee alueella"@fi ;
    rdfs:comment "Ominaisuusketju hasLocation o isPartOfArea → hasLocation periyttää sijainnin aluehierarkiassa ylöspäin. Domain on unioni (palvelupiste, organisaatio); ei OWL 2 RL -yhteensopiva, tarkistettava 0.6:ssa."@fi ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kelao:Organisation kelao:ServiceUnit ) ] ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Location ;
    owl:propertyChainAxiom ( kelao:hasLocation kelao:isPartOfArea ) ;
    skos:definition "Relation stating the geographic area in which a service unit or organisation is located."@en,
        "Suhde, joka ilmaisee maantieteellisen alueen, jolla palvelupiste tai organisaatio sijaitsee."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "is located in"@en,
        "sijaitsee alueella"@fi .

kelao:hasServiceUnit a owl:ObjectProperty ;
    rdfs:label "has service unit"@en,
        "on palvelupiste"@fi ;
    rdfs:comment "Organisaatiolla on palvelupiste."@fi ;
    rdfs:domain kelao:Organisation ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:ServiceUnit ;
    skos:definition "Relation stating a service unit maintained by an organisation."@en,
        "Suhde, joka ilmaisee organisaation ylläpitämän palvelupisteen."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "has service unit"@en,
        "on palvelupiste"@fi .

kelao:isLifeSituationFor a owl:ObjectProperty ;
    rdfs:label "is life situation for"@en,
        "on elämäntilanne kohteelle"@fi ;
    rdfs:domain kelao:LifeSituation ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Benefit ;
    skos:definition "Relation stating a benefit to which a life situation is related."@en,
        "Suhde, joka ilmaisee etuuden, johon elämäntilanne liittyy."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "is life situation for"@en,
        "on elämäntilanne kohteelle"@fi .

kelao:isPartOfBenefit a owl:ObjectProperty ;
    rdfs:label "is part of benefit"@en,
        "on osa etuutta"@fi ;
    rdfs:domain kelao:BenefitComponent ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:StandaloneBenefit ;
    skos:definition "Relation stating the standalone benefit of which a benefit component is a part."@en,
        "Suhde, joka ilmaisee itsenäisen etuuden, jonka osa etuuden osa on."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "is part of benefit"@en,
        "on osa etuutta"@fi .

kelao:roleOfCustomer a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "role of customer"@en,
        "asiakkaan roolina"@fi ;
    rdfs:comment "The role (applicant, user or beneficiary) belongs to this customer. Functional: one role instance is attached to exactly one customer. The same person or household may hold several roles at the same time, e.g. as applicant, user and payee."@en,
        "Funktionaalinen: yksi rooli-instanssi kiinnittyy täsmälleen yhteen asiakkaaseen. Domain on unioni (hakija, käyttäjä, etuudensaaja); ei OWL 2 RL -yhteensopiva, tarkistettava 0.6:ssa. Sama henkilö tai ruokakunta voi esiintyä useassa roolissa samanaikaisesti, esimerkiksi hakijana, käyttäjänä ja maksunsaajana."@fi ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( kelao:Applicant kelao:Beneficiary kelao:User ) ] ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Customer ;
    skos:definition "Relation stating the customer to whom a role belongs."@en,
        "Suhde, joka ilmaisee asiakkaan, jolle rooli kuuluu."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "role of customer"@en,
        "asiakkaan roolina"@fi .

eli:date_document a owl:DatatypeProperty .

eli:has_part a owl:ObjectProperty .

eli:id_local a owl:DatatypeProperty .

eli:type_document a owl:ObjectProperty .

eli:version_date a owl:DatatypeProperty .

cpsv:PublicService a owl:Class .

schema:identifier a owl:DatatypeProperty .

kelao:Appeal a owl:Class ;
    rdfs:label "Appeal"@en,
        "Muutoksenhaku"@fi,
        "Ändringssökande"@sv ;
    dcterms:source kelaterm:c741,
        kelaterm:c744 ;
    rdfs:comment "Käytetään sekä oikaisuvaatimuksille että valituksille. Sanastossa muutoksenhaku (c736) on menettely; tämä luokka kuvaa siinä esitettyä vaatimusta."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf prov:Entity ;
    skos:altLabel "oikaisuvaatimus"@fi,
        "valitus"@fi ;
    skos:closeMatch kelaterm:c741,
        kelaterm:c744 ;
    skos:definition "A customer’s demand that a decision issued by an authority or an appeal body be changed, made either as a request for rectification or as an appeal."@en,
        "Asiakkaan vaatimus viranomaisen tai muutoksenhakuelimen antaman päätöksen muuttamisesta, joka tehdään joko oikaisuvaatimuksena tai valituksena."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "Appeal"@en,
        "Muutoksenhaku"@fi,
        "Ändringssökande"@sv ;
    skos:relatedMatch kelaterm:c736 .

kelao:BenefitComponent a owl:Class ;
    rdfs:label "Benefit Component"@en,
        "Etuuden osa"@fi ;
    dcterms:source "Kelan MOT-sanakirja"@fi ;
    rdfs:comment "Esimerkiksi opintotuen osia ovat opintoraha, asumislisä ja opintolainan valtiontakaus."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf kelao:Benefit ;
    owl:disjointWith kelao:StandaloneBenefit ;
    skos:altLabel "sub-benefit"@en,
        "etuusosa"@fi ;
    skos:definition "A separately handled part of a benefit that can be granted only if the benefit of which it is a part has also been granted."@en,
        "Etuuden erikseen käsiteltävä osa, joka voidaan myöntää vain, jos myös se etuus, jonka osa on kyseessä, on myönnetty."@fi ;
    skos:example "For example, the study grant, housing supplement and government guarantee for student loan are parts of the financial aid for students."@en,
        "Esimerkiksi opintotuessa etuuden osia ovat opintoraha, asumislisä ja opintolainan valtiontakaus; lesken- ja lapseneläkkeessä osia ovat perus- ja täydennysmäärät."@fi ;
    skos:prefLabel "Benefit Component"@en,
        "Etuuden osa"@fi .

kelao:Country a owl:Class ;
    rdfs:label "Country"@en,
        "Valtio"@fi,
        "Stat"@sv ;
    dcterms:source <https://termipankki.fi/tepa/fi/haku/valtio> ;
    rdfs:comment "Käytetään asumisedellytyksen ja rajat ylittävien tilanteiden (EU, ETA, Sveitsi, sosiaaliturvasopimusmaat) kuvaamiseen. Linkitetty schema:Country-luokkaan."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf kelao:Location ;
    skos:definition "A sovereign state in whose territory a person resides or works, or whose legislation applies to social security, or a political union that has sovereign legislative power over a defined geographic area."@en,
        "Itsenäinen valtio, jonka alueella henkilö asuu, työskentelee tai jonka lainsäädäntöä sosiaaliturvaan sovelletaan, tai poliittinen yhteenliittymä, jolla on suvereeni lainsäädäntövalta tietyllä maantieteellisellä alueella."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:exactMatch schema:Country ;
    skos:prefLabel "Country"@en,
        "Valtio"@fi,
        "Stat"@sv ;
    skos:scopeNote "Lähdeontologiassa kuvattu suoraan schema:Country-luokkana; ydinmallissa määritelty omana luokkana ja linkitetty skos:exactMatch-suhteella."@fi .

kelao:Customer a owl:Class ;
    rdfs:label "Customer"@en,
        "Asiakas"@fi,
        "Kund"@sv ;
    dcterms:source "Kelan asiakkuuden käsitemalli (sisäinen lähde)"@fi ;
    rdfs:comment "Customer: a person or party having a customer relationship with the social security administrator. The customer is the persistent identity to which contextual roles (applicant, user, beneficiary) are attached via the role-of-customer relation."@en,
        "Asiakas on pysyvä identiteetti, johon tilannekohtaiset roolit (hakija, käyttäjä, etuudensaaja) kiinnittyvät roolisuhteen kautta (kelao:hasCustomerRole)."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf prov:Agent ;
    skos:definition "A person or organisation that receives, or may receive, value from a service provided by Kela."@en,
        "Henkilö tai yhteisö, joka saa tai jolla on mahdollisuus saada arvoa Kelan tarjoamasta palvelusta."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "Customer"@en,
        "Asiakas"@fi,
        "Kund"@sv ;
    skos:scopeNote """Asiakkaat voivat olla ulkoisia tai sisäisiä. Asiakkaat voivat olla henkilöasiakkaita tai yhteisöasiakkaita. 
                Kelan asiakas saa joko suoraan tai välillisesti Kelan tarjoamaa palvelua, kuten esimerkiksi Kelan etuutta tai Kelan tuottamaa tietopalvelua. Yleiskielessä asiakkaalla tarkoitetaan toimijaa, joka hankkii tai saa palveluja tai hankkii tuotteita. 
                Tällainen toimija voi olla henkilö, henkilöryhmä tai organisaatio. Eepoksessa käytetään termiä "customer" puhuttaessa Kelan henkilöasiakkaista.
                """@fi .

kelao:EmploymentArea a owl:Class ;
    rdfs:label "Employment area"@en,
        "Työllisyysalue"@fi,
        "Sysselsättningsområde"@sv ;
    rdfs:comment "Employment area: a statutory area formed by municipalities responsible for organising public employment services (Finnish TE services reform 2025)."@en,
        "Perustuu lakiin työvoimapalveluiden järjestämisestä (380/2023); voimassa 1.1.2025 alkaen."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf kelao:Location ;
    skos:definition "An area formed by municipalities that is responsible for organising public employment services."@en,
        "Kuntien muodostama alue, joka vastaa julkisten työvoimapalvelujen järjestämisestä."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "Employment area"@en,
        "Työllisyysalue"@fi,
        "Sysselsättningsområde"@sv .

kelao:Income a owl:Class ;
    rdfs:label "Income"@en,
        "Tulo"@fi,
        "Inkomst"@sv ;
    rdfs:comment "Income: an income item of a person or recipient unit (e.g. wage, self-employment income, capital income, benefit income) that may be taken into account in means testing."@en,
        "Esimerkiksi palkka, yrittäjätulo, pääomatulo tai etuustulo. Vrt. sanaston käsitteet etuoikeutettu tulo (c72) ja etuusperusteinen tulo (c732)."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "An income item of a person or household that may be taken into account when calculating the amount of a benefit or in means testing."@en,
        "Henkilön tai ruokakunnan tuloerä, joka voidaan ottaa huomioon etuuden määrää laskettaessa tai tarveharkinnassa."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "Income"@en,
        "Tulo"@fi,
        "Inkomst"@sv ;
    skos:relatedMatch kelaterm:c72,
        kelaterm:c732 .

kelao:LifeSituation a owl:Class ;
    rdfs:label "Life Situation"@en,
        "Elämäntilanne"@fi,
        "Livssituation"@sv ;
    rdfs:comment "A life situation is a phase of change or circumstance in a citizen's life associated with a need for public services and benefits. Individual life situations form the life-situation classification (a skos:ConceptScheme)."@en,
        "Yksittäiset elämäntilanteet muodostavat elämäntilanneluokituksen (skos:ConceptScheme), jonka pohjana on DVV:n elämäntapahtumaluokitus."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://kela.fi/kg/ElamantilanneluokitusScheme> ;
            owl:onProperty skos:inScheme ],
        skos:Concept ;
    skos:definition "A phase or circumstance in a person’s life that involves a need for public services or benefits."@en,
        "Henkilön elämän vaihe tai tilanne, johon liittyy julkisten palvelujen tai etuuksien tarve."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "Life Situation"@en,
        "Elämäntilanne"@fi,
        "Livssituation"@sv .

kelao:Region a owl:Class ;
    rdfs:label "Region"@en,
        "Maakunta"@fi,
        "Landskap"@sv ;
    dcterms:source <https://stat.fi/meta/kas/maakunta.html> ;
    rdfs:comment "Suomessa 19 maakuntaa (2025). Rinnakkainen hierarkia hyvinvointialueiden kanssa: kunta kuuluu sekä maakuntaan että hyvinvointialueeseen."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf kelao:Location ;
    skos:definition "An area formed by municipalities that serves as the unit for regional development and regional land-use planning."@en,
        "Kuntien muodostama alue, joka toimii alueiden kehittämisen ja maakuntakaavoituksen yksikkönä."@fi ;
    skos:prefLabel "Region"@en,
        "Maakunta"@fi,
        "Landskap"@sv .

kelao:Service a owl:Class ;
    rdfs:label "Service"@en,
        "Palvelu"@fi,
        "Tjänst"@sv ;
    dcterms:source ptv: ;
    rdfs:comment "A social-security-related service, e.g. an application or advisory service."@en,
        "Sosiaaliturvaan liittyvä palvelu, esimerkiksi hakemus- tai neuvontapalvelu. Palvelu liitetään etuuteen (kelao:relatedService) ja on käytettävissä palvelukanavien kautta."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf cpsv:PublicService ;
    skos:definition "An activity by which a service provider meets a customer’s need."@en,
        "Toiminto, jolla palveluntuottaja vastaa asiakkaan tarpeeseen."@fi ;
    skos:exactMatch ptv:Service ;
    skos:prefLabel "Service"@en,
        "Palvelu"@fi,
        "Tjänst"@sv ;
    skos:scopeNote "In the core model a service is linked to a benefit (kelao:relatedService) and is accessible through service channels (kelao:hasServiceChannel). Service channels (kelao:ServiceChannel) and service units (kelao:ServiceUnit) are part of the core model; broader PTV metadata (e.g. funding type, service classification, target groups) remains outside it."@en,
        "Ydinmallissa palvelu liitetään etuuteen (kelao:relatedService) ja se on käytettävissä palvelukanavien kautta (kelao:hasServiceChannel). Palvelukanava (kelao:ServiceChannel) ja palvelupiste (kelao:ServiceUnit) kuuluvat ydinmalliin; laajempi PTV-metatieto (esim. rahoitustyyppi, palveluluokitus, kohderyhmät) jää edelleen ydinmallin ulkopuolelle."@fi .

kelao:ServiceChannel a owl:Class ;
    rdfs:label "Service Channel"@en,
        "Palvelukanava"@fi,
        "Servicekanal"@sv ;
    dcterms:source ptv: ;
    rdfs:comment "A service channel: the way a customer accesses a service, e.g. e-service, web page, printable form, telephone service or a physical service point. A single service may have several alternative or sequential channels."@en,
        "Esimerkiksi verkkoasiointi, puhelinpalvelu, tulostettava lomake tai palvelupiste. Linkitetty PTV:n ServiceChannel-käsitteeseen skos:closeMatch-suhteella."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    skos:closeMatch ptv:ServiceChannel ;
    skos:definition "The way in which a customer accesses a service."@en,
        "Tapa, jolla asiakas saa palvelun käyttöönsä."@fi ;
    skos:prefLabel "Service Channel"@en,
        "Palvelukanava"@fi,
        "Servicekanal"@sv ;
    skos:relatedMatch kelaterm:c860 ;
    skos:scopeNote "Linkitetty PTV:n ServiceChannel-käsitteeseen vain skos:closeMatch-suhteella, koska ptv: on epävakaa nimiavaruus."@fi .

kelao:WellbeingServiceCounty a owl:Class ;
    rdfs:label "Wellbeing Service County"@en,
        "Hyvinvointialue"@fi,
        "Välfärdsområde"@sv ;
    dcterms:source <https://valter.sanakirja.fi/all/all/hyvinvointialue> ;
    rdfs:comment "21 hyvinvointialuetta sekä Helsingin kaupunki, joka hoitaa hyvinvointialueen tehtävät. Kunta kuuluu täsmälleen yhteen hyvinvointialueeseen."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf kelao:Location ;
    skos:definition "A public-law entity with self-government in its territory that is responsible for organising health, social and rescue services."@en,
        "Julkisoikeudellinen yhteisö, jolla on alueellaan itsehallinto ja joka vastaa sosiaali- ja terveydenhuollon sekä pelastustoimen järjestämisestä."@fi ;
    skos:prefLabel "Wellbeing Service County"@en,
        "Hyvinvointialue"@fi,
        "Välfärdsområde"@sv .

<https://www.kela.fi/> a foaf:Organization ;
    rdfs:label "Social Insurance Institution of Finland"@en,
        "Kela"@fi .

eli:LegalResource a owl:Class .

skos:inScheme a owl:ObjectProperty .

kelao:Beneficiary a owl:Class ;
    rdfs:label "Beneficiary"@en,
        "Etuuden saaja"@fi,
        "Förmånstagare"@sv ;
    dcterms:source kelaterm:c75 ;
    rdfs:comment "Beneficiary: recipient of a benefit. Distinguished from the applicant: e.g. child benefit is applied for by a guardian, and the payment recipient may be a different party."@en,
        "Erotetaan hakijasta ja maksunsaajasta: esimerkiksi lapsilisän hakija on huoltaja, ja maksunsaaja voi olla eri taho (esim. kunta tai vuokranantaja)."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf prov:Agent ;
    skos:definition "A person or organisation that receives a benefit."@en,
        "Henkilö tai organisaatio, joka saa etuutta."@fi,
        "Person eller organisation som får en förmån."@sv ;
    skos:exactMatch kelaterm:c75 ;
    skos:prefLabel "Beneficiary"@en,
        "Etuuden saaja"@fi,
        "Förmånstagare"@sv .

kelao:Decision a owl:Class ;
    rdfs:label "Decision"@en,
        "Päätös"@fi,
        "Beslut"@sv ;
    dcterms:source kelaterm:c78 ;
    rdfs:comment "Päätös etuutta koskevan asian ratkaisemisesta. Etuuspäätös voi olla myönteinen tai kielteinen ja koskea esimerkiksi etuuden myöntämistä, hylkäämistä, tarkistamista, keskeyttämistä, lakkauttamista, maksamista tai takaisinperintää."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf prov:Entity ;
    skos:altLabel "etuuspäätös"@fi,
        "beslut om förmån"@sv,
        "förmånsbeslut"@sv ;
    skos:definition "A decision resolving a matter concerning a benefit."@en,
        "Päätös etuutta koskevan asian ratkaisemisesta."@fi,
        "Beslut om avgörande av ett ärende som gäller en förmån."@sv ;
    skos:exactMatch kelaterm:c78 ;
    skos:prefLabel "Decision"@en,
        "Päätös"@fi,
        "Beslut"@sv .

kelao:EligibilityCriterion a owl:Class ;
    rdfs:label "Eligibility criterion"@en,
        "Etuuskriteeri"@fi ;
    rdfs:comment "Eligibility criterion: an individual condition affecting entitlement to a benefit (e.g. age limit, residence requirement, income limit, employment condition). Reified so that each criterion can carry its own legal basis and parameters."@en,
        "Esimerkiksi ikäraja, asumisedellytys, tuloraja tai työssäoloehto. Mallinnettu omana luokkana, jotta kriteeri voi kantaa oman oikeusperustansa ja parametrinsa."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf prov:Entity ;
    skos:altLabel "etuusehto"@fi,
        "etuusperuste"@fi ;
    skos:closeMatch cv:Criterion ;
    skos:definition "A condition for granting a benefit whose fulfilment affects entitlement to the benefit or its amount."@en,
        "Etuuden myöntämisedellytys, jonka täyttyminen vaikuttaa oikeuteen saada etuus tai etuuden määrään."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "Eligibility criterion"@en,
        "Etuuskriteeri"@fi .

kelao:ServiceUnit a owl:Class ;
    rdfs:label "Service Unit"@en,
        "Palvelupiste"@fi,
        "Serviceställe"@sv ;
    dcterms:source kelaterm:c862 ;
    rdfs:comment "A service unit (service point) with a physical location. Service unit data has been combined from Kela's internal sources and PTV service-channel data (entity matching)."@en,
        "Palvelukanavan erikoistapaus, jolla on fyysinen sijainti. Kelan palvelupisteissä työskentelee Kelan palveluasiantuntijoita."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf kelao:ServiceChannel ;
    skos:altLabel "Palveluyksikkö"@fi ;
    skos:closeMatch ptv:ServiceChannel ;
    skos:definition "A physical service point maintained, as a rule, by one actor where services of that actor or other actors are available."@en,
        "Toimipiste, jota ylläpitää pääsääntöisesti yksi toimija ja jossa voi saada kyseisen toimijan tai muiden toimijoiden tarjoamia palveluja."@fi,
        "Verksamhetsställe, som i regel har en aktör som huvudman och där aktören i fråga erbjuder tjänster."@sv ;
    skos:exactMatch kelaterm:c862 ;
    skos:prefLabel "Service Unit"@en,
        "Palvelupiste"@fi,
        "Serviceställe"@sv ;
    skos:scopeNote "Palvelupiste on palvelukanavan erikoistapaus, siksi rdfs:subClassOf kelao:ServiceChannel."@fi .

kelao:StandaloneBenefit a owl:Class ;
    rdfs:label "Standalone Benefit"@en,
        "Itsenäinen etuus"@fi ;
    rdfs:comment "Huom. termi \"itsenäinen etuus\" tarkoittaa sanastossa ja EU-asetuksessa 883/2004 eri asiaa (itsenäinen eläke, c535). Nimeäminen tarkistettava versiossa 0.6."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf kelao:Benefit ;
    skos:definition "A benefit that can be granted on its own and may consist of benefit components."@en,
        "Etuus, joka voidaan myöntää sellaisenaan ja joka voi koostua etuuden osista."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "Standalone Benefit"@en,
        "Itsenäinen etuus"@fi .

kelao:User a owl:Class ;
    rdfs:label "User"@en,
        "Käyttäjä"@fi,
        "Användare"@sv ;
    rdfs:comment "Application user, user."@en,
        "Käyttäjä on asiakkaan rooli (kelao:hasCustomerRole). Erotetaan hakijasta: käyttäjä voi selvittää oikeuttaan etuuteen jättämättä hakemusta."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf prov:Agent ;
    skos:definition "A person who uses an electronic transaction or information service of social security."@en,
        "Henkilö, joka käyttää sosiaaliturvan sähköistä asiointi- tai tietopalvelua."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "User"@en,
        "Käyttäjä"@fi,
        "Användare"@sv ;
    skos:relatedMatch kelaterm:c859 .

skos:Concept a owl:Class .

kelao:Application a owl:Class ;
    rdfs:label "Application"@en,
        "Hakemus"@fi,
        "Ansökan"@sv ;
    dcterms:source kelaterm:c77 ;
    rdfs:comment "Hakemuksen vireilletulo käynnistää asian käsittelyn. Käsitteellinen luokka: tietämysgraafi ei sisällä hakijakohtaisia hakemuksia."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf prov:Entity ;
    skos:altLabel "Etuushakemus"@fi,
        "Ansökan om förmån"@sv,
        "Förmånsansökan"@sv ;
    skos:definition "A document by which a benefit applicant requests, or a request is made on their behalf and with their consent, to receive a benefit."@en,
        "Asiakirja, jolla etuudenhakija esittää pyynnön tai hänen puolestaan ja hänen suostumuksellaan esitetään pyyntö saada jotain etuutta."@fi,
        "Dokument med vilket en förmånssökande anhåller om en förmån eller det på den förmånssökandes vägnar och med hens samtycke anhålls om en förmån."@sv ;
    skos:exactMatch kelaterm:c77 ;
    skos:prefLabel "Application"@en,
        "Hakemus"@fi,
        "Ansökan"@sv ;
    skos:scopeNote "Conceptual class only. The KELAO knowledge graph does not contain applicant-level instances — personal data is processed in Kela's operational systems."@en,
        "Käsitteellinen luokka. KELAO-tietämysgraafi ei sisällä hakijakohtaisia instansseja — henkilötiedot käsitellään Kelan operatiivisissa järjestelmissä."@fi .

kelao:Payment a owl:Class ;
    rdfs:label "Payment"@en,
        "Maksu"@fi,
        "Betalning"@sv ;
    dcterms:source "Kelan MOT-sanasto"@fi ;
    rdfs:comment "Payment or instalment: a benefit disbursement made on the basis of a decision. Links the decision, benefit and recipient to the money flow. A payment based on the payment data generated by the benefit decision."@en,
        "Kytkee päätöksen, etuuden ja maksunsaajan rahavirtaan. Maksunsaaja ei aina ole sama kuin etuudensaaja (sanasto c76). Maksu, joka perustuu etuuspäätöksessä syntyviin maksutietoihin."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A benefit disbursement, or an instalment of it, paid to the payee on the basis of a benefit decision."@en,
        "Etuuspäätöksen perusteella maksunsaajalle maksettu etuussuoritus tai sen maksuerä."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "Payment"@en,
        "Maksu"@fi,
        "Betalning"@sv ;
    skos:relatedMatch kelaterm:c76 .

kelao:Applicant a owl:Class ;
    rdfs:label "Applicant"@en,
        "Hakija"@fi,
        "Sökande"@sv ;
    dcterms:source kelaterm:c74 ;
    rdfs:comment "Hakija on asiakkaan prosessirooli (ks. kelao:hasCustomerRole). kelao:User on sovelluksen käyttäjä; sama henkilö voi olla molempia."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf prov:Agent ;
    skos:altLabel "Etuudenhakija"@fi,
        "Förmånssökande"@sv ;
    skos:definition "A person or organisation that applies for a benefit."@en,
        "Henkilö tai organisaatio, joka hakee etuutta."@fi,
        "Person eller organisation som söker en förmån."@sv ;
    skos:exactMatch kelaterm:c74 ;
    skos:prefLabel "Applicant"@en,
        "Hakija"@fi,
        "Sökande"@sv ;
    skos:scopeNote "Hakija on prosessirooli. kelao:User on sovelluksen käyttäjä; sama henkilö voi olla molempia."@fi .

kelao:Municipality a owl:Class ;
    rdfs:label "Municipality"@en,
        "Kunta"@fi,
        "Kommun"@sv ;
    dcterms:source <https://valter.sanakirja.fi/all/all/kunta> ;
    rdfs:comment "Suomen kunnat tunnistetaan kolminumeroisella kuntakoodilla. Kunta kuuluu maakuntaan ja hyvinvointialueeseen."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf kelao:Location ;
    skos:definition "A local self-governing unit that performs the tasks belonging to its residents’ self-government and those laid down by law."@en,
        "Alueellinen itsehallintoyksikkö, joka hoitaa asukkaidensa itsehallintoon kuuluvat ja laissa säädetyt tehtävät."@fi ;
    skos:prefLabel "Municipality"@en,
        "Kunta"@fi,
        "Kommun"@sv ;
    skos:scopeNote "Suomen kunnat, Suomi.fi URI:t."@fi .

kelao:Organisation a owl:Class ;
    rdfs:label "Organization"@en,
        "Organisaatio"@fi,
        "Organisation"@sv ;
    dcterms:source ptv: ;
    rdfs:comment "Kattaa julkisen, yksityisen ja kolmannen sektorin toimijat. Vastaa PTV:n ja schema.orgin Organization-käsitettä; EU Core Public Organisation on erikoistapaus."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf org:Organization ;
    skos:broadMatch cv:PublicOrganisation ;
    skos:closeMatch foaf:Organization ;
    skos:definition "An association of persons with a common goal and an appropriate structure."@en,
        "Henkilöiden muodostama yhteenliittymä, jolla on yhteinen tavoite ja tarkoituksenmukainen rakenne."@fi ;
    skos:exactMatch ptv:Organization,
        schema:Organization ;
    skos:prefLabel "Organization"@en,
        "Organisaatio"@fi,
        "Organisation"@sv ;
    skos:scopeNote """KELAO-kontekstissa vastaa PTV:n Organization-käsitettä ja 
        schema.org/Organization-käsitettä. Käytetään kuvaamaan kaikkia 
         toimijaorganisaatioita sektorirajat ylittäen (julkinen, yksityinen, 
         kolmas sektori). EU Core Public Organisation on tämän erikoistapaus."""@fi .

kelao:isPartOfArea a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is part of area"@en,
        "on osa aluetta"@fi ;
    rdfs:comment "A geographic area is part of another geographic area. Transitive generic property; specific administrative containment relations are its subproperties."@en,
        "Alue on osa toista maantieteellistä aluetta. Transitiivinen yleisominaisuus, jonka aliominaisuuksia hallinnolliset kuulumissuhteet (kunta-hyvinvointialue, kunta-maakunta, alue-valtio) ovat."@fi ;
    rdfs:domain kelao:Location ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:range kelao:Location ;
    owl:inverseOf kelao:containsArea ;
    skos:closeMatch schema:containedInPlace,
        <http://www.geonames.org/ontology#parentFeature> ;
    skos:definition "Relation stating that an area is part of another geographic area."@en,
        "Suhde, joka ilmaisee, että alue on osa toista maantieteellistä aluetta."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "is part of area"@en,
        "on osa aluetta"@fi .

prov:Agent a owl:Class .

kelao:LegalResource a owl:Class ;
    rdfs:label "Legal Resource"@en,
        "Säädös"@fi,
        "Juridisk resurs"@sv ;
    dcterms:source eli:LegalResource ;
    rdfs:comment "A work in a legislative corpus. This applies to acts that have been legally enacted (whether or not they are still in force). A legal resource can represent a legal act or any component of a legal act, like an article. Legal resources can be linked together using properties defined in the model."@en,
        "Vastaa ELI-ontologian LegalResource-luokkaa. Kattaa lait, asetukset ja EU-säädökset riippumatta siitä, ovatko ne voimassa. Säädöksen osat kuvataan luokalla kelao:LegalResourcePart."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:subClassOf eli:LegalResource ;
    skos:definition "A statute issued by a public authority and intended to be generally binding, or a version of it."@en,
        "Julkisen vallan antama, yleisesti noudatettavaksi tarkoitettu säädös tai sen versio."@fi ;
    skos:exactMatch schema:Legislation ;
    skos:example "Examples of statutes are acts and decrees as well as legal provisions issued by authorities."@en,
        "Säädöksiä ovat esimerkiksi lait ja asetukset sekä viranomaisten antamat oikeussäännöt."@fi ;
    skos:prefLabel "Legal Resource"@en,
        "Säädös"@fi,
        "Juridisk resurs"@sv .

xsd:date a rdfs:Datatype .

prov:Entity a owl:Class .

kelao:Location a owl:Class ;
    rdfs:label "Location"@en,
        "Sijainti"@fi,
        "Plats"@sv ;
    dcterms:source <https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.1/> ;
    rdfs:comment "A geographic area used e.g. to describe a place of residence, a service operating area, or the location of a service unit. Superclass for municipalities, wellbeing service counties, regions and countries."@en,
        "Yliluokka kunnille, hyvinvointialueille, maakunnille, työllisyysalueille ja valtioille. Linkitetty W3C Location Core -sanastoon (locn:Location)."@fi ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    skos:altLabel "Geographic Area"@en,
        "Place"@en,
        "Maantieteellinen alue"@fi ;
    skos:closeMatch locn:Location ;
    skos:definition "A geographic area regardless of its size or administrative level."@en,
        "Maantieteellinen alue koosta tai hallinnollisesta tasosta riippumatta."@fi ;
    skos:editorialNote "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en,
        "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ;
    skos:prefLabel "Location"@en,
        "Sijainti"@fi,
        "Plats"@sv ;
    skos:scopeNote "Ydinmallissa nimi on harmonisoitu Location-muotoon ja linkitetty W3C Location Core -sanastoon (locn:Location)."@fi .

kelao:Benefit a owl:Class ;
    rdfs:label "Benefit"@en,
        "Etuus"@fi,
        "Förmån"@sv ;
    dcterms:source kelaterm:c60,
        <https://iri.suomi.fi/terminology/verotus/c66> ;
    rdfs:comment "A social security benefit or allowance. General class — use subclasses for instances."@en,
        "Yleinen luokka. Kelan etuudet ovat sosiaalietuuksia; joskus käytetään myös termiä sosiaaliturvaetuus. Etuus ei aina ole rahamääräinen, mutta sen rahallinen arvo on laskettavissa."@fi,
        "FPA:s förmåner är sociala förmåner. Ibland används också termen socialförsäkringsförmåner."@sv ;
    rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
    rdfs:seeAlso <https://iri.suomi.fi/terminology/verotus/c66> ;
    rdfs:subClassOf cpsv:PublicService ;
    skos:altLabel "Social benefit"@en,
        "Sosiaalietuus"@fi,
        "Tuki"@fi ;
    skos:definition "A good whose economic value can be determined and which is granted on the basis of the recipient’s status or life situation according to predefined criteria."@en,
        "Taloudelliselta arvoltaan määriteltävissä oleva hyödyke, joka myönnetään saajan aseman tai elämäntilanteen perusteella ennalta määritellyin perustein."@fi,
        "Nyttighet vars ekonomiska värde kan fastställas och som beviljas utgående från mottagarens ställning eller livssituation på grunder som fastställts i förväg."@sv ;
    skos:exactMatch kelaterm:c60 ;
    skos:note "Verotuksen sanaston määritelmä: suoritus, joka maksetaan saajan aseman tai elämäntilanteen perusteella ennalta määritellyin perustein (https://iri.suomi.fi/terminology/verotus/c66)."@fi ;
    skos:prefLabel "Benefit"@en,
        "Etuus"@fi,
        "Förmån"@sv .

<https://kela.fi/ontology/kelao> a owl:Ontology ;
    rdfs:label "Finnish Social Security Core Ontology"@en,
        "Sosiaaliturvan ydinontologia"@fi ;
    dcterms:abstract "The Finnish Social Security Core Ontology (kelao) describes the core concepts of the Finnish social security system and the relationships between them in a machine-interpretable form: benefits and their components, eligibility criteria, the application and decision process, payments and recovery, appeals, customer roles, services and service channels, the administrative area hierarchy, and the underlying legislation. The ontology complements Kela's terminological vocabulary: the vocabulary defines concepts for human readers, while the ontology makes the relationships, constraints and inference rules between concepts machine-checkable and queryable."@en,
        "Sosiaaliturvan ydinontologia (kelao) kuvaa Suomen sosiaaliturvajärjestelmän keskeiset käsitteet ja niiden väliset suhteet koneellisesti tulkittavassa muodossa: etuudet ja niiden osat, myöntämisedellytykset, hakemus- ja päätösprosessin, maksut ja takaisinperinnän, muutoksenhaun, asiakkaan roolit, palvelut ja palvelukanavat, hallinnollisen aluehierarkian sekä säädöspohjan. Ontologia täydentää Kelan terminologista sanastoa: sanasto määrittelee käsitteet ihmislukijalle, ontologia tekee käsitteiden väliset suhteet, rajoitteet ja päättelysäännöt koneellisesti tarkistettaviksi ja kyselytäviksi."@fi ;
    dcterms:contributor <https://www.linkedin.com/in/petri-roponen-052aa772> ;
    dcterms:created "2026-06-08"^^xsd:date ;
    dcterms:creator "Petri Roponen" ;
    dcterms:description "A core ontology providing the structured semantics that knowledge graphs, AI agents and information systems need for social security concepts."@en,
        "Ydinontologia, joka tarjoaa tietämysgraafien, tekoälyagenttien ja tietojärjestelmien tarvitseman rakenteisen semantiikan sosiaaliturvan käsitteille."@fi ;
    dcterms:identifier "https://kela.fi/ontology/kelao/0.5.2" ;
    dcterms:language "en",
        "fi",
        "sv" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-09-20"^^xsd:date ;
    dcterms:publisher <https://www.kela.fi/> ;
    dcterms:rightsHolder <https://www.kela.fi/> ;
    dcterms:subject "public administration"@en,
        "social security"@en,
        "julkishallinto"@fi,
        "sosiaaliturva"@fi ;
    dcterms:title "Finnish Social Security Core Ontology"@en,
        "Sosiaaliturvan ydinontologia"@fi ;
    vann:preferredNamespacePrefix "kelao" ;
    vann:preferredNamespaceUri "https://kela.fi/ontology/kelao#"^^xsd:anyURI ;
    rdfs:comment "The core version contains only the central social security concepts (benefits, eligibility, life situations, legislation, customership, services, areas). Extensions (e.g. data products) are deliberately kept outside the core ontology. Reuses external vocabularies and ontologies: PROV-O, ELI, CPSV, PTV (Finnish Service Catalogue), schema.org, WGS84 Geo, W3C Locn, W3C Org, SHACL, and Kela's terminological vocabulary (v7.1)."@en,
        "Ydinversio sisältää vain sosiaaliturvan keskeiset käsitteet (etuudet, kelpoisuus, elämäntilanteet, säädökset, asiakkuus, palvelut, alueet). Laajennukset (esim. tietotuotteet) on tarkoituksella rajattu ydinontologian ulkopuolelle. Hyödyntää ulkoisia sanastoja ja ontologioita: PROV-O, ELI, CPSV, PTV (Suomi.fi-palvelutietovaranto), schema.org, WGS84 Geo, W3C Locn, W3C Org, SHACL sekä Kelan terminologinen sanasto (v7.1)."@fi ;
    rdfs:seeAlso eli:,
        cv:,
        ptv:,
        dcterms:,
        cpsv:,
        schema:,
        geo:,
        locn:,
        org:,
        prov:,
        sh:,
        kelaterm: ;
    owl:priorVersion <https://kela.fi/ontology/kelao/0.5.1> ;
    owl:versionIRI <https://petriroponen.github.io/kelao-ontology-docs/index-fi.html> ;
    owl:versionInfo "0.5.2-core-draft" ;
    skos:changeNote """Version 0.4.0 (2026-07-03):
(1) Geographic hierarchy: added the transitive generic property isPartOfArea
with inverse containsArea, and its subproperties belongsToRegion,
belongsToCountry and belongsToEmploymentArea. The existing property
belongsToWellbeingServiceCounty was linked into the same hierarchy as a
subproperty. Added class EmploymentArea. Added the property chain
hasLocation o isPartOfArea -> hasLocation, so that location propagates
upwards through the area hierarchy. The domain of hasLocation was widened
to cover both service units and organisations (union).
(2) Social security core concepts: added classes EligibilityCriterion
(with legal-basis reference), Customer with role relations (roleOfCustomer,
hasCustomerRole; applicant, user and beneficiary as customer roles),
Beneficiary, Payment, Recovery, AppealBody and Income, with their properties.
"""@en,
        """Version 0.5.0 (2026-09-19):
Definition round. (1) Every class and property now has skos:definition@fi and @en in the form "<genus>, which <differentia>". Definitions of Appeal, AppealBody, Applicant, Application, Beneficiary, Benefit, Decision and ServiceUnit are taken from the Kela terminological vocabulary (v7.1) with dcterms:source pointing to the concept IRI; the properties inhibiting, reducing, paymentRecipient, meansTest, municipalityGroup, residenceRequired, requiresEmploymentHistory, validFrom and validTo are likewise derived from it. Definitions based on external sources (ELI, PTV, Finnish acts) are marked the same way. (2) Definitions without an authoritative source carry a skos:editorialNote flagging them for review with terminology experts in version 0.6. (3) Annotation practice unified: skos:definition = definition, rdfs:comment = short usage note; comments merely repeating the label were removed. (4) Vocabulary mappings: skos:exactMatch for classes; property-level skos:exactMatch links to concepts changed to skos:relatedMatch. (5) The taxation vocabulary definition moved from Benefit's definition to a skos:note. (6) relationshipAbbreviation literals typed xsd:string. (7) Versioning metadata updated. No structural changes were made; pruning candidates and modelling issues are collected in a separate definition workbook for version 0.6."""@en,
        """Version 0.5.1 (2026-09-20):
Review round based on the definition workbook. (1) Corrected definitions, sources or comments: Attachment, BenefitComponent, BenefitGroup, Country, Decision, EligibilityCriterion (added synonyms), EmploymentArea (unreliable legal-act source removed), Location, Municipality, Payment, Region, WellbeingServiceCounty; roleOfCustomer comment clarified; processingTime comment resolved into a definitive text. (2) rdfs:domain added to 40 datatype properties, and schema:domainIncludes (non-restrictive, multi-class) added to amount, postOffice, postalCode and uuid, implementing the workbook's pruning-group review (Huomio #6). (3) All pruning candidates rejected in the review (Päätös = hylkää) were removed outright rather than deprecated: the DataProduct group (G2) in full -- class DataProduct, object properties dataProductOwner and referenceToBenefit, and datatype properties additionalInformation, dataProductId, dataProductKeywords, dataProductType, fileFormat, reportCollection and responsibleParty -- together with nine further candidates from groups G1 and G3 (areaType, employmentAreaCode, employmentAreaName, geonamesId, municipalityCode, officeNumber, wellbeingServiceCountyCode, wellbeingServiceCountyName, wikidataId) and the overlapping processingTimeBusinessDays. All removed terms are recorded, with their reason for removal, on the "Poistetut" sheet of the version 0.6 definition workbook. (4) latitude and longitude were confirmed (not pruned) and re-sourced to the SEMIC Core Location Vocabulary."""@en,
        """Version 0.5.2 (2026-09-20):
Ontology-level metadata cleanup, corrected in two rounds after review by the ontology owner. (1) dcterms:abstract and dcterms:description each now carry exactly one value per language, instead of a mix of an actual description and an unrelated "draft version" notice crammed into dcterms:description; draft status is already signalled by the "-core-draft" suffix in owl:versionInfo. (2) Removed the ontology-level dcterms:source pointing at the whole kelaterm: vocabulary namespace: only a subset of terms are actually sourced from it, and that is already recorded individually on each such term. (3) Added dcterms:publisher, dcterms:rightsHolder (Kela), dcterms:identifier, dcterms:language and dcterms:subject, all previously absent. (4) rdfs:seeAlso was restored to its original list of bare reused-vocabulary namespace URIs (eli:, cv:, ptv:, dcterms:, cpsv:, schema:, geo:, locn:, org:, prov:, sh:, kelaterm:) after an unauthorised edit had replaced it with documentation links only; this is the corrected, owner-approved value. (5) The rdfs:domain (40 properties) and schema:domainIncludes (4 properties: amount, postOffice, postalCode, uuid) additions made in version 0.5.1 -- implementing a Huomiot-sheet recommendation that was applied without the ontology owner's prior confirmation -- have been reverted at the owner's explicit request. No datatype property in this version carries an rdfs:domain or schema:domainIncludes annotation, matching the state before 0.5.1. The now-unused schema:domainIncludes annotation-property stub declaration was removed accordingly."""@en,
        """Versio 0.4.0 (2026-07-03):
(1) Aluehierarkia: lisätty transitiivinen yleisominaisuus 'on osa aluetta' (isPartOfArea)
käänteisominaisuuksineen (containsArea) sekä sen aliominaisuudet kuuluu maakuntaan
(belongsToRegion), kuuluu valtioon (belongsToCountry) ja kuuluu työllisyysalueeseen
(belongsToEmploymentArea). Olemassa oleva kuuluu hyvinvointialueeseen
(belongsToWellbeingServiceCounty) kytketty saman hierarkian aliominaisuudeksi.
Lisätty luokka Työllisyysalue (EmploymentArea). Lisätty ominaisuusketju
hasLocation o isPartOfArea -> hasLocation, jolloin sijainti periytyy
aluehierarkiassa ylöspäin. hasLocation-ominaisuuden domain laajennettu
kattamaan palvelupisteen lisäksi organisaation (unioni).
(2) Sosiaaliturvan ydinkäsitteet: lisätty luokat Etuuskriteeri (EligibilityCriterion)
oikeusperustaviittauksineen, Asiakas (Customer) roolisuhteineen (roleOfCustomer,
hasCustomerRole; hakija, käyttäjä ja saaja asiakkaan rooleina), Etuuden saaja
(Beneficiary), Maksu (Payment), Takaisinperintä (Recovery), Muutoksenhakuelin
(AppealBody) ja Tulo (Income) ominaisuuksineen.
"""@fi,
        """Versio 0.4.1 (2026-07-05):
Korjauksia. (1) Määrittelemättömät yläluokat kelao:Agent ja kelao:Entity
korvattu prov:Agent- ja prov:Entity-luokilla luokissa Customer, Beneficiary,
EligibilityCriterion, Income, Payment ja Recovery sekä ominaisuuksien
hasIncome (domain) ja paymentRecipient (range) osalta; luokkahierarkia on
nyt yhtenäinen. (2) Poistettu ominaisuuden kelao:alternative päällekkäinen
owl:DatatypeProperty-deklaraatio (säilytetty owl:AnnotationProperty).
(3) Erotettu minimumAge- ja maximumAge-ominaisuuksien ruotsinkieliset
merkinnät (nedre/övre åldersgräns). (4) Ominaisuuden kelao:amount range
muutettu xsd:string -> xsd:decimal. (5) Lisätty owl:AllDisjointClasses
-aksioomat aluetyypeille ja asiakasrooleille. (6) Versiointimetatiedot
korjattu (versionIRI, priorVersion IRI-muotoon). (7) Lisätty
skos:ConceptScheme-kytkentä luokille BenefitGroup, StatuteType ja
LifeSituation (owl:hasValue skos:inScheme) todellisiin luokitusdatan
kaavioihin. (8) Luokka LifeSituationClassification nimetty uudelleen
LifeSituationiksi: käsite on yksittäinen elämäntilanne, ja luokitus on
skos:ConceptScheme. Ominaisuuksien isLifeSituationFor (domain) ja
relatedToLifeSituation (range) viittaukset päivitetty."""@fi,
        """Versio 0.5.0 (2026-09-19):
Määritelmäkierros. (1) Jokaisella luokalla ja ominaisuudella on skos:definition@fi ja @en; määritelmät noudattavat muotoa "<yläkäsite>, joka <erottava piirre>". Luokkien Appeal, AppealBody, Applicant, Application, Beneficiary, Benefit, Decision ja ServiceUnit määritelmät on otettu Kelan terminologisesta sanastosta (v7.1) ja lähde merkitty dcterms:source-viittauksella käsitteen IRI:in; sanastosta johdettuja ovat lisäksi ominaisuudet inhibiting, reducing, paymentRecipient, meansTest, municipalityGroup, residenceRequired, requiresEmploymentHistory, validFrom ja validTo. Ulkoisiin lähteisiin (ELI, PTV, kuntalaki, laki hyvinvointialueesta, laki alueiden kehittämisestä, laki työvoimapalveluiden järjestämisestä) perustuvat määritelmät on merkitty samoin. (2) Määritelmät, joilla ei ole virallista lähdettä, on merkitty skos:editorialNote-huomautuksella tarkistettaviksi käsiteasiantuntijoiden kanssa versiossa 0.6. (3) Annotaatiokäytäntö yhtenäistetty: skos:definition = määritelmä, rdfs:comment = lyhyt käyttöohje; labelia toistaneet kommentit poistettu. (4) Sanastolinkitykset: luokille skos:exactMatch (AppealBody c748, Beneficiary c75, Decision c78, ServiceUnit c862; Appeal skos:closeMatch c741 ja c744); ominaisuuksien skos:exactMatch-linkit käsitteisiin muutettu skos:relatedMatch-suhteiksi, koska ominaisuus ja käsite eivät ole sama asia. (5) Benefit-luokan määritelmästä siirretty verotuksen sanaston määritelmä skos:note-huomautukseksi. (6) relationshipAbbreviation-literaalit tyypitetty xsd:string. (7) Versiointimetatiedot päivitetty. Rakenteellisia muutoksia (luokkien, ominaisuuksien, domainien tai rangejen lisäyksiä tai poistoja) ei tehty; karsintaehdokkaat ja mallinnushavainnot on koottu erilliseen määritelmätyökirjaan versiota 0.6 varten."""@fi,
        """Versio 0.5.1 (2026-09-20):
Määritelmätyökirjan katselmointikierros. (1) Korjattu määritelmiä, lähteitä tai kommentteja: Attachment, BenefitComponent, BenefitGroup, Country, Decision, EligibilityCriterion (lisätty synonyymit), EmploymentArea (epäluotettava lakiviittauslähde poistettu), Location, Municipality, Payment, Region, WellbeingServiceCounty; roleOfCustomer-kommenttia täydennetty; processingTime-kommentti korvattu lopullisella tekstillä. (2) rdfs:domain lisätty 40 datatyyppiominaisuudelle, ja ei-rajoittava, useamman luokan schema:domainIncludes ominaisuuksille amount, postOffice, postalCode ja uuid; toteuttaa määritelmätyökirjan karsintaryhmien katselmoinnin (Huomio #6). (3) Kaikki katselmoinnissa hylätyt karsintaehdokkaat (Päätös = hylkää) poistettiin suoraan vanhentamisen sijaan: karsintaryhmä G2 kokonaisuudessaan -- luokka DataProduct, objektiominaisuudet dataProductOwner ja referenceToBenefit sekä datatyyppiominaisuudet additionalInformation, dataProductId, dataProductKeywords, dataProductType, fileFormat, reportCollection ja responsibleParty -- sekä yhdeksän muuta karsintaryhmien G1 ja G3 ehdokasta (areaType, employmentAreaCode, employmentAreaName, geonamesId, municipalityCode, officeNumber, wellbeingServiceCountyCode, wellbeingServiceCountyName, wikidataId) ja päällekkäinen processingTimeBusinessDays. Kaikki poistetut termit ja niiden poiston syy on kirjattu version 0.6 määritelmätyökirjan "Poistetut"-välilehdelle. (4) latitude ja longitude hyväksytty (ei karsita) ja niiden lähteeksi vaihdettu SEMIC Core Location Vocabulary."""@fi,
        """Versio 0.5.2 (2026-09-20):
Ontologiatason metatietojen siivous, korjattu kahdessa kierroksessa ontologian omistajan katselmoinnin jälkeen. (1) dcterms:abstract ja dcterms:description sisältävät nyt täsmälleen yhden arvon kieltä kohden aiemman, varsinaisen kuvauksen ja siihen sekoitetun, asiaan kuulumattoman ”luonnosversio”-huomautuksen sijaan; luonnostila näkyy jo owl:versionInfo-kentän ”-core-draft”-päätteestä. (2) Poistettu ontologiatason dcterms:source, joka osoitti koko kelaterm:-nimiavaruuteen: vain osa termeistä on tosiasiassa peräisin sieltä, ja tämä on jo merkitty jokaiselle sellaiselle termille erikseen. (3) Lisätty aiemmin puuttuneet dcterms:publisher, dcterms:rightsHolder (Kela), dcterms:identifier, dcterms:language ja dcterms:subject. (4) rdfs:seeAlso palautettu alkuperäiseen muotoonsa, paljaaseen hyödynnettyjen sanastojen nimiavaruuslistaan (eli:, cv:, ptv:, dcterms:, cpsv:, schema:, geo:, locn:, org:, prov:, sh:, kelaterm:) sen jälkeen, kun luvaton muokkaus oli korvannut sen pelkillä dokumentaatiolinkeillä; tämä on korjattu, omistajan hyväksymä arvo. (5) Versiossa 0.5.1 tehdyt rdfs:domain- (40 ominaisuutta) ja schema:domainIncludes-lisäykset (4 ominaisuutta: amount, postOffice, postalCode, uuid) -- jotka toteuttivat Huomiot-välilehden suosituksen ilman ontologian omistajan etukäteisvahvistusta -- on peruttu omistajan nimenomaisesta pyynnöstä. Yhdelläkään tämän version datatyyppiominaisuudella ei ole rdfs:domain- tai schema:domainIncludes-merkintää, kuten ennen 0.5.1:tä. Nyt käyttämätön schema:domainIncludes-annotaatio-ominaisuuden kanta-deklaraatio poistettiin vastaavasti."""@fi ;
    skos:scopeNote "The Social Security knowledge graph (KELAO) does not contain applicant-level data — personal data is processed in Kela's operational systems."@en,
        "Sosiaaliturvan tietämysgraafi (KELAO) ei sisällä hakijakohtaisia tietoja — henkilötiedot käsitellään Kelan operatiivisissa järjestelmissä."@fi .

[] a owl:AllDisjointClasses ;
    rdfs:comment "The administrative area types are mutually disjoint."@en,
        "Hallinnolliset aluetyypit ovat toisensa poissulkevia."@fi ;
    owl:members ( kelao:Country kelao:EmploymentArea kelao:Municipality kelao:Region kelao:WellbeingServiceCounty ) .

