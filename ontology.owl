    <!-- https://kela.fi/ontology/kelao#alternative -->


    <owl:AnnotationProperty rdf:about="https://kela.fi/ontology/kelao#alternative">
        <rdfs:comment xml:lang="en">An established acronym or alternative name for the legal resource.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Säädöksen vakiintunut lyhenne tai vaihtoehtoinen nimi.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">lain lyhenne</rdfs:label>
        <rdfs:label xml:lang="en">law acronym</rdfs:label>
        <skos:exactMatch rdf:resource="http://purl.org/dc/terms/alternative"/>
        <skos:prefLabel xml:lang="fi">lain lyhenne</skos:prefLabel>
        <skos:prefLabel xml:lang="en">law acronym</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:LegalResource-instansseilla. Kuvaa säädöksen vakiintuneen lyhenteen, esim. &apos;KEL&apos; tai &apos;SHL&apos;.</skos:scopeNote>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
    </owl:AnnotationProperty>
    


