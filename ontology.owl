    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#serviceHours">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Service opening hours.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">palvelun aukioloajat</rdfs:label>
        <rdfs:label xml:lang="en">service hours</rdfs:label>
