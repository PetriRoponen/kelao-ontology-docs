        <skos:prefLabel xml:lang="fi">säädöksen päiväys</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:LegalResource-instansseilla.</skos:scopeNote>
    </owl:DatatypeProperty>
    


