    <!-- https://kela.fi/ontology/kelao#abbreviation -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#abbreviation">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Internal abbreviation used by Kela for the benefit.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Kelan sisäisesti käyttämä etuuden lyhenne</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">abbreviation</rdfs:label>
        <rdfs:label xml:lang="fi">lyhenne</rdfs:label>
        <skos:definition xml:lang="en">Abbreviation of a benefit used internally by Kela.</skos:definition>
        <skos:definition xml:lang="fi">Etuuden lyhenne, jota Kela käyttää sisäisesti.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
