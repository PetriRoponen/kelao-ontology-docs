    <!-- https://kela.fi/ontology/kelao#serviceUnitType -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#serviceUnitType">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Esimerkiksi Kelan palvelupiste, yhteispalvelupiste tai pop up -palvelupiste (sanasto c863). Arvojoukko koodistona 0.6:ssa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Type of service unit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">palvelupisteen tyyppi</rdfs:label>
        <rdfs:label xml:lang="en">service unit type</rdfs:label>
        <skos:definition xml:lang="fi">Palvelupisteen tyyppi.</skos:definition>
        <skos:definition xml:lang="en">Type of a service unit.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">palvelupisteen tyyppi</skos:prefLabel>
        <skos:prefLabel xml:lang="en">service unit type</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:ServiceUnit-instansseilla.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#streetAddress -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#streetAddress">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Katuosoite. Palvelupisteissä ei ole erikseen käyntiosoitetta.</rdfs:comment>
        <rdfs:comment xml:lang="en">Street address. Service units do not have a separate visiting address.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">katuosoite</rdfs:label>
        <rdfs:label xml:lang="en">street address</rdfs:label>
        <skos:definition xml:lang="fi">Palvelupisteen katuosoite.</skos:definition>
        <skos:definition xml:lang="en">Street address of a service unit.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:exactMatch rdf:resource="http://schema.org/streetAddress"/>
        <skos:prefLabel xml:lang="fi">katuosoite</skos:prefLabel>
        <skos:prefLabel xml:lang="en">street address</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:ServiceUnit-instansseilla.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#taxable -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#taxable">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Is the benefit taxable</rdfs:comment>
        <rdfs:comment xml:lang="fi">Onko etuus verotettava vai ei</rdfs:comment>
        <rdfs:comment xml:lang="sv">Är förmånen skattepliktig</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">beskattningsbar</rdfs:label>
        <rdfs:label xml:lang="en">taxable</rdfs:label>
        <rdfs:label xml:lang="fi">verotettava</rdfs:label>
        <skos:definition xml:lang="fi">Tieto siitä, onko etuus veronalaista tuloa.</skos:definition>
        <skos:definition xml:lang="en">Whether the benefit is taxable income.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:note xml:lang="fi">Tiedot löytyvät myös sivulta https://www.kela.fi/verotus</skos:note>
        <skos:prefLabel xml:lang="sv">beskattningsbar</skos:prefLabel>
        <skos:prefLabel xml:lang="en">taxable</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">verotettava</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#uuid -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#uuid">
        <rdfs:subPropertyOf rdf:resource="http://schema.org/identifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Universally unique identifier used for benefits and attachments.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Yksilöllinen tunniste uuid. Käytössä etuuksilla, palvelukanavilla, palveluilla ja liitteissä.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">uuid</rdfs:label>
        <rdfs:label xml:lang="fi">uuid</rdfs:label>
        <skos:definition xml:lang="en">Universally unique identifier (UUID).</skos:definition>
        <skos:definition xml:lang="fi">Yleiskäyttöinen yksilöivä tunniste (UUID).</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">uuid</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">uuid</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#validFrom -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#validFrom">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c70"/>
        <rdfs:comment xml:lang="fi">Etuuden voimassaoloaika (sanasto c70): ajanjakso, jona etuus on voimassa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Start date of benefit validity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">början av giltighet</rdfs:label>
        <rdfs:label xml:lang="en">valid from</rdfs:label>
        <rdfs:label xml:lang="fi">voimassa alkaen</rdfs:label>
        <skos:definition xml:lang="en">Date from which the benefit is in force.</skos:definition>
        <skos:definition xml:lang="fi">Päivä, josta alkaen etuus on voimassa.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:exactMatch rdf:resource="http://schema.org/startDate"/>
        <skos:prefLabel xml:lang="sv">början av giltighet</skos:prefLabel>
        <skos:prefLabel xml:lang="en">valid from</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">voimassa alkaen</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c70"/>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#validTo -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#validTo">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c70"/>
        <rdfs:comment xml:lang="en">End date of benefit validity</rdfs:comment>
        <rdfs:comment xml:lang="fi">Etuuden voimassaolon loppu</rdfs:comment>
        <rdfs:comment xml:lang="sv">Förmånen gäller till och med datumet</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">tills giltigt</rdfs:label>
        <rdfs:label xml:lang="en">valid to</rdfs:label>
        <rdfs:label xml:lang="fi">voimassa asti</rdfs:label>
        <skos:definition xml:lang="en">Date until which the benefit is in force.</skos:definition>
        <skos:definition xml:lang="fi">Päivä, johon asti etuus on voimassa.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:exactMatch rdf:resource="http://schema.org/endDate"/>
        <skos:prefLabel xml:lang="sv">tills giltigt</skos:prefLabel>
        <skos:prefLabel xml:lang="en">valid to</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">voimassa asti</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c70"/>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#versionDate -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#versionDate">
        <rdfs:subPropertyOf rdf:resource="http://data.europa.eu/eli/ontology#version_date"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/ontology#version_date"/>
        <rdfs:comment xml:lang="fi">Päivämäärä, jolloin säädöksen tämä versio on voimassa.</rdfs:comment>
        <rdfs:comment xml:lang="en">The point-in-time at which the provided description of the legislation is valid.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">versiointipäivä</rdfs:label>
        <rdfs:label xml:lang="en">version date</rdfs:label>
        <skos:definition xml:lang="en">Date on which this version of the statute entered into force.</skos:definition>
        <skos:definition xml:lang="fi">Päivä, jona säädöksen tämä versio on tullut voimaan.</skos:definition>
        <skos:exactMatch rdf:resource="http://schema.org/legislationDateVersion"/>
        <skos:prefLabel xml:lang="fi">versiointipäivä</skos:prefLabel>
        <skos:prefLabel xml:lang="en">version date</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:LegalResource-instansseilla. Kuvaa hetken, jolloin säädöksen kyseinen versio on voimassa.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#wellbeingServiceCountyCode -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#wellbeingServiceCountyCode">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Päällekkäinen yleisen kelao:areaCode-ominaisuuden kanssa.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">hyvinvointialueen koodi</rdfs:label>
        <rdfs:label xml:lang="en">wellbeing service county code</rdfs:label>
        <skos:definition xml:lang="en">Code of a wellbeing services county.</skos:definition>
        <skos:definition xml:lang="fi">Hyvinvointialueen koodi.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">hyvinvointialueen koodi</skos:prefLabel>
        <skos:prefLabel xml:lang="en">wellbeing service county code</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:WellbeingServiceCounty-instansseilla (tai kunnalla viittaustietona).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#wellbeingServiceCountyName -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#wellbeingServiceCountyName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Päällekkäinen rdfs:label-annotaation kanssa.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">hyvinvointialueen nimi</rdfs:label>
        <rdfs:label xml:lang="en">wellbeing service county name</rdfs:label>
        <skos:definition xml:lang="fi">Hyvinvointialueen nimi.</skos:definition>
        <skos:definition xml:lang="en">Name of a wellbeing services county.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">hyvinvointialueen nimi</skos:prefLabel>
        <skos:prefLabel xml:lang="en">wellbeing service county name</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:WellbeingServiceCounty-instansseilla.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#wikidataId -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#wikidataId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Maantieteellisen alueen Wikidata-tunniste.</rdfs:comment>
        <rdfs:comment xml:lang="en">Unique identifier in Wikidata.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">wikidata id</rdfs:label>
        <rdfs:label xml:lang="fi">wikidata-tunniste</rdfs:label>
        <skos:definition xml:lang="fi">Alueen tunniste Wikidatassa.</skos:definition>
        <skos:definition xml:lang="en">Identifier of an area in Wikidata.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">wikidata id</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">wikidata-tunniste</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:Location-instansseilla. Lähdeontologiassa nimellä wikiDataId.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://data.europa.eu/eli/ontology#LegalResource -->


    <owl:Class rdf:about="http://data.europa.eu/eli/ontology#LegalResource"/>
    


    <!-- http://purl.org/vocab/cpsv#PublicService -->


    <owl:Class rdf:about="http://purl.org/vocab/cpsv#PublicService"/>
    


    <!-- http://schema.org/DigitalDocument -->


    <owl:Class rdf:about="http://schema.org/DigitalDocument"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#ConceptScheme -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    


    <!-- http://www.w3.org/ns/org#Organization -->


    <owl:Class rdf:about="http://www.w3.org/ns/org#Organization"/>
    


    <!-- http://www.w3.org/ns/prov#Agent -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Agent"/>
    


    <!-- http://www.w3.org/ns/prov#Entity -->


    <owl:Class rdf:about="http://www.w3.org/ns/prov#Entity"/>
    


    <!-- https://kela.fi/ontology/kelao#Appeal -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Appeal">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c741"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c744"/>
        <rdfs:comment xml:lang="fi">Käytetään sekä oikaisuvaatimuksille että valituksille. Sanastossa muutoksenhaku (c736) on menettely; tämä luokka kuvaa siinä esitettyä vaatimusta.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Appeal</rdfs:label>
        <rdfs:label xml:lang="fi">Muutoksenhaku</rdfs:label>
        <rdfs:label xml:lang="sv">Ändringssökande</rdfs:label>
        <skos:altLabel xml:lang="fi">oikaisuvaatimus</skos:altLabel>
        <skos:altLabel xml:lang="fi">valitus</skos:altLabel>
        <skos:closeMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c741"/>
        <skos:closeMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c744"/>
        <skos:definition xml:lang="en">A customer’s demand that a decision issued by an authority or an appeal body be changed, made either as a request for rectification or as an appeal.</skos:definition>
        <skos:definition xml:lang="fi">Asiakkaan vaatimus viranomaisen tai muutoksenhakuelimen antaman päätöksen muuttamisesta, joka tehdään joko oikaisuvaatimuksena tai valituksena.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Appeal</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Muutoksenhaku</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Ändringssökande</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c736"/>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#AppealBody -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#AppealBody">
        <rdfs:subClassOf rdf:resource="https://kela.fi/ontology/kelao#Organisation"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c748"/>
        <rdfs:comment xml:lang="en">Appeal body: an organisation handling appeals, e.g. the Social Security Appeal Board (SAMU) or the Insurance Court.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Kelan toiminnassa esimerkiksi sosiaaliturva-asioiden muutoksenhakulautakunta (SAMU), opintotuen muutoksenhakulautakunta, vakuutusoikeus ja hallinto-oikeudet.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Appeal body</rdfs:label>
        <rdfs:label xml:lang="sv">Besvärsinstans</rdfs:label>
        <rdfs:label xml:lang="fi">Muutoksenhakuelin</rdfs:label>
        <skos:definition xml:lang="en">A body that handles appeals and is external to the authority that issued the decision.</skos:definition>
        <skos:definition xml:lang="fi">Muutoksenhakuja käsittelevä, päätöksen tehneestä viranomaisesta ulkopuolinen toimielin.</skos:definition>
        <skos:definition xml:lang="sv">Organ som behandlar sökande av ändring och är fristående från den myndighet som fattat beslutet.</skos:definition>
        <skos:exactMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c748"/>
        <skos:prefLabel xml:lang="en">Appeal body</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Besvärsinstans</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Muutoksenhakuelin</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Applicant -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Applicant">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c74"/>
        <rdfs:comment xml:lang="fi">Hakija on asiakkaan prosessirooli (ks. kelao:hasCustomerRole). kelao:User on sovelluksen käyttäjä; sama henkilö voi olla molempia.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Applicant</rdfs:label>
        <rdfs:label xml:lang="fi">Hakija</rdfs:label>
        <rdfs:label xml:lang="sv">Sökande</rdfs:label>
        <skos:altLabel xml:lang="fi">Etuudenhakija</skos:altLabel>
        <skos:altLabel xml:lang="sv">Förmånssökande</skos:altLabel>
        <skos:definition xml:lang="en">A person or organisation that applies for a benefit.</skos:definition>
        <skos:definition xml:lang="fi">Henkilö tai organisaatio, joka hakee etuutta.</skos:definition>
        <skos:definition xml:lang="sv">Person eller organisation som söker en förmån.</skos:definition>
        <skos:exactMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c74"/>
        <skos:prefLabel xml:lang="en">Applicant</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Hakija</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Sökande</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Hakija on prosessirooli. kelao:User on sovelluksen käyttäjä; sama henkilö voi olla molempia.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Application -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Application">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c77"/>
        <rdfs:comment xml:lang="fi">Hakemuksen vireilletulo käynnistää asian käsittelyn. Käsitteellinen luokka: tietämysgraafi ei sisällä hakijakohtaisia hakemuksia.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">Ansökan</rdfs:label>
        <rdfs:label xml:lang="en">Application</rdfs:label>
        <rdfs:label xml:lang="fi">Hakemus</rdfs:label>
        <skos:altLabel xml:lang="sv">Ansökan om förmån</skos:altLabel>
        <skos:altLabel xml:lang="fi">Etuushakemus</skos:altLabel>
        <skos:altLabel xml:lang="sv">Förmånsansökan</skos:altLabel>
        <skos:definition xml:lang="en">A document by which a benefit applicant requests, or a request is made on their behalf and with their consent, to receive a benefit.</skos:definition>
        <skos:definition xml:lang="fi">Asiakirja, jolla etuudenhakija esittää pyynnön tai hänen puolestaan ja hänen suostumuksellaan esitetään pyyntö saada jotain etuutta.</skos:definition>
        <skos:definition xml:lang="sv">Dokument med vilket en förmånssökande anhåller om en förmån eller det på den förmånssökandes vägnar och med hens samtycke anhålls om en förmån.</skos:definition>
        <skos:exactMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c77"/>
        <skos:prefLabel xml:lang="sv">Ansökan</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Application</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Hakemus</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Conceptual class only. The KELAO knowledge graph does not contain applicant-level instances — personal data is processed in Kela&apos;s operational systems.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Käsitteellinen luokka. KELAO-tietämysgraafi ei sisällä hakijakohtaisia instansseja — henkilötiedot käsitellään Kelan operatiivisissa järjestelmissä.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Attachment -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Attachment">
        <rdfs:subClassOf rdf:resource="http://schema.org/DigitalDocument"/>
        <rdfs:comment xml:lang="en">An application attachment, e.g. a receipt, certificate or form.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Hakemuksen liite, esim. tosite, todistus tai lomake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Attachment</rdfs:label>
        <rdfs:label xml:lang="sv">Bilaga</rdfs:label>
        <rdfs:label xml:lang="fi">Liite</rdfs:label>
        <skos:definition xml:lang="en">A document or other material attached to an application that supplements or verifies the information given in the application.</skos:definition>
        <skos:definition xml:lang="fi">Hakemukseen liitettävä asiakirja tai muu aineisto, joka täydentää tai todentaa hakemuksessa esitettyjä tietoja.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Attachment</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Bilaga</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Liite</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Liitettä tarvitaan joskus hakemuksen liitteeksi; pakollisuus on hakemus- tai etuuskohtaista (kuvataan SHACLissa, ei luokkatasolla).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Beneficiary -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Beneficiary">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c75"/>
        <rdfs:comment xml:lang="en">Beneficiary: recipient of a benefit. Distinguished from the applicant: e.g. child benefit is applied for by a guardian, and the payment recipient may be a different party.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Erotetaan hakijasta ja maksunsaajasta: esimerkiksi lapsilisän hakija on huoltaja, ja maksunsaaja voi olla eri taho (esim. kunta tai vuokranantaja).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Beneficiary</rdfs:label>
        <rdfs:label xml:lang="fi">Etuuden saaja</rdfs:label>
        <rdfs:label xml:lang="sv">Förmånstagare</rdfs:label>
        <skos:definition xml:lang="en">A person or organisation that receives a benefit.</skos:definition>
        <skos:definition xml:lang="fi">Henkilö tai organisaatio, joka saa etuutta.</skos:definition>
        <skos:definition xml:lang="sv">Person eller organisation som får en förmån.</skos:definition>
        <skos:exactMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c75"/>
        <skos:prefLabel xml:lang="en">Beneficiary</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Etuuden saaja</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Förmånstagare</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Benefit -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Benefit">
        <rdfs:subClassOf rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c60"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/verotus/c66"/>
        <rdfs:comment xml:lang="en">A social security benefit or allowance. General class — use subclasses for instances.</rdfs:comment>
        <rdfs:comment xml:lang="sv">FPA:s förmåner är sociala förmåner. Ibland används också termen socialförsäkringsförmåner.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Yleinen luokka. Kelan etuudet ovat sosiaalietuuksia; joskus käytetään myös termiä sosiaaliturvaetuus. Etuus ei aina ole rahamääräinen, mutta sen rahallinen arvo on laskettavissa.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Benefit</rdfs:label>
        <rdfs:label xml:lang="fi">Etuus</rdfs:label>
        <rdfs:label xml:lang="sv">Förmån</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://iri.suomi.fi/terminology/verotus/c66"/>
        <skos:altLabel xml:lang="en">Social benefit</skos:altLabel>
        <skos:altLabel xml:lang="fi">Sosiaalietuus</skos:altLabel>
        <skos:altLabel xml:lang="fi">Tuki</skos:altLabel>
        <skos:definition xml:lang="en">A good whose economic value can be determined and which is granted on the basis of the recipient’s status or life situation according to predefined criteria.</skos:definition>
        <skos:definition xml:lang="sv">Nyttighet vars ekonomiska värde kan fastställas och som beviljas utgående från mottagarens ställning eller livssituation på grunder som fastställts i förväg.</skos:definition>
        <skos:definition xml:lang="fi">Taloudelliselta arvoltaan määriteltävissä oleva hyödyke, joka myönnetään saajan aseman tai elämäntilanteen perusteella ennalta määritellyin perustein.</skos:definition>
        <skos:exactMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c60"/>
        <skos:note xml:lang="fi">Verotuksen sanaston määritelmä: suoritus, joka maksetaan saajan aseman tai elämäntilanteen perusteella ennalta määritellyin perustein (https://iri.suomi.fi/terminology/verotus/c66).</skos:note>
        <skos:prefLabel xml:lang="en">Benefit</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Etuus</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Förmån</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#BenefitComponent -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#BenefitComponent">
        <rdfs:subClassOf rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <owl:disjointWith rdf:resource="https://kela.fi/ontology/kelao#StandaloneBenefit"/>
        <rdfs:comment xml:lang="fi">Esimerkiksi opintotuen osia ovat opintoraha, asumislisä ja opintolainan valtiontakaus.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Benefit Component</rdfs:label>
        <rdfs:label xml:lang="fi">Etuuden osa</rdfs:label>
        <skos:altLabel xml:lang="fi">etuusosa</skos:altLabel>
        <skos:altLabel xml:lang="en">sub-benefit</skos:altLabel>
        <skos:definition xml:lang="en">A separately handled part of a benefit that can be granted only if the benefit of which it is a part has also been granted.</skos:definition>
        <skos:definition xml:lang="fi">Etuuden erikseen käsiteltävä osa, joka voidaan myöntää vain, jos myös se etuus, jonka osa on kyseessä, on myönnetty.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:example xml:lang="fi">Esimerkiksi opintotuessa etuuden osia ovat opintoraha, asumislisä ja opintolainan valtiontakaus; lesken- ja lapseneläkkeessä osia ovat perus- ja täydennysmäärät.</skos:example>
        <skos:example xml:lang="en">For example, the study grant, housing supplement and government guarantee for student loan are parts of the financial aid for students.</skos:example>
        <skos:prefLabel xml:lang="en">Benefit Component</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Etuuden osa</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#BenefitGroup -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#BenefitGroup">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="http://kela.fi/kg/EtuusryhmaScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fi">Etuusryhmät ovat skos:Concept-yksilöitä erillisessä luokituksessa (skos:ConceptScheme); yksittäinen etuus liitetään ryhmään ominaisuudella kelao:hasBenefitGroup.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Benefit Group</rdfs:label>
        <rdfs:label xml:lang="fi">Etuusryhmä</rdfs:label>
        <skos:definition xml:lang="en">A classification unit that groups related Kela benefits together.</skos:definition>
        <skos:definition xml:lang="fi">Luokitteluyksikkö, joka kokoaa toisiinsa liittyvät Kelan etuudet yhteen ryhmään.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Benefit Group</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Etuusryhmä</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Country -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Country">
        <rdfs:subClassOf rdf:resource="https://kela.fi/ontology/kelao#Location"/>
        <rdfs:comment xml:lang="fi">Käytetään asumisedellytyksen ja rajat ylittävien tilanteiden (EU, ETA, Sveitsi, sosiaaliturvasopimusmaat) kuvaamiseen. Linkitetty schema:Country-luokkaan.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Country</rdfs:label>
        <rdfs:label xml:lang="sv">Stat</rdfs:label>
        <rdfs:label xml:lang="fi">Valtio</rdfs:label>
        <skos:definition xml:lang="en">A sovereign state in whose territory a person resides or works, or whose legislation applies to social security.</skos:definition>
        <skos:definition xml:lang="fi">Itsenäinen valtio, jonka alueella henkilö asuu, työskentelee tai jonka lainsäädäntöä sosiaaliturvaan sovelletaan.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:exactMatch rdf:resource="http://schema.org/Country"/>
        <skos:prefLabel xml:lang="en">Country</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Stat</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Valtio</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Lähdeontologiassa kuvattu suoraan schema:Country-luokkana; ydinmallissa määritelty omana luokkana ja linkitetty skos:exactMatch-suhteella.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Customer -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Customer">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <terms:source xml:lang="fi">Kelan asiakkuuden käsitemalli (sisäinen lähde)</terms:source>
        <rdfs:comment xml:lang="fi">Asiakas on pysyvä identiteetti, johon tilannekohtaiset roolit (hakija, käyttäjä, etuudensaaja) kiinnittyvät roolisuhteen kautta (kelao:hasCustomerRole).</rdfs:comment>
        <rdfs:comment xml:lang="en">Customer: a person or party having a customer relationship with the social security administrator. The customer is the persistent identity to which contextual roles (applicant, user, beneficiary) are attached via the role-of-customer relation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">Asiakas</rdfs:label>
        <rdfs:label xml:lang="en">Customer</rdfs:label>
        <rdfs:label xml:lang="sv">Kund</rdfs:label>
        <skos:definition xml:lang="en">A person or organisation that receives, or may receive, value from a service provided by Kela.</skos:definition>
        <skos:definition xml:lang="fi">Henkilö tai yhteisö, joka saa tai jolla on mahdollisuus saada arvoa Kelan tarjoamasta palvelusta.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">Asiakas</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Customer</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Kund</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Asiakkaat voivat olla ulkoisia tai sisäisiä. Asiakkaat voivat olla henkilöasiakkaita tai yhteisöasiakkaita. 
                Kelan asiakas saa joko suoraan tai välillisesti Kelan tarjoamaa palvelua, kuten esimerkiksi Kelan etuutta tai Kelan tuottamaa tietopalvelua. Yleiskielessä asiakkaalla tarkoitetaan toimijaa, joka hankkii tai saa palveluja tai hankkii tuotteita. 
                Tällainen toimija voi olla henkilö, henkilöryhmä tai organisaatio. Eepoksessa käytetään termiä &quot;customer&quot; puhuttaessa Kelan henkilöasiakkaista.
                </skos:scopeNote>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#DataProduct -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#DataProduct">
        <rdfs:comment xml:lang="en">A managed and governed collection of data with a purpose, value, ownership and life-cycle that meets consumer needs, e.g. a report or other benefit-related data product.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Esimerkiksi etuuteen liittyvä raportti tai tilasto. Ehdolla siirrettäväksi ydinontologian ulkopuoliseen laajennusmoduuliin versiossa 0.6.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Data Product</rdfs:label>
        <rdfs:label xml:lang="sv">Informationsprodukt</rdfs:label>
        <rdfs:label xml:lang="fi">Tietotuote</rdfs:label>
        <skos:definition xml:lang="en">A managed and owned collection of data that has a purpose, value and life cycle and meets the needs of its consumers.</skos:definition>
        <skos:definition xml:lang="fi">Hallittu ja omistettu tietokokonaisuus, jolla on tarkoitus, arvo ja elinkaari ja joka vastaa tiedon hyödyntäjän tarpeisiin.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Data Product</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Informationsprodukt</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Tietotuote</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Itsenäinen luokka. Mahdollinen linkitys ulkoiseen data product -sanastoon (esim. DPROD) jätetty myöhempään harmonisointiin.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Decision -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Decision">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c78"/>
        <rdfs:comment xml:lang="fi">Etuuspäätös voi olla myönteinen tai kielteinen ja koskea esimerkiksi etuuden myöntämistä, hylkäämistä, tarkistamista, keskeyttämistä, lakkauttamista, maksamista tai takaisinperintää.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">Beslut</rdfs:label>
        <rdfs:label xml:lang="en">Decision</rdfs:label>
        <rdfs:label xml:lang="fi">Päätös</rdfs:label>
        <skos:altLabel xml:lang="sv">beslut om förmån</skos:altLabel>
        <skos:altLabel xml:lang="fi">etuuspäätös</skos:altLabel>
        <skos:altLabel xml:lang="sv">förmånsbeslut</skos:altLabel>
        <skos:definition xml:lang="en">A decision resolving a matter concerning a benefit.</skos:definition>
        <skos:definition xml:lang="sv">Beslut om avgörande av ett ärende som gäller en förmån.</skos:definition>
        <skos:definition xml:lang="fi">Päätös etuutta koskevan asian ratkaisemisesta.</skos:definition>
        <skos:exactMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c78"/>
        <skos:prefLabel xml:lang="sv">Beslut</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Decision</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Päätös</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#EligibilityCriterion -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#EligibilityCriterion">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">Eligibility criterion: an individual condition affecting entitlement to a benefit (e.g. age limit, residence requirement, income limit, employment condition). Reified so that each criterion can carry its own legal basis and parameters.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Esimerkiksi ikäraja, asumisedellytys, tuloraja tai työssäoloehto. Mallinnettu omana luokkana, jotta kriteeri voi kantaa oman oikeusperustansa ja parametrinsa.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Eligibility criterion</rdfs:label>
        <rdfs:label xml:lang="fi">Etuuskriteeri</rdfs:label>
        <skos:closeMatch rdf:resource="http://data.europa.eu/m8g/Criterion"/>
        <skos:definition xml:lang="en">A condition for granting a benefit whose fulfilment affects entitlement to the benefit or its amount.</skos:definition>
        <skos:definition xml:lang="fi">Etuuden myöntämisedellytys, jonka täyttyminen vaikuttaa oikeuteen saada etuus tai etuuden määrään.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Eligibility criterion</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Etuuskriteeri</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#EmploymentArea -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#EmploymentArea">
        <rdfs:subClassOf rdf:resource="https://kela.fi/ontology/kelao#Location"/>
        <terms:source xml:lang="fi">laki työvoimapalveluiden järjestämisestä (380/2023)</terms:source>
        <rdfs:comment xml:lang="en">Employment area: a statutory area formed by municipalities responsible for organising public employment services (Finnish TE services reform 2025).</rdfs:comment>
        <rdfs:comment xml:lang="fi">Perustuu lakiin työvoimapalveluiden järjestämisestä (380/2023); voimassa 1.1.2025 alkaen.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Employment area</rdfs:label>
        <rdfs:label xml:lang="sv">Sysselsättningsområde</rdfs:label>
        <rdfs:label xml:lang="fi">Työllisyysalue</rdfs:label>
        <skos:definition xml:lang="en">An area formed by municipalities that is responsible for organising public employment services.</skos:definition>
        <skos:definition xml:lang="fi">Kuntien muodostama alue, joka vastaa julkisten työvoimapalvelujen järjestämisestä.</skos:definition>
        <skos:prefLabel xml:lang="en">Employment area</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Sysselsättningsområde</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Työllisyysalue</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Income -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Income">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="fi">Esimerkiksi palkka, yrittäjätulo, pääomatulo tai etuustulo. Vrt. sanaston käsitteet etuoikeutettu tulo (c72) ja etuusperusteinen tulo (c732).</rdfs:comment>
        <rdfs:comment xml:lang="en">Income: an income item of a person or recipient unit (e.g. wage, self-employment income, capital income, benefit income) that may be taken into account in means testing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Income</rdfs:label>
        <rdfs:label xml:lang="sv">Inkomst</rdfs:label>
        <rdfs:label xml:lang="fi">Tulo</rdfs:label>
        <skos:definition xml:lang="en">An income item of a person or household that may be taken into account when calculating the amount of a benefit or in means testing.</skos:definition>
        <skos:definition xml:lang="fi">Henkilön tai ruokakunnan tuloerä, joka voidaan ottaa huomioon etuuden määrää laskettaessa tai tarveharkinnassa.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Income</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Inkomst</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Tulo</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c72"/>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c732"/>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#LegalResource -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#LegalResource">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalResource"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/ontology#LegalResource"/>
        <rdfs:comment xml:lang="en">A work in a legislative corpus. This applies to acts that have been legally enacted (whether or not they are still in force). A legal resource can represent a legal act or any component of a legal act, like an article. Legal resources can be linked together using properties defined in the model.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Vastaa ELI-ontologian LegalResource-luokkaa. Kattaa lait, asetukset ja EU-säädökset riippumatta siitä, ovatko ne voimassa. Säädöksen osat kuvataan luokalla kelao:LegalResourcePart.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">Juridisk resurs</rdfs:label>
        <rdfs:label xml:lang="en">Legal Resource</rdfs:label>
        <rdfs:label xml:lang="fi">Säädös</rdfs:label>
        <skos:definition xml:lang="en">A statute issued by a public authority and intended to be generally binding, or a version of it.</skos:definition>
        <skos:definition xml:lang="fi">Julkisen vallan antama, yleisesti noudatettavaksi tarkoitettu säädös tai sen versio.</skos:definition>
        <skos:exactMatch rdf:resource="http://schema.org/Legislation"/>
        <skos:example xml:lang="en">Examples of statutes are acts and decrees as well as legal provisions issued by authorities.</skos:example>
        <skos:example xml:lang="fi">Säädöksiä ovat esimerkiksi lait ja asetukset sekä viranomaisten antamat oikeussäännöt.</skos:example>
        <skos:prefLabel xml:lang="sv">Juridisk resurs</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Legal Resource</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Säädös</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#LegalResourcePart -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#LegalResourcePart">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalResource"/>
        <rdfs:comment xml:lang="fi">Esimerkiksi kansaneläkelain 23 §. Erottaa kokonaiset säädökset niiden osista; EU-säädöksissä jaottelu (artikla, kohta) poikkeaa kansallisesta.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">Lagdel</rdfs:label>
        <rdfs:label xml:lang="fi">Lain osa</rdfs:label>
        <rdfs:label xml:lang="en">Legal Resource Part</rdfs:label>
        <skos:definition xml:lang="en">A structural part of a statute, such as a chapter, section, subsection or paragraph.</skos:definition>
        <skos:definition xml:lang="fi">Säädöksen rakenteellinen osa, kuten luku, pykälä, momentti tai kohta.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:example xml:lang="fi">Kansaneläkelain 23 §</skos:example>
        <skos:prefLabel xml:lang="sv">Lagdel</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Lain osa</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Legal Resource Part</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#LifeSituation -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#LifeSituation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="http://kela.fi/kg/ElamantilanneluokitusScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A life situation is a phase of change or circumstance in a citizen&apos;s life associated with a need for public services and benefits. Individual life situations form the life-situation classification (a skos:ConceptScheme).</rdfs:comment>
        <rdfs:comment xml:lang="fi">Yksittäiset elämäntilanteet muodostavat elämäntilanneluokituksen (skos:ConceptScheme), jonka pohjana on DVV:n elämäntapahtumaluokitus.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">Elämäntilanne</rdfs:label>
        <rdfs:label xml:lang="en">Life Situation</rdfs:label>
        <rdfs:label xml:lang="sv">Livssituation</rdfs:label>
        <skos:definition xml:lang="en">A phase or circumstance in a person’s life that involves a need for public services or benefits.</skos:definition>
        <skos:definition xml:lang="fi">Henkilön elämän vaihe tai tilanne, johon liittyy julkisten palvelujen tai etuuksien tarve.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">Elämäntilanne</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Life Situation</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Livssituation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Location -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Location">
        <rdfs:comment xml:lang="en">A geographic area used e.g. to describe a place of residence, a service operating area, or the location of a service unit. Superclass for municipalities, wellbeing service counties, regions and countries.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Yliluokka kunnille, hyvinvointialueille, maakunnille, työllisyysalueille ja valtioille. Linkitetty W3C Location Core -sanastoon (locn:Location).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Location</rdfs:label>
        <rdfs:label xml:lang="sv">Plats</rdfs:label>
        <rdfs:label xml:lang="fi">Sijainti</rdfs:label>
        <skos:altLabel xml:lang="en">Geographic Area</skos:altLabel>
        <skos:altLabel xml:lang="fi">Maantieteellinen alue</skos:altLabel>
        <skos:altLabel xml:lang="en">Place</skos:altLabel>
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/locn#Location"/>
        <skos:definition xml:lang="en">A geographic area regardless of its size or administrative level.</skos:definition>
        <skos:definition xml:lang="fi">Maantieteellinen alue koosta tai hallinnollisesta tasosta riippumatta.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Location</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Plats</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Sijainti</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Ydinmallissa nimi on harmonisoitu Location-muotoon ja linkitetty W3C Location Core -sanastoon (locn:Location).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Municipality -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Municipality">
        <rdfs:subClassOf rdf:resource="https://kela.fi/ontology/kelao#Location"/>
        <terms:source xml:lang="fi">kuntalaki (410/2015) 1 §</terms:source>
        <rdfs:comment xml:lang="fi">Suomen kunnat tunnistetaan Suomi.fi-koodiston URI-tunnisteilla ja kolminumeroisella kuntakoodilla. Kunta kuuluu maakuntaan ja hyvinvointialueeseen.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">Kommun</rdfs:label>
        <rdfs:label xml:lang="fi">Kunta</rdfs:label>
        <rdfs:label xml:lang="en">Municipality</rdfs:label>
        <skos:definition xml:lang="en">A local self-governing unit that performs the tasks belonging to its residents’ self-government and those laid down by law.</skos:definition>
        <skos:definition xml:lang="fi">Alueellinen itsehallintoyksikkö, joka hoitaa asukkaidensa itsehallintoon kuuluvat ja laissa säädetyt tehtävät.</skos:definition>
        <skos:prefLabel xml:lang="sv">Kommun</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Kunta</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Municipality</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Suomen kunnat, Suomi.fi URI:t.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Organisation -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Organisation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <terms:source rdf:resource="http://iri.suomi.fi/model/suomiptv2/"/>
        <rdfs:comment xml:lang="fi">Kattaa julkisen, yksityisen ja kolmannen sektorin toimijat. Vastaa PTV:n ja schema.orgin Organization-käsitettä; EU Core Public Organisation on erikoistapaus.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">Organisaatio</rdfs:label>
        <rdfs:label xml:lang="sv">Organisation</rdfs:label>
        <rdfs:label xml:lang="en">Organization</rdfs:label>
        <skos:broadMatch rdf:resource="http://data.europa.eu/m8g/PublicOrganisation"/>
        <skos:closeMatch rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <skos:definition xml:lang="en">An association of persons with a common goal and an appropriate structure.</skos:definition>
        <skos:definition xml:lang="fi">Henkilöiden muodostama yhteenliittymä, jolla on yhteinen tavoite ja tarkoituksenmukainen rakenne.</skos:definition>
        <skos:exactMatch rdf:resource="http://iri.suomi.fi/model/suomiptv2/Organization"/>
        <skos:exactMatch rdf:resource="http://schema.org/Organization"/>
        <skos:prefLabel xml:lang="fi">Organisaatio</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Organisation</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Organization</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">KELAO-kontekstissa vastaa PTV:n Organization-käsitettä ja 
        schema.org/Organization-käsitettä. Käytetään kuvaamaan kaikkia 
         toimijaorganisaatioita sektorirajat ylittäen (julkinen, yksityinen, 
         kolmas sektori). EU Core Public Organisation on tämän erikoistapaus.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Payment -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Payment">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="fi">Kytkee päätöksen, etuuden ja maksunsaajan rahavirtaan. Maksunsaaja ei aina ole sama kuin etuudensaaja (sanasto c76).</rdfs:comment>
        <rdfs:comment xml:lang="en">Payment or instalment: a benefit disbursement made on the basis of a decision. Links the decision, benefit and recipient to the money flow.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">Betalning</rdfs:label>
        <rdfs:label xml:lang="fi">Maksu</rdfs:label>
        <rdfs:label xml:lang="en">Payment</rdfs:label>
        <skos:definition xml:lang="en">A benefit disbursement, or an instalment of it, paid to the payee on the basis of a benefit decision.</skos:definition>
        <skos:definition xml:lang="fi">Etuuspäätöksen perusteella maksunsaajalle maksettu etuussuoritus tai sen maksuerä.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="sv">Betalning</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Maksu</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Payment</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c76"/>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Recovery -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Recovery">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">Recovery: reclaiming a benefit paid in excess or without grounds from the recipient.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Takaisinperinnästä annetaan etuuspäätös. Kohdistuu maksuun (kelao:recoveryConcerns).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">Recovery</rdfs:label>
        <rdfs:label xml:lang="fi">Takaisinperintä</rdfs:label>
        <rdfs:label xml:lang="sv">Återkrav</rdfs:label>
        <skos:altLabel xml:lang="en">Claim for recovery</skos:altLabel>
        <skos:definition xml:lang="en">A procedure by which a benefit paid in excess or without grounds is reclaimed.</skos:definition>
        <skos:definition xml:lang="fi">Menettely, jossa liikaa tai perusteetta maksettu etuus peritään takaisin.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">Recovery</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Takaisinperintä</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Återkrav</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Region -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Region">
        <rdfs:subClassOf rdf:resource="https://kela.fi/ontology/kelao#Location"/>
        <terms:source xml:lang="fi">laki alueiden kehittämisestä ja Euroopan unionin alue- ja rakennepolitiikan toimeenpanosta (756/2021)</terms:source>
        <rdfs:comment xml:lang="fi">Suomessa 19 maakuntaa (2025). Rinnakkainen hierarkia hyvinvointialueiden kanssa: kunta kuuluu sekä maakuntaan että hyvinvointialueeseen.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">Landskap</rdfs:label>
        <rdfs:label xml:lang="fi">Maakunta</rdfs:label>
        <rdfs:label xml:lang="en">Region</rdfs:label>
        <skos:definition xml:lang="en">An area formed by municipalities that serves as the unit for regional development and regional land-use planning.</skos:definition>
        <skos:definition xml:lang="fi">Kuntien muodostama alue, joka toimii alueiden kehittämisen ja maakuntakaavoituksen yksikkönä.</skos:definition>
        <skos:prefLabel xml:lang="sv">Landskap</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Maakunta</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Region</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#Service -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#Service">
        <rdfs:subClassOf rdf:resource="http://purl.org/vocab/cpsv#PublicService"/>
        <terms:source rdf:resource="http://iri.suomi.fi/model/suomiptv2/"/>
        <rdfs:comment xml:lang="en">A social-security-related service, e.g. an application or advisory service.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Sosiaaliturvaan liittyvä palvelu, esimerkiksi hakemus- tai neuvontapalvelu. Palvelu liitetään etuuteen (kelao:relatedService) ja on käytettävissä palvelukanavien kautta.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">Palvelu</rdfs:label>
        <rdfs:label xml:lang="en">Service</rdfs:label>
        <rdfs:label xml:lang="sv">Tjänst</rdfs:label>
        <skos:definition xml:lang="en">An activity by which a service provider meets a customer’s need.</skos:definition>
        <skos:definition xml:lang="fi">Toiminto, jolla palveluntuottaja vastaa asiakkaan tarpeeseen.</skos:definition>
        <skos:exactMatch rdf:resource="http://iri.suomi.fi/model/suomiptv2/Service"/>
        <skos:prefLabel xml:lang="fi">Palvelu</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Service</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Tjänst</skos:prefLabel>
        <skos:scopeNote xml:lang="en">In the core model a service is linked to a benefit (kelao:relatedService) and is accessible through service channels (kelao:hasServiceChannel). Service channels (kelao:ServiceChannel) and service units (kelao:ServiceUnit) are part of the core model; broader PTV metadata (e.g. funding type, service classification, target groups) remains outside it.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ydinmallissa palvelu liitetään etuuteen (kelao:relatedService) ja se on käytettävissä palvelukanavien kautta (kelao:hasServiceChannel). Palvelukanava (kelao:ServiceChannel) ja palvelupiste (kelao:ServiceUnit) kuuluvat ydinmalliin; laajempi PTV-metatieto (esim. rahoitustyyppi, palveluluokitus, kohderyhmät) jää edelleen ydinmallin ulkopuolelle.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#ServiceChannel -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#ServiceChannel">
        <terms:source rdf:resource="http://iri.suomi.fi/model/suomiptv2/"/>
        <rdfs:comment xml:lang="en">A service channel: the way a customer accesses a service, e.g. e-service, web page, printable form, telephone service or a physical service point. A single service may have several alternative or sequential channels.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Esimerkiksi verkkoasiointi, puhelinpalvelu, tulostettava lomake tai palvelupiste. Linkitetty PTV:n ServiceChannel-käsitteeseen skos:closeMatch-suhteella.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">Palvelukanava</rdfs:label>
        <rdfs:label xml:lang="en">Service Channel</rdfs:label>
        <rdfs:label xml:lang="sv">Servicekanal</rdfs:label>
        <skos:closeMatch rdf:resource="http://iri.suomi.fi/model/suomiptv2/ServiceChannel"/>
        <skos:definition xml:lang="fi">Tapa, jolla asiakas saa palvelun käyttöönsä.</skos:definition>
        <skos:definition xml:lang="en">The way in which a customer accesses a service.</skos:definition>
        <skos:prefLabel xml:lang="fi">Palvelukanava</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Service Channel</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Servicekanal</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c860"/>
        <skos:scopeNote xml:lang="fi">Linkitetty PTV:n ServiceChannel-käsitteeseen vain skos:closeMatch-suhteella, koska ptv: on epävakaa nimiavaruus.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#ServiceUnit -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#ServiceUnit">
        <rdfs:subClassOf rdf:resource="https://kela.fi/ontology/kelao#ServiceChannel"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c862"/>
        <rdfs:comment xml:lang="en">A service unit (service point) with a physical location. Service unit data has been combined from Kela&apos;s internal sources and PTV service-channel data (entity matching).</rdfs:comment>
        <rdfs:comment xml:lang="fi">Palvelukanavan erikoistapaus, jolla on fyysinen sijainti. Kelan palvelupisteissä työskentelee Kelan palveluasiantuntijoita.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">Palvelupiste</rdfs:label>
        <rdfs:label xml:lang="en">Service Unit</rdfs:label>
        <rdfs:label xml:lang="sv">Serviceställe</rdfs:label>
        <skos:altLabel xml:lang="fi">Palveluyksikkö</skos:altLabel>
        <skos:closeMatch rdf:resource="http://iri.suomi.fi/model/suomiptv2/ServiceChannel"/>
        <skos:definition xml:lang="en">A physical service point maintained, as a rule, by one actor where services of that actor or other actors are available.</skos:definition>
        <skos:definition xml:lang="fi">Toimipiste, jota ylläpitää pääsääntöisesti yksi toimija ja jossa voi saada kyseisen toimijan tai muiden toimijoiden tarjoamia palveluja.</skos:definition>
        <skos:definition xml:lang="sv">Verksamhetsställe, som i regel har en aktör som huvudman och där aktören i fråga erbjuder tjänster.</skos:definition>
        <skos:exactMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c862"/>
        <skos:prefLabel xml:lang="fi">Palvelupiste</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Service Unit</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Serviceställe</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Palvelupiste on palvelukanavan erikoistapaus, siksi rdfs:subClassOf kelao:ServiceChannel.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#StandaloneBenefit -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#StandaloneBenefit">
        <rdfs:subClassOf rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Huom. termi &quot;itsenäinen etuus&quot; tarkoittaa sanastossa ja EU-asetuksessa 883/2004 eri asiaa (itsenäinen eläke, c535). Nimeäminen tarkistettava versiossa 0.6.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">Itsenäinen etuus</rdfs:label>
        <rdfs:label xml:lang="en">Standalone Benefit</rdfs:label>
        <skos:definition xml:lang="en">A benefit that can be granted on its own and may consist of benefit components.</skos:definition>
        <skos:definition xml:lang="fi">Etuus, joka voidaan myöntää sellaisenaan ja joka voi koostua etuuden osista.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">Itsenäinen etuus</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Standalone Benefit</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#StatuteType -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#StatuteType">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="http://kela.fi/kg/saadostyyppi-luokitus"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fi">Esimerkiksi laki, valtioneuvoston asetus, EU-asetus tai sopimus. Lajit ovat skos:Concept-yksilöitä erillisessä luokituksessa (luonnos).</rdfs:comment>
        <rdfs:comment xml:lang="en">Statute type classification (draft). The Skos-classification has 13 classes for example EU regulation, Decree, Agreement, Government decree, and Presidential decree.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">Författningstyp</rdfs:label>
        <rdfs:label xml:lang="en">Statute Type</rdfs:label>
        <rdfs:label xml:lang="fi">Säädöstyyppi</rdfs:label>
        <skos:definition xml:lang="fi">Säädöksen laji sen antajan ja oikeudellisen aseman mukaan.</skos:definition>
        <skos:definition xml:lang="en">The kind of a statute according to its issuer and legal status.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="sv">Författningstyp</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Statute Type</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Säädöstyyppi</skos:prefLabel>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#User -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#User">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">Application user, user.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Käyttäjä on asiakkaan rooli (kelao:hasCustomerRole). Erotetaan hakijasta: käyttäjä voi selvittää oikeuttaan etuuteen jättämättä hakemusta.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">Användare</rdfs:label>
        <rdfs:label xml:lang="fi">Käyttäjä</rdfs:label>
        <rdfs:label xml:lang="en">User</rdfs:label>
        <skos:definition xml:lang="en">A person who uses an electronic transaction or information service of social security.</skos:definition>
        <skos:definition xml:lang="fi">Henkilö, joka käyttää sosiaaliturvan sähköistä asiointi- tai tietopalvelua.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="sv">Användare</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">Käyttäjä</skos:prefLabel>
        <skos:prefLabel xml:lang="en">User</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c859"/>
    </owl:Class>
    


    <!-- https://kela.fi/ontology/kelao#WellbeingServiceCounty -->


    <owl:Class rdf:about="https://kela.fi/ontology/kelao#WellbeingServiceCounty">
        <rdfs:subClassOf rdf:resource="https://kela.fi/ontology/kelao#Location"/>
        <terms:source xml:lang="fi">laki hyvinvointialueesta (611/2021) 2 §</terms:source>
        <rdfs:comment xml:lang="fi">21 hyvinvointialuetta sekä Helsingin kaupunki, joka hoitaa hyvinvointialueen tehtävät. Kunta kuuluu täsmälleen yhteen hyvinvointialueeseen.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">Hyvinvointialue</rdfs:label>
        <rdfs:label xml:lang="sv">Välfärdsområde</rdfs:label>
        <rdfs:label xml:lang="en">Wellbeing Service County</rdfs:label>
        <skos:definition xml:lang="en">A public-law entity with self-government in its territory that is responsible for organising health, social and rescue services.</skos:definition>
        <skos:definition xml:lang="fi">Julkisoikeudellinen yhteisö, jolla on alueellaan itsehallinto ja joka vastaa sosiaali- ja terveydenhuollon sekä pelastustoimen järjestämisestä.</skos:definition>
        <skos:prefLabel xml:lang="fi">Hyvinvointialue</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">Välfärdsområde</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Wellbeing Service County</skos:prefLabel>
    </owl:Class>
    


