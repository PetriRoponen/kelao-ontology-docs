    <!-- https://kela.fi/ontology/kelao#advancePayment -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#advancePayment">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Käytetään etuuksien välisen ennakkosuoritussuhteen kuvaamiseen. Käyttöala tarkistettava.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">advance payment</rdfs:label>
        <rdfs:label xml:lang="fi">ennakkosuoritus</rdfs:label>
        <skos:definition xml:lang="en">Relation stating that a benefit may be paid as an advance for the waiting period of another benefit.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee, että etuutta voidaan maksaa ennakkona toisen etuuden odotusajalta.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">advance payment</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">ennakkosuoritus</skos:prefLabel>
        <relationshipAbbreviation>ENN</relationshipAbbreviation>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#appealHandledBy -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#appealHandledBy">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Appeal"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#AppealBody"/>
        <rdfs:comment xml:lang="en">The appeal is handled by this appeal body.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Valituksen käsittelee tämä muutoksenhakuelin.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">appeal handled by</rdfs:label>
        <rdfs:label xml:lang="fi">käsittelevä muutoksenhakuelin</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the appeal body that handles the appeal.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee muutoksenhakuelimen, joka käsittelee muutoksenhaun.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">appeal handled by</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">käsittelevä muutoksenhakuelin</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#appealsDecision -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#appealsDecision">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Appeal"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Decision"/>
        <rdfs:comment xml:lang="fi">Päätös, johon muutoksenhaku kohdistuu.</rdfs:comment>
        <rdfs:comment xml:lang="en">The decision the appeal is directed against.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">appeals decision</rdfs:label>
        <rdfs:label xml:lang="fi">kohdistuu päätökseen</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the decision that the appeal concerns.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee päätöksen, johon muutoksenhaku kohdistuu.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">appeals decision</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">kohdistuu päätökseen</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#applicationConcerns -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#applicationConcerns">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Application"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Etuus jota hakemus koskee.</rdfs:comment>
        <rdfs:comment xml:lang="en">The benefit the application concerns.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">application concerns</rdfs:label>
        <rdfs:label xml:lang="fi">hakemus koskee etuutta</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the benefit that the application concerns.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuuden, jota hakemus koskee.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">application concerns</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">hakemus koskee etuutta</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#appliesFor -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#appliesFor">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Applicant"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Hakija hakee tätä etuutta.</rdfs:comment>
        <rdfs:comment xml:lang="en">The applicant applies for this benefit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">applies for</rdfs:label>
        <rdfs:label xml:lang="fi">hakee etuutta</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the benefit that the applicant applies for.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuuden, jota hakija hakee.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">applies for</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">hakee etuutta</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#belongsToCountry -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#belongsToCountry">
        <rdfs:subPropertyOf rdf:resource="https://kela.fi/ontology/kelao#isPartOfArea"/>
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Location"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Country"/>
        <rdfs:comment xml:lang="fi">Alue kuuluu tähän valtioon. Käytetään maakunnille, hyvinvointialueille, työllisyysalueille ja tarvittaessa suoraan kunnille.</rdfs:comment>
        <rdfs:comment xml:lang="en">The area belongs to this country. Used for regions, wellbeing service counties, employment areas and, where needed, directly for municipalities.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">belongs to country</rdfs:label>
        <rdfs:label xml:lang="fi">kuuluu valtioon</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the country to which an area belongs.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee valtion, johon alue kuuluu.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">belongs to country</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">kuuluu valtioon</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#belongsToEmploymentArea -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#belongsToEmploymentArea">
        <rdfs:subPropertyOf rdf:resource="https://kela.fi/ontology/kelao#isPartOfArea"/>
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Municipality"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#EmploymentArea"/>
        <rdfs:comment xml:lang="fi">Kunta kuuluu tähän työllisyysalueeseen. Ei pakollinen: esim. Ahvenanmaan kunnilla ei ole työllisyysaluetta.</rdfs:comment>
        <rdfs:comment xml:lang="en">The municipality belongs to this employment area. Optional: e.g. municipalities in Åland have no employment area.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">belongs to employment area</rdfs:label>
        <rdfs:label xml:lang="fi">kuuluu työllisyysalueeseen</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the employment area to which a municipality belongs.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee työllisyysalueen, johon kunta kuuluu.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">belongs to employment area</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">kuuluu työllisyysalueeseen</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#belongsToRegion -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#belongsToRegion">
        <rdfs:subPropertyOf rdf:resource="https://kela.fi/ontology/kelao#isPartOfArea"/>
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Municipality"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Region"/>
        <rdfs:comment xml:lang="fi">Kunta kuuluu tähän maakuntaan. Rinnakkainen hierarkia hyvinvointialueeseen kuulumisen kanssa: kunta kuuluu sekä maakuntaan että hyvinvointialueeseen.</rdfs:comment>
        <rdfs:comment xml:lang="en">The municipality belongs to this region (maakunta). Parallel to wellbeing service county membership; the two hierarchies are independent.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">belongs to region</rdfs:label>
        <rdfs:label xml:lang="fi">kuuluu maakuntaan</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the region to which a municipality belongs.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee maakunnan, johon kunta kuuluu.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">belongs to region</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">kuuluu maakuntaan</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#belongsToWellbeingServiceCounty -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#belongsToWellbeingServiceCounty">
        <rdfs:subPropertyOf rdf:resource="https://kela.fi/ontology/kelao#isPartOfArea"/>
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Municipality"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#WellbeingServiceCounty"/>
        <rdfs:comment xml:lang="fi">Kunta kuuluu tähän hyvinvointialueeseen.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">belongs to wellbeing service county</rdfs:label>
        <rdfs:label xml:lang="fi">kuuluu hyvinvointialueeseen</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the wellbeing services county to which a municipality belongs.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee hyvinvointialueen, johon kunta kuuluu.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">belongs to wellbeing service county</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">kuuluu hyvinvointialueeseen</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#broaderBenefit -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#broaderBenefit">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Käsitehierarkia, ei osa–kokonaisuus-suhde (vrt. kelao:isPartOfBenefit). Esimerkiksi opintoraha → opintotuki.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">broader benefit</rdfs:label>
        <rdfs:label xml:lang="fi">laajempi etuus</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the broader benefit under which a benefit is conceptually subsumed.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee laajemman etuuskokonaisuuden, johon etuus käsitteellisesti sisältyy.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">broader benefit</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">laajempi etuus</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#containsArea -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#containsArea">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Location"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Location"/>
        <rdfs:comment xml:lang="en">A geographic area contains another geographic area. Inverse of &apos;is part of area&apos;.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Alue sisältää toisen maantieteellisen alueen. Käänteisominaisuus ominaisuudelle &apos;on osa aluetta&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">contains area</rdfs:label>
        <rdfs:label xml:lang="fi">sisältää alueen</rdfs:label>
        <skos:closeMatch rdf:resource="http://schema.org/containsPlace"/>
        <skos:definition xml:lang="en">Relation stating that an area contains another geographic area.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee, että alue sisältää toisen maantieteellisen alueen.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">contains area</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">sisältää alueen</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#criterionLegalBasis -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#criterionLegalBasis">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#EligibilityCriterion"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#LegalResource"/>
        <rdfs:comment xml:lang="fi">Kriteerin oikeusperusta: viittaus säädökseen tai sen osaan (ELI-URI, pykälätaso).</rdfs:comment>
        <rdfs:comment xml:lang="en">Legal basis of the criterion: reference to a legal resource or its subdivision (ELI URI, section level).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">criterion legal basis</rdfs:label>
        <rdfs:label xml:lang="fi">kriteerin oikeusperusta</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the statute or part of a statute on which an eligibility criterion is based.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee säädöksen tai sen osan, johon etuuskriteeri perustuu.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">criterion legal basis</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">kriteerin oikeusperusta</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#dataProductOwner -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#dataProductOwner">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#DataProduct"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Organisation"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">data product owner</rdfs:label>
        <rdfs:label xml:lang="fi">tietotuotteen vastuuorganisaatio</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the organisation responsible for a data product.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee tietotuotteesta vastaavan organisaation.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">data product owner</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">tietotuotteen vastuuorganisaatio</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#hasApplication -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#hasApplication">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Applicant"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Application"/>
        <rdfs:comment xml:lang="en">An application submitted by the applicant.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Hakijan jättämä hakemus.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">has application</rdfs:label>
        <rdfs:label xml:lang="fi">jätti hakemuksen</rdfs:label>
        <skos:definition xml:lang="en">Relation stating an application submitted by the applicant.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee hakijan jättämän hakemuksen.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has application</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">jätti hakemuksen</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#hasAttachment -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#hasAttachment">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Application"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Attachment"/>
        <rdfs:comment xml:lang="en">An attachment belonging to the application.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Hakemukseen liittyvä liite.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">hakemuksen liite</rdfs:label>
        <rdfs:label xml:lang="en">has attachment</rdfs:label>
        <skos:definition xml:lang="en">Relation stating an attachment belonging to an application.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee hakemukseen kuuluvan liitteen.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">hakemuksen liite</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has attachment</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#hasBenefitGroup -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#hasBenefitGroup">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#BenefitGroup"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">etuusryhmä</rdfs:label>
        <rdfs:label xml:lang="en">has benefit group</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the benefit group into which a benefit is classified.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuusryhmän, johon etuus on luokiteltu.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">etuusryhmä</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has benefit group</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#hasBenefitPart -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#hasBenefitPart">
        <owl:inverseOf rdf:resource="https://kela.fi/ontology/kelao#isPartOfBenefit"/>
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#StandaloneBenefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#BenefitComponent"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">etuudella on osa</rdfs:label>
        <rdfs:label xml:lang="en">has benefit part</rdfs:label>
        <skos:definition xml:lang="en">Relation stating a benefit component of which a standalone benefit consists.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuuden osan, josta itsenäinen etuus koostuu.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">etuudella on osa</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has benefit part</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#hasConcept -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#hasConcept">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="fi">Käytetään linkitykseen Kelan terminologisen sanaston ja muiden SKOS-sanastojen käsitteisiin.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">has concept</rdfs:label>
        <rdfs:label xml:lang="fi">on käsite</rdfs:label>
        <skos:definition xml:lang="en">Relation linking a benefit to a vocabulary concept that describes it.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka liittää etuuteen sitä kuvaavan sanaston käsitteen.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has concept</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">on käsite</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#hasCustomerRole -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#hasCustomerRole">
        <owl:inverseOf rdf:resource="https://kela.fi/ontology/kelao#roleOfCustomer"/>
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Customer"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://kela.fi/ontology/kelao#Applicant"/>
                    <rdf:Description rdf:about="https://kela.fi/ontology/kelao#Beneficiary"/>
                    <rdf:Description rdf:about="https://kela.fi/ontology/kelao#User"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="fi">Asiakkaalla on tämä rooli (hakija, käyttäjä tai etuuden saaja). Sama asiakas voi olla useassa roolissa samanaikaisesti tai eri yhteyksissä.</rdfs:comment>
        <rdfs:comment xml:lang="en">The customer has this role (applicant, user or beneficiary). The same customer may hold several roles simultaneously or in different contexts.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">asiakkaan rooli</rdfs:label>
        <rdfs:label xml:lang="en">has customer role</rdfs:label>
        <skos:definition xml:lang="en">Relation stating a role (applicant, user or beneficiary) in which a customer acts.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee roolin (hakija, käyttäjä tai etuudensaaja), jossa asiakas toimii.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">asiakkaan rooli</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has customer role</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#hasDecision -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#hasDecision">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Application"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Decision"/>
        <rdfs:comment xml:lang="fi">Hakemukseen annettu päätös.</rdfs:comment>
        <rdfs:comment xml:lang="en">The decision issued on the application.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">hakemuksen päätös</rdfs:label>
        <rdfs:label xml:lang="en">has decision</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the decision issued on an application.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee hakemukseen annetun päätöksen.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">hakemuksen päätös</skos:prefLabel>
        <skos:prefLabel xml:lang="en">has decision</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#hasEligibilityCriterion -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#hasEligibilityCriterion">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#EligibilityCriterion"/>
        <rdfs:comment xml:lang="fi">Etuudella on tämä kelpoisuuskriteeri.</rdfs:comment>
        <rdfs:comment xml:lang="en">The benefit has this eligibility criterion.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">has eligibility criterion</rdfs:label>
        <rdfs:label xml:lang="fi">kriteerinä</rdfs:label>
        <skos:definition xml:lang="en">Relation stating an eligibility criterion of a benefit.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuuden myöntämisedellytyksen.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has eligibility criterion</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">kriteerinä</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#hasIncome -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#hasIncome">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Income"/>
        <rdfs:comment xml:lang="fi">Henkilöllä on tämä tuloerä.</rdfs:comment>
        <rdfs:comment xml:lang="en">The agent has this income item.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">has income</rdfs:label>
        <rdfs:label xml:lang="fi">tulona</rdfs:label>
        <skos:definition xml:lang="en">Relation stating an income item of an agent.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee toimijan tuloerän.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has income</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">tulona</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#hasLocation -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#hasLocation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://kela.fi/ontology/kelao#Organisation"/>
                    <rdf:Description rdf:about="https://kela.fi/ontology/kelao#ServiceUnit"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Location"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://kela.fi/ontology/kelao#hasLocation"/>
            <rdf:Description rdf:about="https://kela.fi/ontology/kelao#isPartOfArea"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="fi">Ominaisuusketju hasLocation o isPartOfArea → hasLocation periyttää sijainnin aluehierarkiassa ylöspäin. Domain on unioni (palvelupiste, organisaatio); ei OWL 2 RL -yhteensopiva, tarkistettava 0.6:ssa.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">is located in</rdfs:label>
        <rdfs:label xml:lang="fi">sijaitsee alueella</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the geographic area in which a service unit or organisation is located.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee maantieteellisen alueen, jolla palvelupiste tai organisaatio sijaitsee.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">is located in</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">sijaitsee alueella</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#hasProvider -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#hasProvider">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Organisation"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">has provider</rdfs:label>
        <rdfs:label xml:lang="fi">vastuuorganisaatio</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the organisation responsible for administering a benefit.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee organisaation, joka vastaa etuuden toimeenpanosta.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has provider</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">vastuuorganisaatio</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#hasServiceChannel -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#hasServiceChannel">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Service"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#ServiceChannel"/>
        <rdfs:comment xml:lang="en">A service has service channels. Services are accessible through service channels.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Palvelulla on palvelukanava. Palvelu on käytettävissä palvelukanavien kautta.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">has channel</rdfs:label>
        <rdfs:label xml:lang="fi">kanava</rdfs:label>
        <skos:closeMatch rdf:resource="http://iri.suomi.fi/model/suomiptv2/hasServiceChannel"/>
        <skos:definition xml:lang="en">Relation stating a service channel through which a service is available.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee palvelukanavan, jonka kautta palvelu on käytettävissä.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has channel</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">kanava</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#hasServiceUnit -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#hasServiceUnit">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Organisation"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#ServiceUnit"/>
        <rdfs:comment xml:lang="fi">Organisaatiolla on palvelupiste.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">has service unit</rdfs:label>
        <rdfs:label xml:lang="fi">on palvelupiste</rdfs:label>
        <skos:definition xml:lang="en">Relation stating a service unit maintained by an organisation.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee organisaation ylläpitämän palvelupisteen.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has service unit</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">on palvelupiste</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#has_part -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#has_part">
        <rdfs:subPropertyOf rdf:resource="http://data.europa.eu/eli/ontology#has_part"/>
        <rdfs:subPropertyOf rdf:resource="http://schema.org/hasPart"/>
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#LegalResource"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#LegalResource"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/ontology#has_part"/>
        <rdfs:comment xml:lang="fi">ELI-ontologian eli:has_part-ominaisuuden aliominaisuus; nimi noudattaa siksi ELI:n snake_case-käytäntöä.</rdfs:comment>
        <rdfs:comment xml:lang="en">Statute has part</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">has part</rdfs:label>
        <rdfs:label xml:lang="fi">on osa säädöstä</rdfs:label>
        <rdfs:label xml:lang="sv">är del av</rdfs:label>
        <skos:definition xml:lang="en">Relation stating a structural part of a legal resource.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee säädöksen rakenteellisen osan.</skos:definition>
        <skos:prefLabel xml:lang="en">has part</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">on osa säädöstä</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">är del av</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#incomeConsideredIn -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#incomeConsideredIn">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Income"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="en">The income item is taken into account in the means testing of this benefit.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Tuloerä otetaan huomioon tämän etuuden tulovähenteisyydessä tai tarveharkinnassa.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">huomioidaan etuudessa</rdfs:label>
        <rdfs:label xml:lang="en">income considered in</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the benefit in whose calculation or means test an income item is taken into account.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuuden, jonka määrää laskettaessa tai tarveharkinnassa tuloerä otetaan huomioon.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">huomioidaan etuudessa</skos:prefLabel>
        <skos:prefLabel xml:lang="en">income considered in</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#inhibiting -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#inhibiting">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c66"/>
        <rdfs:comment xml:lang="fi">Esimerkiksi työkyvyttömyyseläke on estävä etuus ansiopäivärahan, yleistuen ja opintotuen suhteen. Käsite: sanasto c66 (estävä etuus).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">estävä etuus</rdfs:label>
        <rdfs:label xml:lang="sv">hindrande förmån</rdfs:label>
        <rdfs:label xml:lang="en">inhibiting benefit</rdfs:label>
        <skos:definition xml:lang="en">Relation stating a benefit taken into account that prevents this benefit from being granted to the applicant.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee huomioon otettavan etuuden, jonka vuoksi etuudenhakijalle ei myönnetä tätä etuutta.</skos:definition>
        <skos:definition xml:lang="sv">förmån som ska beaktas och på grund av vilken den förmånssökande inte beviljas en annan förmån</skos:definition>
        <skos:prefLabel xml:lang="fi">estävä etuus</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">hindrande förmån</skos:prefLabel>
        <skos:prefLabel xml:lang="en">inhibiting benefit</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c66"/>
        <relationshipAbbreviation>EST</relationshipAbbreviation>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#investigate -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#investigate">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Käyttöala ja nimi tarkistettava 0.6:ssa; verbimuotoinen nimi poikkeaa käytännöstä.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">benefit to investigate</rdfs:label>
        <rdfs:label xml:lang="fi">selvitä etuus</rdfs:label>
        <skos:definition xml:lang="en">Relation stating another benefit whose entitlement must be examined before this benefit is decided.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee toisen etuuden, jonka saamisen edellytykset on selvitettävä ennen tämän etuuden ratkaisemista.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">benefit to investigate</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">selvitä etuus</skos:prefLabel>
        <relationshipAbbreviation>SEL</relationshipAbbreviation>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#isCriterionFor -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#isCriterionFor">
        <owl:inverseOf rdf:resource="https://kela.fi/ontology/kelao#hasEligibilityCriterion"/>
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#EligibilityCriterion"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Kriteeri koskee tätä etuutta.</rdfs:comment>
        <rdfs:comment xml:lang="en">The criterion applies to this benefit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">is criterion for</rdfs:label>
        <rdfs:label xml:lang="fi">on kriteeri etuudelle</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the benefit for which the criterion is an eligibility condition.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuuden, jonka myöntämisedellytys kriteeri on.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">is criterion for</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">on kriteeri etuudelle</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#isEligibleFor -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#isEligibleFor">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#User"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Käsitteellinen suhde: perustuu esiselvitykseen tai päätökseen. Tietämysgraafi ei sisällä henkilökohtaisia oikeustietoja.</rdfs:comment>
        <rdfs:comment xml:lang="en">User or applicant has been determined eligible for the benefit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">is eligible for</rdfs:label>
        <rdfs:label xml:lang="fi">on oikeutettu etuuteen</rdfs:label>
        <skos:definition xml:lang="en">Relation stating a benefit to which the user has been found entitled.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuuden, johon käyttäjä on todettu oikeutetuksi.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">is eligible for</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">on oikeutettu etuuteen</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#isLifeSituationFor -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#isLifeSituationFor">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#LifeSituation"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">is life situation for</rdfs:label>
        <rdfs:label xml:lang="fi">on elämäntilanne kohteelle</rdfs:label>
        <skos:definition xml:lang="en">Relation stating a benefit to which a life situation is related.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuuden, johon elämäntilanne liittyy.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">is life situation for</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">on elämäntilanne kohteelle</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#isPartOfArea -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#isPartOfArea">
        <owl:inverseOf rdf:resource="https://kela.fi/ontology/kelao#containsArea"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Location"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Location"/>
        <rdfs:comment xml:lang="en">A geographic area is part of another geographic area. Transitive generic property; specific administrative containment relations are its subproperties.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Alue on osa toista maantieteellistä aluetta. Transitiivinen yleisominaisuus, jonka aliominaisuuksia hallinnolliset kuulumissuhteet (kunta-hyvinvointialue, kunta-maakunta, alue-valtio) ovat.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">is part of area</rdfs:label>
        <rdfs:label xml:lang="fi">on osa aluetta</rdfs:label>
        <skos:closeMatch rdf:resource="http://schema.org/containedInPlace"/>
        <skos:closeMatch rdf:resource="http://www.geonames.org/ontology#parentFeature"/>
        <skos:definition xml:lang="en">Relation stating that an area is part of another geographic area.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee, että alue on osa toista maantieteellistä aluetta.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">is part of area</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">on osa aluetta</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#isPartOfBenefit -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#isPartOfBenefit">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#BenefitComponent"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#StandaloneBenefit"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">is part of benefit</rdfs:label>
        <rdfs:label xml:lang="fi">on osa etuutta</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the standalone benefit of which a benefit component is a part.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee itsenäisen etuuden, jonka osa etuuden osa on.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">is part of benefit</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">on osa etuutta</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#legalReference -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#legalReference">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#LegalResource"/>
        <rdfs:comment xml:lang="fi">Etuus tai palvelu perustuu tähän lakiin tai säädökseen.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">has legal reference</rdfs:label>
        <rdfs:label xml:lang="fi">on lakiviittaus</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the statute on which a benefit is based.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee säädöksen, johon etuus perustuu.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has legal reference</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">on lakiviittaus</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#meansTestedIncome -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#meansTestedIncome">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Vrt. kelao:incomeConsideredIn (tuloerä → etuus). Päällekkäisyys tarkistettava 0.6:ssa.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">means-tested income</rdfs:label>
        <rdfs:label xml:lang="fi">tarveharkinnan tulo</rdfs:label>
        <skos:definition xml:lang="en">Relation stating another benefit that is counted as income in the means test of this benefit.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee toisen etuuden, joka otetaan tulona huomioon tämän etuuden tarveharkinnassa.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">means-tested income</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">tarveharkinnan tulo</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#minimumAmount -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#minimumAmount">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Käyttöala tarkistettava: nykyinen kommentti (&quot;minimimääräinen etuus&quot;) ei kerro suhteen suuntaa.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">minimimääräinen etuus</rdfs:label>
        <rdfs:label xml:lang="en">minimum amount benefit</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the benefit that determines the minimum amount of this benefit.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuuden, joka määrää tämän etuuden vähimmäismäärän.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">minimimääräinen etuus</skos:prefLabel>
        <skos:prefLabel xml:lang="en">minimum amount benefit</skos:prefLabel>
        <relationshipAbbreviation>MIN</relationshipAbbreviation>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#noteworthy -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#noteworthy">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Täydentää suhteita kelao:inhibiting ja kelao:reducing (vrt. sanaston huomioon otettava etuus, c63). Nimi ja käyttöala tarkistettava.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">benefit to be noted</rdfs:label>
        <rdfs:label xml:lang="fi">huomautus</rdfs:label>
        <skos:definition xml:lang="en">Relation stating another benefit to be noted when deciding this benefit without preventing or reducing it.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee toisen etuuden, joka on otettava huomioon tätä etuutta ratkaistaessa ilman että se estää tai vähentää etuutta.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">benefit to be noted</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">huomautus</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c63"/>
        <relationshipAbbreviation>HUO</relationshipAbbreviation>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#paymentBasedOnDecision -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#paymentBasedOnDecision">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Payment"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Decision"/>
        <rdfs:comment xml:lang="fi">Maksu perustuu tähän ratkaisuun.</rdfs:comment>
        <rdfs:comment xml:lang="en">The payment is based on this decision.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">payment based on decision</rdfs:label>
        <rdfs:label xml:lang="fi">perustuu ratkaisuun</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the decision on which a payment is based.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee päätöksen, johon maksu perustuu.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">payment based on decision</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">perustuu ratkaisuun</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#paymentOf -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#paymentOf">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Payment"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Maksu on tämän etuuden suoritus.</rdfs:comment>
        <rdfs:comment xml:lang="en">The payment is a disbursement of this benefit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">etuuden maksu</rdfs:label>
        <rdfs:label xml:lang="en">payment of</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the benefit of which the payment is a disbursement.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuuden, jonka suoritus maksu on.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">etuuden maksu</skos:prefLabel>
        <skos:prefLabel xml:lang="en">payment of</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#paymentRecipient -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#paymentRecipient">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Payment"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c76"/>
        <rdfs:comment xml:lang="fi">Maksunsaaja ei aina ole sama kuin etuudensaaja, esimerkiksi alaikäisen etuudensaajan huoltaja, kunta tai vuokranantaja.</rdfs:comment>
        <rdfs:comment xml:lang="en">Recipient of the payment. May differ from the applicant (e.g. landlord or municipality).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">maksun saajana</rdfs:label>
        <rdfs:label xml:lang="en">payment recipient</rdfs:label>
        <skos:definition xml:lang="sv">Person eller organisation som en ekonomisk förmån betalas till.</skos:definition>
        <skos:definition xml:lang="en">Relation stating the person or organisation to whom a monetary benefit is paid.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee henkilön tai organisaation, jolle rahallinen etuus maksetaan.</skos:definition>
        <skos:prefLabel xml:lang="fi">maksun saajana</skos:prefLabel>
        <skos:prefLabel xml:lang="en">payment recipient</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c76"/>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#receivesBenefit -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#receivesBenefit">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Beneficiary"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Saaja saa tätä etuutta.</rdfs:comment>
        <rdfs:comment xml:lang="en">The beneficiary receives this benefit.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">receives benefit</rdfs:label>
        <rdfs:label xml:lang="fi">saa etuutta</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the benefit that a beneficiary receives.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuuden, jota etuudensaaja saa.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">receives benefit</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">saa etuutta</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#recoveryConcerns -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#recoveryConcerns">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Recovery"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Payment"/>
        <rdfs:comment xml:lang="fi">Takaisinperintä kohdistuu tähän maksuun.</rdfs:comment>
        <rdfs:comment xml:lang="en">The recovery concerns this payment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">kohdistuu maksuun</rdfs:label>
        <rdfs:label xml:lang="en">recovery concerns</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the payment that a recovery concerns.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee maksun, johon takaisinperintä kohdistuu.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">kohdistuu maksuun</skos:prefLabel>
        <skos:prefLabel xml:lang="en">recovery concerns</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#reducing -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#reducing">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c65"/>
        <rdfs:comment xml:lang="fi">Käsite: sanasto c65 (vähentävä etuus).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">reducing benefit</rdfs:label>
        <rdfs:label xml:lang="fi">vähentävä etuus</rdfs:label>
        <skos:definition xml:lang="en">Relation stating a benefit taken into account that reduces the amount of this benefit.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee huomioon otettavan etuuden, joka vähentää tämän etuuden määrää.</skos:definition>
        <skos:definition xml:lang="sv">förmån som ska beaktas och som minskar beloppet av en annan förmån</skos:definition>
        <skos:prefLabel xml:lang="en">reducing benefit</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">vähentävä etuus</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c65"/>
        <relationshipAbbreviation>VÄH</relationshipAbbreviation>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#referenceToBenefit -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#referenceToBenefit">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#DataProduct"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Etuus, johon tietotuote (esim. raportti) liittyy.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">etuus johon raportti kuuluu</rdfs:label>
        <rdfs:label xml:lang="en">reference to benefit</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the benefit that a data product concerns.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuuden, jota tietotuote koskee.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">etuus johon raportti kuuluu</skos:prefLabel>
        <skos:prefLabel xml:lang="en">reference to benefit</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#relatedBenefit -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#relatedBenefit">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#LegalResource"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:comment xml:lang="fi">Käänteinen suunta suhteelle kelao:legalReference. Label &quot;säädös tai vaatimusprofiili koskee etuutta&quot; lyhennettävä.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">has related benefit</rdfs:label>
        <rdfs:label xml:lang="fi">säädös tai vaatimusprofiili koskee etuutta</rdfs:label>
        <skos:definition xml:lang="en">Relation stating a benefit that a statute concerns.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuuden, jota säädös koskee.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">has related benefit</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">säädös tai vaatimusprofiili koskee etuutta</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#relatedService -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#relatedService">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Service"/>
        <rdfs:comment xml:lang="en">A service related to the benefit, e.g. an application or advisory service.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Etuuteen liittyvä palvelu, esim. hakemus- tai neuvontapalvelu.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">etuuteen liittyvä palvelu</rdfs:label>
        <rdfs:label xml:lang="en">related service</rdfs:label>
        <skos:definition xml:lang="en">Relation stating a service related to a benefit.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee etuuteen liittyvän palvelun.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">etuuteen liittyvä palvelu</skos:prefLabel>
        <skos:prefLabel xml:lang="en">related service</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#relatedToLifeSituation -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#relatedToLifeSituation">
        <owl:inverseOf rdf:resource="https://kela.fi/ontology/kelao#isLifeSituationFor"/>
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Benefit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#LifeSituation"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">liittyy elämäntilanteeseen</rdfs:label>
        <rdfs:label xml:lang="en">related to life situation</rdfs:label>
        <skos:definition xml:lang="en">Relation stating a life situation to which a benefit is related.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee elämäntilanteen, johon etuus liittyy.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">liittyy elämäntilanteeseen</skos:prefLabel>
        <skos:prefLabel xml:lang="en">related to life situation</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#residesInMunicipality -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#residesInMunicipality">
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#Applicant"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Municipality"/>
        <rdfs:comment xml:lang="fi">Hakijan tai ruokakunnan asuinkunta.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">asuu kunnassa</rdfs:label>
        <rdfs:label xml:lang="en">resides in municipality</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the municipality in which the applicant resides.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee kunnan, jossa hakija asuu.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">asuu kunnassa</skos:prefLabel>
        <skos:prefLabel xml:lang="en">resides in municipality</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käsitteellinen suhde. KELAO-tietämysgraafi ei sisällä hakijakohtaisia instansseja.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#roleOfCustomer -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#roleOfCustomer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://kela.fi/ontology/kelao#Applicant"/>
                    <rdf:Description rdf:about="https://kela.fi/ontology/kelao#Beneficiary"/>
                    <rdf:Description rdf:about="https://kela.fi/ontology/kelao#User"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Customer"/>
        <rdfs:comment xml:lang="fi">Funktionaalinen: yksi rooli-instanssi kiinnittyy täsmälleen yhteen asiakkaaseen. Domain on unioni (hakija, käyttäjä, etuudensaaja); ei OWL 2 RL -yhteensopiva, tarkistettava 0.6:ssa.</rdfs:comment>
        <rdfs:comment xml:lang="en">The role (applicant, user or beneficiary) belongs to this customer. Functional: one role instance is attached to exactly one customer.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">asiakkaan roolina</rdfs:label>
        <rdfs:label xml:lang="en">role of customer</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the customer to whom a role belongs.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee asiakkaan, jolle rooli kuuluu.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">asiakkaan roolina</skos:prefLabel>
        <skos:prefLabel xml:lang="en">role of customer</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#serviceUnitOrganization -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#serviceUnitOrganization">
        <owl:inverseOf rdf:resource="https://kela.fi/ontology/kelao#hasServiceUnit"/>
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#ServiceUnit"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#Organisation"/>
        <rdfs:comment xml:lang="fi">Palvelupisteen vastuuorganisaatio.</rdfs:comment>
        <rdfs:comment xml:lang="en">Service unit has organisation</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">palvelupisteen organisaatio</rdfs:label>
        <rdfs:label xml:lang="en">service unit organisation</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the organisation responsible for a service unit.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee palvelupisteestä vastaavan organisaation.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">palvelupisteen organisaatio</skos:prefLabel>
        <skos:prefLabel xml:lang="en">service unit organisation</skos:prefLabel>
    </owl:ObjectProperty>
    


    <!-- https://kela.fi/ontology/kelao#type_document -->


    <owl:ObjectProperty rdf:about="https://kela.fi/ontology/kelao#type_document">
        <rdfs:subPropertyOf rdf:resource="http://data.europa.eu/eli/ontology#type_document"/>
        <rdfs:subPropertyOf rdf:resource="http://schema.org/legislationType"/>
        <rdfs:domain rdf:resource="https://kela.fi/ontology/kelao#LegalResource"/>
        <rdfs:range rdf:resource="https://kela.fi/ontology/kelao#StatuteType"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/ontology#type_document"/>
        <rdfs:comment xml:lang="fi">ELI-ontologian eli:type_document-ominaisuuden aliominaisuus; nimi noudattaa ELI:n käytäntöä. Arvot ovat kelao:StatuteType-yksilöitä.</rdfs:comment>
        <rdfs:comment xml:lang="en">Statute type</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">säädöksen tyyppi</rdfs:label>
        <rdfs:label xml:lang="sv">type</rdfs:label>
        <rdfs:label xml:lang="en">type of document</rdfs:label>
        <skos:definition xml:lang="en">Relation stating the kind of a legal resource.</skos:definition>
        <skos:definition xml:lang="fi">Suhde, joka ilmaisee säädöksen lajin.</skos:definition>
        <skos:prefLabel xml:lang="fi">säädöksen tyyppi</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">type</skos:prefLabel>
        <skos:prefLabel xml:lang="en">type of document</skos:prefLabel>
    </owl:ObjectProperty>
    


