    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#geonamesId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Maantieteellisen alueen GeoNames-tunniste.</rdfs:comment>
        <rdfs:comment xml:lang="en">Unique identifier in the GeoNames database.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">geonames id</rdfs:label>
        <rdfs:label xml:lang="fi">geonames-tunniste</rdfs:label>
        <skos:definition xml:lang="fi">Alueen tunniste GeoNames-tietokannassa.</skos:definition>
        <skos:definition xml:lang="en">Identifier of an area in the GeoNames database.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">geonames id</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">geonames-tunniste</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:Location-instansseilla.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#homepage -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#homepage">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">homepage</rdfs:label>
        <rdfs:label xml:lang="fi">kotisivu</rdfs:label>
        <skos:definition xml:lang="en">Address of the web page describing a benefit.</skos:definition>
        <skos:definition xml:lang="fi">Etuutta kuvaavan verkkosivun osoite.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:exactMatch rdf:resource="http://iri.suomi.fi/model/suomiptv2/homePage"/>
        <skos:prefLabel xml:lang="en">homepage</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">kotisivu</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:Benefit-instansseilla etuuden kotisivuun viittaamisessa.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#id_local -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#id_local">
        <rdfs:subPropertyOf rdf:resource="http://data.europa.eu/eli/ontology#id_local"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/ontology#id_local"/>
        <rdfs:comment xml:lang="en">National identifier of the legal resource in the form number/year.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Säädöksen kansallinen tunniste muodossa numero/vuosi.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">local identifier</rdfs:label>
        <rdfs:label xml:lang="fi">paikallinen tunniste</rdfs:label>
        <skos:definition xml:lang="en">National identifier of a statute in the form number/year.</skos:definition>
        <skos:definition xml:lang="fi">Säädöksen kansallinen tunniste muodossa numero/vuosi.</skos:definition>
        <skos:exactMatch rdf:resource="http://schema.org/legislationIdentifier"/>
        <skos:prefLabel xml:lang="en">local identifier</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">paikallinen tunniste</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:LegalResource-instansseilla. 
         Arvo on säädöksen kansallinen numero/vuosi-tunniste, 
         esim. &apos;404/1948&apos; tai &apos;1301/2007&apos;.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#identifier -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#identifier">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/ontology#"/>
        <rdfs:comment xml:lang="en">Official ELI URI identifying the legal resource on Finlex.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Säädöksen virallinen ELI-URI Finlex-sivulle.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">identifier</rdfs:label>
        <rdfs:label xml:lang="fi">tunniste</rdfs:label>
        <skos:definition xml:lang="en">Official ELI identifier (URI) of a statute.</skos:definition>
        <skos:definition xml:lang="fi">Säädöksen virallinen ELI-tunniste (URI).</skos:definition>
        <skos:exactMatch rdf:resource="http://data.europa.eu/eli/ontology#eli"/>
        <skos:exactMatch rdf:resource="http://schema.org/identifier"/>
        <skos:prefLabel xml:lang="en">identifier</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">tunniste</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:LegalResource-instansseilla. 
         Arvo on xsd:anyURI-muotoinen ELI-URI Finlex-palveluun, 
         esim. &apos;https://www.finlex.fi/fi/laki/ajantasa/2007/20071301&apos;.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#indexLinked -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#indexLinked">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Esimerkiksi kansaneläkeindeksi (sanasto c520). Arvojoukko koodistona 0.6:ssa.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">indeksisidonnainen</rdfs:label>
        <rdfs:label xml:lang="en">index linked</rdfs:label>
        <skos:definition xml:lang="fi">Indeksi, johon etuuden määrä on sidottu.</skos:definition>
        <skos:definition xml:lang="en">Index to which the amount of a benefit is linked.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">indeksisidonnainen</skos:prefLabel>
        <skos:prefLabel xml:lang="en">index linked</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c520"/>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#latitude -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#latitude">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">latitude</rdfs:label>
        <rdfs:label xml:lang="fi">leveysaste</rdfs:label>
        <skos:definition xml:lang="en">Latitude of a location in the WGS84 reference system.</skos:definition>
        <skos:definition xml:lang="fi">Sijainnin leveysaste WGS84-koordinaatistossa.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:exactMatch rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#lat"/>
        <skos:prefLabel xml:lang="en">latitude</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">leveysaste</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:Location-instansseilla. Linkitetty WGS84-sanastoon (geo:lat).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#longitude -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#longitude">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">longitude</rdfs:label>
        <rdfs:label xml:lang="fi">pituusaste</rdfs:label>
        <skos:definition xml:lang="en">Longitude of a location in the WGS84 reference system.</skos:definition>
        <skos:definition xml:lang="fi">Sijainnin pituusaste WGS84-koordinaatistossa.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:exactMatch rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#long"/>
        <skos:prefLabel xml:lang="en">longitude</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">pituusaste</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:Location-instansseilla. Linkitetty WGS84-sanastoon (geo:long).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#maximumAge -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#maximumAge">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Maximum age limit</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">maximum age</rdfs:label>
        <rdfs:label xml:lang="fi">yläikäraja</rdfs:label>
        <rdfs:label xml:lang="sv">övre åldersgräns</rdfs:label>
        <skos:definition xml:lang="en">Age above which a person is not entitled to the benefit.</skos:definition>
        <skos:definition xml:lang="fi">Ikä, jonka ylittänyt henkilö ei ole oikeutettu etuuteen.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">maximum age</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">yläikäraja</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">övre åldersgräns</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#meansTest -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#meansTest">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c688"/>
        <rdfs:comment xml:lang="en">Determining entitlement to benefits requires a means test.</rdfs:comment>
        <rdfs:comment xml:lang="sv">För att fastställa rätten till förmåner krävs en behovsprövning.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Vapaamuotoinen selitys etuuden tarveharkinnasta. Käsite: sanasto c688 (tarveharkinta).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">behovsprövning</rdfs:label>
        <rdfs:label xml:lang="en">means test</rdfs:label>
        <rdfs:label xml:lang="fi">tarveharkinta</rdfs:label>
        <skos:definition xml:lang="en">Description of how the criteria for granting a benefit are applied to a person’s need.</skos:definition>
        <skos:definition xml:lang="fi">Kuvaus siitä, miten etuuksien tai palvelujen myöntämisen kriteerejä sovelletaan henkilön tarpeeseen.</skos:definition>
        <skos:definition xml:lang="sv">Tillämpning av kriterierna för beviljande av förmåner eller service på en persons behov.</skos:definition>
        <skos:prefLabel xml:lang="sv">behovsprövning</skos:prefLabel>
        <skos:prefLabel xml:lang="en">means test</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">tarveharkinta</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c688"/>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#minimumAge -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#minimumAge">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Minimum age limit</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">alaikäraja</rdfs:label>
        <rdfs:label xml:lang="en">minimum age</rdfs:label>
        <rdfs:label xml:lang="sv">nedre åldersgräns</rdfs:label>
        <skos:definition xml:lang="en">Age a person must have reached to be entitled to the benefit.</skos:definition>
        <skos:definition xml:lang="fi">Ikä, jonka henkilön on täytettävä ollakseen oikeutettu etuuteen.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">alaikäraja</skos:prefLabel>
        <skos:prefLabel xml:lang="en">minimum age</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">nedre åldersgräns</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#municipalityCode -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#municipalityCode">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Päällekkäinen yleisen kelao:areaCode-ominaisuuden kanssa.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">kuntakoodi</rdfs:label>
        <rdfs:label xml:lang="en">municipality code</rdfs:label>
        <skos:definition xml:lang="fi">Kunnan kolminumeroinen kuntanumero.</skos:definition>
        <skos:definition xml:lang="en">Three-digit municipality code.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">kuntakoodi</skos:prefLabel>
        <skos:prefLabel xml:lang="en">municipality code</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:Municipality-instansseilla.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#municipalityGroup -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#municipalityGroup">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c552"/>
        <rdfs:comment xml:lang="en">Kela&apos;s municipality group for general housing allowance: I, II, III or IV.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Yleisen asumistuen kuntaryhmäluokitus: I, II, III tai IV.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">kuntaryhmä</rdfs:label>
        <rdfs:label xml:lang="en">municipality group</rdfs:label>
        <skos:definition xml:lang="fi">Asumisen kalleuden perusteella muodostettu kuntien ryhmä, johon kunta on luokiteltu asumistukien ja opintotuen asumislisän laskemista varten.</skos:definition>
        <skos:definition xml:lang="en">Group of municipalities formed on the basis of housing costs, used in calculating housing allowances and the housing supplement of student aid.</skos:definition>
        <skos:definition xml:lang="sv">Grupp av kommuner som bildats för beräkning av bostadsbidrag för pensionstagare, allmänt bostadsbidrag och studiestödets bostadstillägg och som den kommun där den förmånssökandes bostad finns tillhör på basis av hur dyrt boendet är.</skos:definition>
        <skos:prefLabel xml:lang="fi">kuntaryhmä</skos:prefLabel>
        <skos:prefLabel xml:lang="en">municipality group</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c552"/>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:Municipality-instansseilla. Lähdeontologiassa nimellä kuntaryhma.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#officeNumber -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#officeNumber">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">office number</rdfs:label>
        <rdfs:label xml:lang="fi">toimiston numero</rdfs:label>
        <skos:definition xml:lang="en">Number of a service unit in Kela’s internal register of offices.</skos:definition>
        <skos:definition xml:lang="fi">Palvelupisteen numero Kelan sisäisessä toimipisterekisterissä.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">office number</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">toimiston numero</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:ServiceUnit-instansseilla. Lähdeontologiassa nimellä toimisto_nro.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#partIdentifier -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#partIdentifier">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Esim. &apos;23&apos; pykälälle, &apos;1&apos; momentille, &apos;a&apos; kohdalle</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">osan tunniste</rdfs:label>
        <rdfs:label xml:lang="en">part identifier</rdfs:label>
        <skos:definition xml:lang="en">Identifier of a part of a statute.</skos:definition>
        <skos:definition xml:lang="fi">Säädöksen osan tunnus.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">osan tunniste</skos:prefLabel>
        <skos:prefLabel xml:lang="en">part identifier</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#partOrder -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#partOrder">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="fi">Osan järjestysnumero (esim. 1, 2, 3...)</rdfs:comment>
        <rdfs:comment xml:lang="en">Part order of the statute</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">järjestysnumero</rdfs:label>
        <rdfs:label xml:lang="en">part order</rdfs:label>
        <skos:definition xml:lang="en">Ordinal number of a part of a statute.</skos:definition>
        <skos:definition xml:lang="fi">Säädöksen osan järjestysnumero.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">järjestysnumero</skos:prefLabel>
        <skos:prefLabel xml:lang="en">part order</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#partText -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#partText">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Lainosan esim. pykälän teksti</rdfs:comment>
        <rdfs:comment xml:lang="en">Part text of the statute</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">lainosan teksti</rdfs:label>
        <rdfs:label xml:lang="en">part text</rdfs:label>
        <skos:definition xml:lang="fi">Säädöksen osan teksti.</skos:definition>
        <skos:definition xml:lang="en">Text of a part of a statute.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">lainosan teksti</skos:prefLabel>
        <skos:prefLabel xml:lang="en">part text</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#partType -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#partType">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Esimerkiksi luku, pykälä, momentti tai kohta.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">osan tyyppi</rdfs:label>
        <rdfs:label xml:lang="en">part type</rdfs:label>
        <skos:definition xml:lang="en">Kind of a part of a statute.</skos:definition>
        <skos:definition xml:lang="fi">Säädöksen osan laji.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:example xml:lang="fi">momentti</skos:example>
        <skos:example xml:lang="fi">pykälä</skos:example>
        <skos:prefLabel xml:lang="fi">osan tyyppi</skos:prefLabel>
        <skos:prefLabel xml:lang="en">part type</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#postOffice -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#postOffice">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Post office; searched by postal code.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Postitoimipaikka. Haetaan postinumeron perusteella.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">post office</rdfs:label>
        <rdfs:label xml:lang="fi">postitoimipaikka</rdfs:label>
        <skos:definition xml:lang="en">Post office (postal locality).</skos:definition>
        <skos:definition xml:lang="fi">Postitoimipaikka.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">post office</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">postitoimipaikka</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:ServiceChannel- ja kelao:ServiceUnit-instansseilla.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#postalCode -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#postalCode">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">postal code</rdfs:label>
        <rdfs:label xml:lang="fi">postinumero</rdfs:label>
        <skos:definition xml:lang="en">Postal code.</skos:definition>
        <skos:definition xml:lang="fi">Postinumero.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:exactMatch rdf:resource="http://schema.org/postalCode"/>
        <skos:prefLabel xml:lang="en">postal code</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">postinumero</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:ServiceChannel- ja kelao:ServiceUnit-instansseilla.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#processingTime -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#processingTime">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment xml:lang="fi">Arvo xsd:duration-muodossa. Ilmaise arkipäivät samalla ominaisuudella ja kirjaa laskentatapa huomautukseen.</rdfs:comment>
        <rdfs:comment xml:lang="en">Typical time required to process the benefit application.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">handläggningstid</rdfs:label>
        <rdfs:label xml:lang="fi">käsittelyaika</rdfs:label>
        <rdfs:label xml:lang="en">processing time</rdfs:label>
        <skos:definition xml:lang="en">Average processing time of an application from receipt to decision.</skos:definition>
        <skos:definition xml:lang="fi">Hakemuksen keskimääräinen käsittelyaika hakemuksen saapumisesta päätökseen.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="sv">handläggningstid</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">käsittelyaika</skos:prefLabel>
        <skos:prefLabel xml:lang="en">processing time</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">xsd:duration ei kuulu OWL 2 DL -datatyyppikarttaan, mutta on tuettu kaikissa KELAO-kohdejärjestelmissä (GraphDB, Fuseki).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#processingTimeBusinessDays -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#processingTimeBusinessDays">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <rdfs:comment xml:lang="en">Processing time in business days (Monday-Friday, excluding holidays). Decimal values allowed (e.g., 5.1 = 5 days and 0.8 hours).</rdfs:comment>
        <rdfs:comment xml:lang="fi">Päällekkäinen kelao:processingTime-ominaisuuden kanssa.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">käsittelyaika arkipäivinä</rdfs:label>
        <rdfs:label xml:lang="en">processing time in business days</rdfs:label>
        <skos:definition xml:lang="en">Average processing time of an application in business days.</skos:definition>
        <skos:definition xml:lang="fi">Hakemuksen keskimääräinen käsittelyaika arkipäivinä.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">käsittelyaika arkipäivinä</skos:prefLabel>
        <skos:prefLabel xml:lang="en">processing time in business days</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">xsd:duration ei kuulu OWL 2 DL -datatyyppikarttaan, mutta on tuettu kaikissa KELAO-kohdejärjestelmissä (GraphDB, Fuseki).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#purpose -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#purpose">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Etuuden tarkoitus</rdfs:comment>
        <rdfs:comment xml:lang="en">The purpose of the benefit</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">purpose</rdfs:label>
        <rdfs:label xml:lang="sv">syftet med förmånen</rdfs:label>
        <rdfs:label xml:lang="fi">tarkoitus</rdfs:label>
        <skos:definition xml:lang="en">Purpose for which the benefit has been enacted.</skos:definition>
        <skos:definition xml:lang="fi">Tarkoitus, jota varten etuus on säädetty.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">purpose</skos:prefLabel>
        <skos:prefLabel xml:lang="sv">syftet med förmånen</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">tarkoitus</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#recipientUnit -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#recipientUnit">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Esimerkiksi henkilö, ruokakunta (sanasto c544) tai perhe.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="sv">mottagande enhet</rdfs:label>
        <rdfs:label xml:lang="en">recipient unit</rdfs:label>
        <rdfs:label xml:lang="fi">saajayksikkö</rdfs:label>
        <skos:definition xml:lang="en">Unit to which the benefit is granted and on the basis of which its amount is calculated.</skos:definition>
        <skos:definition xml:lang="fi">Yksikkö, jolle etuus myönnetään ja jonka perusteella etuuden määrä lasketaan.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="sv">mottagande enhet</skos:prefLabel>
        <skos:prefLabel xml:lang="en">recipient unit</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">saajayksikkö</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c544"/>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#reportCollection -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#reportCollection">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Raporttikokonaisuus, johon raportti sisältyy.</rdfs:comment>
        <rdfs:comment xml:lang="en">Report collection the report is included in.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">raporttikokonaisuus</rdfs:label>
        <rdfs:label xml:lang="en">report collection</rdfs:label>
        <skos:definition xml:lang="fi">Raporttikokonaisuus, johon tietotuote sisältyy.</skos:definition>
        <skos:definition xml:lang="en">Report collection to which a data product belongs.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">raporttikokonaisuus</skos:prefLabel>
        <skos:prefLabel xml:lang="en">report collection</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:DataProduct-instansseilla.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#requiresEmploymentHistory -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#requiresEmploymentHistory">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c678"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">requires employment history</rdfs:label>
        <rdfs:label xml:lang="fi">vaatii työhistorian</rdfs:label>
        <skos:definition xml:lang="fi">Tieto siitä, edellyttääkö etuuden saaminen työssäoloehdon täyttymistä.</skos:definition>
        <skos:definition xml:lang="en">Whether entitlement to the benefit requires that the employment condition is met.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">requires employment history</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">vaatii työhistorian</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c678"/>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#residenceRequired -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#residenceRequired">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:source rdf:resource="https://iri.suomi.fi/terminology/kela/c529"/>
        <rdfs:comment xml:lang="fi">Asumisedellytys (sanasto c529): etuudenhakijan täytyy asua Suomessa, EU- tai Eta-maassa tai Sveitsissä.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">residence required</rdfs:label>
        <rdfs:label xml:lang="fi">vaatii asumisen Suomessa</rdfs:label>
        <skos:altLabel xml:lang="fi">asumisedellytys</skos:altLabel>
        <skos:altLabel xml:lang="sv">bosättningskrav</skos:altLabel>
        <skos:definition xml:lang="fi">Tieto siitä, edellyttääkö etuuden saaminen asumisedellytyksen täyttymistä.</skos:definition>
        <skos:definition xml:lang="en">Whether entitlement to the benefit requires that the residence condition is met.</skos:definition>
        <skos:definition xml:lang="sv">krav enligt vilket en förmånssökande ska bo i Finland, ett EU-land, ett EES-land eller Schweiz och en förmånslåtare vid sin död måste bo i något av dessa länder för att förmånssökanden ska ha rätt till en förmån</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">residence required</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">vaatii asumisen Suomessa</skos:prefLabel>
        <skos:relatedMatch rdf:resource="https://iri.suomi.fi/terminology/kela/c529"/>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#responsibleParty -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#responsibleParty">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A responsible party more specific than an organisation, e.g. a group or team.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Organisaatiota tarkempi vastuutaho, esim. ryhmä tai tiimi.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">responsible party</rdfs:label>
        <rdfs:label xml:lang="fi">vastuutaho</rdfs:label>
        <skos:definition xml:lang="en">Organisational unit responsible for a data product.</skos:definition>
        <skos:definition xml:lang="fi">Tietotuotteesta vastaava organisaation osa.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">responsible party</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">vastuutaho</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:DataProduct-instansseilla.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#serviceChannelId -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#serviceChannelId">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
