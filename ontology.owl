        <skos:prefLabel xml:lang="fi">lyhenne</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#additionalInformation -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#additionalInformation">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">The URI of the data product where more information is available.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Tietotuotteen verkko-osoite (URI), josta saa lisätietoja.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">additional information</rdfs:label>
        <rdfs:label xml:lang="fi">lisätietoja</rdfs:label>
        <skos:definition xml:lang="fi">Verkko-osoite, josta saa lisätietoja tietotuotteesta.</skos:definition>
        <skos:definition xml:lang="en">Web address providing further information on a data product.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">additional information</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">lisätietoja</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:DataProduct-instansseilla.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#amount -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#amount">
        <rdfs:subPropertyOf rdf:resource="http://schema.org/amount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="fi">Käytetään etuuden, maksun, tuloerän ja takaisinperinnän määrälle. Valuutta oletusarvoisesti euro.</rdfs:comment>
        <rdfs:comment xml:lang="en">The amount of money.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">amount</rdfs:label>
        <rdfs:label xml:lang="fi">määrä</rdfs:label>
        <skos:definition xml:lang="en">Monetary amount in euros.</skos:definition>
        <skos:definition xml:lang="fi">Rahamäärä euroina.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">amount</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">määrä</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#appealDate -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#appealDate">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date the appeal was filed.</rdfs:comment>
        <rdfs:comment xml:lang="fi">Päivä jolloin muutoksenhaku jätettiin.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">appeal date</rdfs:label>
        <rdfs:label xml:lang="fi">muutoksenhaun päivä</rdfs:label>
        <skos:definition xml:lang="en">Date on which the appeal was lodged.</skos:definition>
        <skos:definition xml:lang="fi">Päivä, jona muutoksenhaku on jätetty.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">appeal date</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">muutoksenhaun päivä</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:Appeal-instansseilla (xsd:date).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#applicationStatus -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#applicationStatus">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Esimerkiksi vireillä, käsittelyssä tai ratkaistu. Arvojoukko koodistona 0.6:ssa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Processing status of the application.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">application status</rdfs:label>
        <rdfs:label xml:lang="fi">hakemuksen tila</rdfs:label>
        <skos:definition xml:lang="fi">Hakemuksen käsittelyn tila.</skos:definition>
        <skos:definition xml:lang="en">Processing status of an application.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">application status</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">hakemuksen tila</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:Application-instansseilla. Esim. &apos;vireillä&apos;, &apos;käsittelyssä&apos;, &apos;ratkaistu&apos;.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#areaCode -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#areaCode">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Esimerkiksi kuntanumero tai hyvinvointialueen tunnus. Yleinen ominaisuus; korvaa aluetyyppikohtaiset koodiominaisuudet.</rdfs:comment>
        <rdfs:comment xml:lang="en">Official area code (e.g. municipality number or wellbeing service county identifier).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">aluekoodi</rdfs:label>
        <rdfs:label xml:lang="en">area code</rdfs:label>
        <skos:definition xml:lang="fi">Alueen virallinen koodi kansallisessa koodistossa.</skos:definition>
        <skos:definition xml:lang="en">Official code of an area in a national code list.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">aluekoodi</skos:prefLabel>
        <skos:prefLabel xml:lang="en">area code</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:Location-instansseilla (ja sen alaluokilla).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#areaType -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#areaType">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fi">Päällekkäinen luokan (rdf:type) kanssa.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="fi">alueen tyyppi</rdfs:label>
        <rdfs:label xml:lang="en">area type</rdfs:label>
        <skos:definition xml:lang="fi">Alueen tyyppi.</skos:definition>
        <skos:definition xml:lang="en">Type of an area.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">alueen tyyppi</skos:prefLabel>
        <skos:prefLabel xml:lang="en">area type</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:Location-instansseilla. Lähdeontologiassa nimellä alueTyyppi.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#attachmentInOmaKela -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#attachmentInOmaKela">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="fi">Onko liite haettavissa tai ilmoitettavissa OmaKelassa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Whether the attachment can be requested or reported in OmaKela.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">is attachment in OmaKela</rdfs:label>
        <rdfs:label xml:lang="fi">onko liite OmaKelassa</rdfs:label>
        <skos:definition xml:lang="fi">Tieto siitä, voiko liitteen toimittaa OmaKela-asiointipalvelussa.</skos:definition>
        <skos:definition xml:lang="en">Whether the attachment can be submitted in the OmaKela e-service.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">is attachment in OmaKela</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">onko liite OmaKelassa</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:Attachment-instansseilla (xsd:boolean).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#attachmentUri -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#attachmentUri">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">URI link to where the attachment can be found.</rdfs:comment>
        <rdfs:comment xml:lang="fi">URI-linkki liitteeseen, josta liite löytyy.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">attachment uri</rdfs:label>
        <rdfs:label xml:lang="fi">liitteen uri</rdfs:label>
        <skos:definition xml:lang="fi">Verkko-osoite, josta liitelomake tai -ohje on saatavilla.</skos:definition>
        <skos:definition xml:lang="en">Web address where the attachment form or instructions are available.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">attachment uri</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">liitteen uri</skos:prefLabel>
        <skos:scopeNote xml:lang="fi">Käytetään kelao:Attachment-instansseilla (xsd:anyURI).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#calculationBase -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#calculationBase">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
        <rdfs:label xml:lang="en">calculation base</rdfs:label>
        <rdfs:label xml:lang="fi">laskentaperuste</rdfs:label>
        <skos:definition xml:lang="en">Basis on which the amount of a benefit is calculated.</skos:definition>
        <skos:definition xml:lang="fi">Peruste, jonka mukaan etuuden määrä lasketaan.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="en">calculation base</skos:prefLabel>
        <skos:prefLabel xml:lang="fi">laskentaperuste</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://kela.fi/ontology/kelao#currentVersion -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#currentVersion">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
