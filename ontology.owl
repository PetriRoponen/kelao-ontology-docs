        <rdfs:label xml:lang="en">current version uri</rdfs:label>
        <skos:definition xml:lang="fi">Säädöksen osan ajantasaisen version verkko-osoite.</skos:definition>
        <skos:definition xml:lang="en">Web address of the current version of a part of a statute.</skos:definition>
        <skos:editorialNote xml:lang="fi">Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6).</skos:editorialNote>
        <skos:editorialNote xml:lang="en">The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6).</skos:editorialNote>
        <skos:prefLabel xml:lang="fi">ajantasaisen lainosan URI</skos:prefLabel>
        <skos:prefLabel xml:lang="en">current version uri</skos:prefLabel>
    </owl:DatatypeProperty>
    


