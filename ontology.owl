    <!-- https://kela.fi/ontology/kelao#date_document -->


    <owl:DatatypeProperty rdf:about="https://kela.fi/ontology/kelao#date_document">
        <rdfs:subPropertyOf rdf:resource="http://data.europa.eu/eli/ontology#date_document"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <terms:source rdf:resource="http://data.europa.eu/eli/ontology#date_document"/>
        <rdfs:comment xml:lang="en">Date of adoption or signature of the legal resource (yyyy-mm-dd).</rdfs:comment>
        <rdfs:comment xml:lang="fi">Säädöksen hyväksymis- tai allekirjoituspäivä muodossa vvvv-kk-pp.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://kela.fi/ontology/kelao"/>
