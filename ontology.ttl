            rdfs:label "benefit to be noted"@en ,
                       "huomautus"@fi ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relation stating another benefit to be noted when deciding this benefit without preventing or reducing it."@en ,
                                                             "Suhde, joka ilmaisee toisen etuuden, joka on otettava huomioon tätä etuutta ratkaistaessa ilman että se estää tai vähentää etuutta."@fi ;
