###  https://kela.fi/ontology/kelao#Appeal
:Appeal rdf:type owl:Class ;
        rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
        <http://purl.org/dc/terms/source> <https://iri.suomi.fi/terminology/kela/c741> ,
                                          <https://iri.suomi.fi/terminology/kela/c744> ;
        rdfs:comment "Käytetään sekä oikaisuvaatimuksille että valituksille. Sanastossa muutoksenhaku (c736) on menettely; tämä luokka kuvaa siinä esitettyä vaatimusta."@fi ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Appeal"@en ,
                   "Muutoksenhaku"@fi ,
                   "Ändringssökande"@sv ;
        <http://www.w3.org/2004/02/skos/core#altLabel> "oikaisuvaatimus"@fi ,
                                                       "valitus"@fi ;
        <http://www.w3.org/2004/02/skos/core#closeMatch> <https://iri.suomi.fi/terminology/kela/c741> ,
                                                         <https://iri.suomi.fi/terminology/kela/c744> ;
        <http://www.w3.org/2004/02/skos/core#definition> "A customer’s demand that a decision issued by an authority or an appeal body be changed, made either as a request for rectification or as an appeal."@en ,
                                                         "Asiakkaan vaatimus viranomaisen tai muutoksenhakuelimen antaman päätöksen muuttamisesta, joka tehdään joko oikaisuvaatimuksena tai valituksena."@fi ;
        <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                            "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Appeal"@en ,
                                                        "Muutoksenhaku"@fi ,
                                                        "Ändringssökande"@sv ;
        <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://iri.suomi.fi/terminology/kela/c736> .


###  https://kela.fi/ontology/kelao#AppealBody
:AppealBody rdf:type owl:Class ;
            rdfs:subClassOf :Organisation ;
            <http://purl.org/dc/terms/source> <https://iri.suomi.fi/terminology/kela/c748> ;
            rdfs:comment "Appeal body: an organisation handling appeals, e.g. the Social Security Appeal Board (SAMU) or the Insurance Court."@en ,
                         "Kelan toiminnassa esimerkiksi sosiaaliturva-asioiden muutoksenhakulautakunta (SAMU), opintotuen muutoksenhakulautakunta, vakuutusoikeus ja hallinto-oikeudet."@fi ;
            rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
            rdfs:label "Appeal body"@en ,
                       "Besvärsinstans"@sv ,
                       "Muutoksenhakuelin"@fi ;
            <http://www.w3.org/2004/02/skos/core#definition> "A body that handles appeals and is external to the authority that issued the decision."@en ,
                                                             "Muutoksenhakuja käsittelevä, päätöksen tehneestä viranomaisesta ulkopuolinen toimielin."@fi ,
                                                             "Organ som behandlar sökande av ändring och är fristående från den myndighet som fattat beslutet."@sv ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> <https://iri.suomi.fi/terminology/kela/c748> ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Appeal body"@en ,
                                                            "Besvärsinstans"@sv ,
                                                            "Muutoksenhakuelin"@fi .


###  https://kela.fi/ontology/kelao#Applicant
:Applicant rdf:type owl:Class ;
           rdfs:subClassOf <http://www.w3.org/ns/prov#Agent> ;
           <http://purl.org/dc/terms/source> <https://iri.suomi.fi/terminology/kela/c74> ;
           rdfs:comment "Hakija on asiakkaan prosessirooli (ks. kelao:hasCustomerRole). kelao:User on sovelluksen käyttäjä; sama henkilö voi olla molempia."@fi ;
           rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
           rdfs:label "Applicant"@en ,
                      "Hakija"@fi ,
                      "Sökande"@sv ;
           <http://www.w3.org/2004/02/skos/core#altLabel> "Etuudenhakija"@fi ,
                                                          "Förmånssökande"@sv ;
           <http://www.w3.org/2004/02/skos/core#definition> "A person or organisation that applies for a benefit."@en ,
                                                            "Henkilö tai organisaatio, joka hakee etuutta."@fi ,
                                                            "Person eller organisation som söker en förmån."@sv ;
           <http://www.w3.org/2004/02/skos/core#exactMatch> <https://iri.suomi.fi/terminology/kela/c74> ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Applicant"@en ,
                                                           "Hakija"@fi ,
                                                           "Sökande"@sv ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> "Hakija on prosessirooli. kelao:User on sovelluksen käyttäjä; sama henkilö voi olla molempia."@fi .


###  https://kela.fi/ontology/kelao#Application
:Application rdf:type owl:Class ;
             rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
             <http://purl.org/dc/terms/source> <https://iri.suomi.fi/terminology/kela/c77> ;
             rdfs:comment "Hakemuksen vireilletulo käynnistää asian käsittelyn. Käsitteellinen luokka: tietämysgraafi ei sisällä hakijakohtaisia hakemuksia."@fi ;
             rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
             rdfs:label "Ansökan"@sv ,
                        "Application"@en ,
                        "Hakemus"@fi ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Ansökan om förmån"@sv ,
                                                            "Etuushakemus"@fi ,
                                                            "Förmånsansökan"@sv ;
             <http://www.w3.org/2004/02/skos/core#definition> "A document by which a benefit applicant requests, or a request is made on their behalf and with their consent, to receive a benefit."@en ,
                                                              "Asiakirja, jolla etuudenhakija esittää pyynnön tai hänen puolestaan ja hänen suostumuksellaan esitetään pyyntö saada jotain etuutta."@fi ,
                                                              "Dokument med vilket en förmånssökande anhåller om en förmån eller det på den förmånssökandes vägnar och med hens samtycke anhålls om en förmån."@sv ;
             <http://www.w3.org/2004/02/skos/core#exactMatch> <https://iri.suomi.fi/terminology/kela/c77> ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Ansökan"@sv ,
                                                             "Application"@en ,
                                                             "Hakemus"@fi ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Conceptual class only. The KELAO knowledge graph does not contain applicant-level instances — personal data is processed in Kela's operational systems."@en ,
                                                             "Käsitteellinen luokka. KELAO-tietämysgraafi ei sisällä hakijakohtaisia instansseja — henkilötiedot käsitellään Kelan operatiivisissa järjestelmissä."@fi .


###  https://kela.fi/ontology/kelao#Attachment
:Attachment rdf:type owl:Class ;
            rdfs:subClassOf <http://schema.org/DigitalDocument> ;
            rdfs:comment "An application attachment, e.g. a receipt, certificate or form."@en ,
                         "Hakemuksen liite, esim. tosite, todistus tai lomake."@fi ;
            rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
            rdfs:label "Attachment"@en ,
                       "Bilaga"@sv ,
                       "Liite"@fi ;
            <http://www.w3.org/2004/02/skos/core#definition> "A document or other material attached to an application that supplements or verifies the information given in the application."@en ,
                                                             "Hakemukseen liitettävä asiakirja tai muu aineisto, joka täydentää tai todentaa hakemuksessa esitettyjä tietoja."@fi ;
            <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Attachment"@en ,
                                                            "Bilaga"@sv ,
                                                            "Liite"@fi ;
            <http://www.w3.org/2004/02/skos/core#scopeNote> "Liitettä tarvitaan joskus hakemuksen liitteeksi; pakollisuus on hakemus- tai etuuskohtaista (kuvataan SHACLissa, ei luokkatasolla)."@fi .


###  https://kela.fi/ontology/kelao#Beneficiary
:Beneficiary rdf:type owl:Class ;
             rdfs:subClassOf <http://www.w3.org/ns/prov#Agent> ;
             <http://purl.org/dc/terms/source> <https://iri.suomi.fi/terminology/kela/c75> ;
             rdfs:comment "Beneficiary: recipient of a benefit. Distinguished from the applicant: e.g. child benefit is applied for by a guardian, and the payment recipient may be a different party."@en ,
                          "Erotetaan hakijasta ja maksunsaajasta: esimerkiksi lapsilisän hakija on huoltaja, ja maksunsaaja voi olla eri taho (esim. kunta tai vuokranantaja)."@fi ;
             rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
             rdfs:label "Beneficiary"@en ,
                        "Etuuden saaja"@fi ,
                        "Förmånstagare"@sv ;
             <http://www.w3.org/2004/02/skos/core#definition> "A person or organisation that receives a benefit."@en ,
                                                              "Henkilö tai organisaatio, joka saa etuutta."@fi ,
                                                              "Person eller organisation som får en förmån."@sv ;
             <http://www.w3.org/2004/02/skos/core#exactMatch> <https://iri.suomi.fi/terminology/kela/c75> ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Beneficiary"@en ,
                                                             "Etuuden saaja"@fi ,
                                                             "Förmånstagare"@sv .


###  https://kela.fi/ontology/kelao#Benefit
:Benefit rdf:type owl:Class ;
         rdfs:subClassOf <http://purl.org/vocab/cpsv#PublicService> ;
         <http://purl.org/dc/terms/source> <https://iri.suomi.fi/terminology/kela/c60> ,
                                           <https://iri.suomi.fi/terminology/verotus/c66> ;
         rdfs:comment "A social security benefit or allowance. General class — use subclasses for instances."@en ,
                      "FPA:s förmåner är sociala förmåner. Ibland används också termen socialförsäkringsförmåner."@sv ,
                      "Yleinen luokka. Kelan etuudet ovat sosiaalietuuksia; joskus käytetään myös termiä sosiaaliturvaetuus. Etuus ei aina ole rahamääräinen, mutta sen rahallinen arvo on laskettavissa."@fi ;
         rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
         rdfs:label "Benefit"@en ,
                    "Etuus"@fi ,
                    "Förmån"@sv ;
         rdfs:seeAlso <https://iri.suomi.fi/terminology/verotus/c66> ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "Social benefit"@en ,
                                                        "Sosiaalietuus"@fi ,
                                                        "Tuki"@fi ;
         <http://www.w3.org/2004/02/skos/core#definition> "A good whose economic value can be determined and which is granted on the basis of the recipient’s status or life situation according to predefined criteria."@en ,
                                                          "Nyttighet vars ekonomiska värde kan fastställas och som beviljas utgående från mottagarens ställning eller livssituation på grunder som fastställts i förväg."@sv ,
                                                          "Taloudelliselta arvoltaan määriteltävissä oleva hyödyke, joka myönnetään saajan aseman tai elämäntilanteen perusteella ennalta määritellyin perustein."@fi ;
         <http://www.w3.org/2004/02/skos/core#exactMatch> <https://iri.suomi.fi/terminology/kela/c60> ;
         <http://www.w3.org/2004/02/skos/core#note> "Verotuksen sanaston määritelmä: suoritus, joka maksetaan saajan aseman tai elämäntilanteen perusteella ennalta määritellyin perustein (https://iri.suomi.fi/terminology/verotus/c66)."@fi ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Benefit"@en ,
                                                         "Etuus"@fi ,
                                                         "Förmån"@sv .


###  https://kela.fi/ontology/kelao#BenefitComponent
:BenefitComponent rdf:type owl:Class ;
                  rdfs:subClassOf :Benefit ;
                  owl:disjointWith :StandaloneBenefit ;
                  rdfs:comment "Esimerkiksi opintotuen osia ovat opintoraha, asumislisä ja opintolainan valtiontakaus."@fi ;
                  rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                  rdfs:label "Benefit Component"@en ,
                             "Etuuden osa"@fi ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "etuusosa"@fi ,
                                                                 "sub-benefit"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "A separately handled part of a benefit that can be granted only if the benefit of which it is a part has also been granted."@en ,
                                                                   "Etuuden erikseen käsiteltävä osa, joka voidaan myöntää vain, jos myös se etuus, jonka osa on kyseessä, on myönnetty."@fi ;
                  <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                      "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
                  <http://www.w3.org/2004/02/skos/core#example> "Esimerkiksi opintotuessa etuuden osia ovat opintoraha, asumislisä ja opintolainan valtiontakaus; lesken- ja lapseneläkkeessä osia ovat perus- ja täydennysmäärät."@fi ,
                                                                "For example, the study grant, housing supplement and government guarantee for student loan are parts of the financial aid for students."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Benefit Component"@en ,
                                                                  "Etuuden osa"@fi .


###  https://kela.fi/ontology/kelao#BenefitGroup
:BenefitGroup rdf:type owl:Class ;
              rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                owl:hasValue <http://kela.fi/kg/EtuusryhmaScheme>
                              ] ;
              rdfs:comment "Etuusryhmät ovat skos:Concept-yksilöitä erillisessä luokituksessa (skos:ConceptScheme); yksittäinen etuus liitetään ryhmään ominaisuudella kelao:hasBenefitGroup."@fi ;
              rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
              rdfs:label "Benefit Group"@en ,
                         "Etuusryhmä"@fi ;
              <http://www.w3.org/2004/02/skos/core#definition> "A classification unit that groups related Kela benefits together."@en ,
                                                               "Luokitteluyksikkö, joka kokoaa toisiinsa liittyvät Kelan etuudet yhteen ryhmään."@fi ;
              <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                  "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Benefit Group"@en ,
                                                              "Etuusryhmä"@fi .


###  https://kela.fi/ontology/kelao#Country
:Country rdf:type owl:Class ;
         rdfs:subClassOf :Location ;
         rdfs:comment "Käytetään asumisedellytyksen ja rajat ylittävien tilanteiden (EU, ETA, Sveitsi, sosiaaliturvasopimusmaat) kuvaamiseen. Linkitetty schema:Country-luokkaan."@fi ;
         rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
         rdfs:label "Country"@en ,
                    "Stat"@sv ,
                    "Valtio"@fi ;
         <http://www.w3.org/2004/02/skos/core#definition> "A sovereign state in whose territory a person resides or works, or whose legislation applies to social security."@en ,
                                                          "Itsenäinen valtio, jonka alueella henkilö asuu, työskentelee tai jonka lainsäädäntöä sosiaaliturvaan sovelletaan."@fi ;
         <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                             "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
         <http://www.w3.org/2004/02/skos/core#exactMatch> <http://schema.org/Country> ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Country"@en ,
                                                         "Stat"@sv ,
                                                         "Valtio"@fi ;
         <http://www.w3.org/2004/02/skos/core#scopeNote> "Lähdeontologiassa kuvattu suoraan schema:Country-luokkana; ydinmallissa määritelty omana luokkana ja linkitetty skos:exactMatch-suhteella."@fi .


###  https://kela.fi/ontology/kelao#Customer
:Customer rdf:type owl:Class ;
          rdfs:subClassOf <http://www.w3.org/ns/prov#Agent> ;
          <http://purl.org/dc/terms/source> "Kelan asiakkuuden käsitemalli (sisäinen lähde)"@fi ;
          rdfs:comment "Asiakas on pysyvä identiteetti, johon tilannekohtaiset roolit (hakija, käyttäjä, etuudensaaja) kiinnittyvät roolisuhteen kautta (kelao:hasCustomerRole)."@fi ,
                       "Customer: a person or party having a customer relationship with the social security administrator. The customer is the persistent identity to which contextual roles (applicant, user, beneficiary) are attached via the role-of-customer relation."@en ;
          rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
          rdfs:label "Asiakas"@fi ,
                     "Customer"@en ,
                     "Kund"@sv ;
          <http://www.w3.org/2004/02/skos/core#definition> "A person or organisation that receives, or may receive, value from a service provided by Kela."@en ,
                                                           "Henkilö tai yhteisö, joka saa tai jolla on mahdollisuus saada arvoa Kelan tarjoamasta palvelusta."@fi ;
          <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                              "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Asiakas"@fi ,
                                                          "Customer"@en ,
                                                          "Kund"@sv ;
          <http://www.w3.org/2004/02/skos/core#scopeNote> """Asiakkaat voivat olla ulkoisia tai sisäisiä. Asiakkaat voivat olla henkilöasiakkaita tai yhteisöasiakkaita. 
                Kelan asiakas saa joko suoraan tai välillisesti Kelan tarjoamaa palvelua, kuten esimerkiksi Kelan etuutta tai Kelan tuottamaa tietopalvelua. Yleiskielessä asiakkaalla tarkoitetaan toimijaa, joka hankkii tai saa palveluja tai hankkii tuotteita. 
                Tällainen toimija voi olla henkilö, henkilöryhmä tai organisaatio. Eepoksessa käytetään termiä \"customer\" puhuttaessa Kelan henkilöasiakkaista.
                """@fi .


###  https://kela.fi/ontology/kelao#DataProduct
:DataProduct rdf:type owl:Class ;
             rdfs:comment "A managed and governed collection of data with a purpose, value, ownership and life-cycle that meets consumer needs, e.g. a report or other benefit-related data product."@en ,
                          "Esimerkiksi etuuteen liittyvä raportti tai tilasto. Ehdolla siirrettäväksi ydinontologian ulkopuoliseen laajennusmoduuliin versiossa 0.6."@fi ;
             rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
             rdfs:label "Data Product"@en ,
                        "Informationsprodukt"@sv ,
                        "Tietotuote"@fi ;
             <http://www.w3.org/2004/02/skos/core#definition> "A managed and owned collection of data that has a purpose, value and life cycle and meets the needs of its consumers."@en ,
                                                              "Hallittu ja omistettu tietokokonaisuus, jolla on tarkoitus, arvo ja elinkaari ja joka vastaa tiedon hyödyntäjän tarpeisiin."@fi ;
             <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                 "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Data Product"@en ,
                                                             "Informationsprodukt"@sv ,
                                                             "Tietotuote"@fi ;
             <http://www.w3.org/2004/02/skos/core#scopeNote> "Itsenäinen luokka. Mahdollinen linkitys ulkoiseen data product -sanastoon (esim. DPROD) jätetty myöhempään harmonisointiin."@fi .


###  https://kela.fi/ontology/kelao#Decision
:Decision rdf:type owl:Class ;
          rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
          <http://purl.org/dc/terms/source> <https://iri.suomi.fi/terminology/kela/c78> ;
          rdfs:comment "Etuuspäätös voi olla myönteinen tai kielteinen ja koskea esimerkiksi etuuden myöntämistä, hylkäämistä, tarkistamista, keskeyttämistä, lakkauttamista, maksamista tai takaisinperintää."@fi ;
          rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
          rdfs:label "Beslut"@sv ,
                     "Decision"@en ,
                     "Päätös"@fi ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "beslut om förmån"@sv ,
                                                         "etuuspäätös"@fi ,
                                                         "förmånsbeslut"@sv ;
          <http://www.w3.org/2004/02/skos/core#definition> "A decision resolving a matter concerning a benefit."@en ,
                                                           "Beslut om avgörande av ett ärende som gäller en förmån."@sv ,
                                                           "Päätös etuutta koskevan asian ratkaisemisesta."@fi ;
          <http://www.w3.org/2004/02/skos/core#exactMatch> <https://iri.suomi.fi/terminology/kela/c78> ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Beslut"@sv ,
                                                          "Decision"@en ,
                                                          "Päätös"@fi .


###  https://kela.fi/ontology/kelao#EligibilityCriterion
:EligibilityCriterion rdf:type owl:Class ;
                      rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
                      rdfs:comment "Eligibility criterion: an individual condition affecting entitlement to a benefit (e.g. age limit, residence requirement, income limit, employment condition). Reified so that each criterion can carry its own legal basis and parameters."@en ,
                                   "Esimerkiksi ikäraja, asumisedellytys, tuloraja tai työssäoloehto. Mallinnettu omana luokkana, jotta kriteeri voi kantaa oman oikeusperustansa ja parametrinsa."@fi ;
                      rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                      rdfs:label "Eligibility criterion"@en ,
                                 "Etuuskriteeri"@fi ;
                      <http://www.w3.org/2004/02/skos/core#closeMatch> <http://data.europa.eu/m8g/Criterion> ;
                      <http://www.w3.org/2004/02/skos/core#definition> "A condition for granting a benefit whose fulfilment affects entitlement to the benefit or its amount."@en ,
                                                                       "Etuuden myöntämisedellytys, jonka täyttyminen vaikuttaa oikeuteen saada etuus tai etuuden määrään."@fi ;
                      <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                          "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Eligibility criterion"@en ,
                                                                      "Etuuskriteeri"@fi .


###  https://kela.fi/ontology/kelao#EmploymentArea
:EmploymentArea rdf:type owl:Class ;
                rdfs:subClassOf :Location ;
                <http://purl.org/dc/terms/source> "laki työvoimapalveluiden järjestämisestä (380/2023)"@fi ;
                rdfs:comment "Employment area: a statutory area formed by municipalities responsible for organising public employment services (Finnish TE services reform 2025)."@en ,
                             "Perustuu lakiin työvoimapalveluiden järjestämisestä (380/2023); voimassa 1.1.2025 alkaen."@fi ;
                rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                rdfs:label "Employment area"@en ,
                           "Sysselsättningsområde"@sv ,
                           "Työllisyysalue"@fi ;
                <http://www.w3.org/2004/02/skos/core#definition> "An area formed by municipalities that is responsible for organising public employment services."@en ,
                                                                 "Kuntien muodostama alue, joka vastaa julkisten työvoimapalvelujen järjestämisestä."@fi ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Employment area"@en ,
                                                                "Sysselsättningsområde"@sv ,
                                                                "Työllisyysalue"@fi .


###  https://kela.fi/ontology/kelao#Income
:Income rdf:type owl:Class ;
        rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
        rdfs:comment "Esimerkiksi palkka, yrittäjätulo, pääomatulo tai etuustulo. Vrt. sanaston käsitteet etuoikeutettu tulo (c72) ja etuusperusteinen tulo (c732)."@fi ,
                     "Income: an income item of a person or recipient unit (e.g. wage, self-employment income, capital income, benefit income) that may be taken into account in means testing."@en ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Income"@en ,
                   "Inkomst"@sv ,
                   "Tulo"@fi ;
        <http://www.w3.org/2004/02/skos/core#definition> "An income item of a person or household that may be taken into account when calculating the amount of a benefit or in means testing."@en ,
                                                         "Henkilön tai ruokakunnan tuloerä, joka voidaan ottaa huomioon etuuden määrää laskettaessa tai tarveharkinnassa."@fi ;
        <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                            "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Income"@en ,
                                                        "Inkomst"@sv ,
                                                        "Tulo"@fi ;
        <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://iri.suomi.fi/terminology/kela/c72> ,
                                                           <https://iri.suomi.fi/terminology/kela/c732> .


###  https://kela.fi/ontology/kelao#LegalResource
:LegalResource rdf:type owl:Class ;
               rdfs:subClassOf <http://data.europa.eu/eli/ontology#LegalResource> ;
               <http://purl.org/dc/terms/source> <http://data.europa.eu/eli/ontology#LegalResource> ;
               rdfs:comment "A work in a legislative corpus. This applies to acts that have been legally enacted (whether or not they are still in force). A legal resource can represent a legal act or any component of a legal act, like an article. Legal resources can be linked together using properties defined in the model."@en ,
                            "Vastaa ELI-ontologian LegalResource-luokkaa. Kattaa lait, asetukset ja EU-säädökset riippumatta siitä, ovatko ne voimassa. Säädöksen osat kuvataan luokalla kelao:LegalResourcePart."@fi ;
               rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
               rdfs:label "Juridisk resurs"@sv ,
                          "Legal Resource"@en ,
                          "Säädös"@fi ;
               <http://www.w3.org/2004/02/skos/core#definition> "A statute issued by a public authority and intended to be generally binding, or a version of it."@en ,
                                                                "Julkisen vallan antama, yleisesti noudatettavaksi tarkoitettu säädös tai sen versio."@fi ;
               <http://www.w3.org/2004/02/skos/core#exactMatch> <http://schema.org/Legislation> ;
               <http://www.w3.org/2004/02/skos/core#example> "Examples of statutes are acts and decrees as well as legal provisions issued by authorities."@en ,
                                                             "Säädöksiä ovat esimerkiksi lait ja asetukset sekä viranomaisten antamat oikeussäännöt."@fi ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Juridisk resurs"@sv ,
                                                               "Legal Resource"@en ,
                                                               "Säädös"@fi .


###  https://kela.fi/ontology/kelao#LegalResourcePart
:LegalResourcePart rdf:type owl:Class ;
                   rdfs:subClassOf <http://data.europa.eu/eli/ontology#LegalResource> ;
                   rdfs:comment "Esimerkiksi kansaneläkelain 23 §. Erottaa kokonaiset säädökset niiden osista; EU-säädöksissä jaottelu (artikla, kohta) poikkeaa kansallisesta."@fi ;
                   rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                   rdfs:label "Lagdel"@sv ,
                              "Lain osa"@fi ,
                              "Legal Resource Part"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A structural part of a statute, such as a chapter, section, subsection or paragraph."@en ,
                                                                    "Säädöksen rakenteellinen osa, kuten luku, pykälä, momentti tai kohta."@fi ;
                   <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                       "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
                   <http://www.w3.org/2004/02/skos/core#example> "Kansaneläkelain 23 §"@fi ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Lagdel"@sv ,
                                                                   "Lain osa"@fi ,
                                                                   "Legal Resource Part"@en .


###  https://kela.fi/ontology/kelao#LifeSituation
:LifeSituation rdf:type owl:Class ;
               rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                                 owl:hasValue <http://kela.fi/kg/ElamantilanneluokitusScheme>
                               ] ;
               rdfs:comment "A life situation is a phase of change or circumstance in a citizen's life associated with a need for public services and benefits. Individual life situations form the life-situation classification (a skos:ConceptScheme)."@en ,
                            "Yksittäiset elämäntilanteet muodostavat elämäntilanneluokituksen (skos:ConceptScheme), jonka pohjana on DVV:n elämäntapahtumaluokitus."@fi ;
               rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
               rdfs:label "Elämäntilanne"@fi ,
                          "Life Situation"@en ,
                          "Livssituation"@sv ;
               <http://www.w3.org/2004/02/skos/core#definition> "A phase or circumstance in a person’s life that involves a need for public services or benefits."@en ,
                                                                "Henkilön elämän vaihe tai tilanne, johon liittyy julkisten palvelujen tai etuuksien tarve."@fi ;
               <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                   "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Elämäntilanne"@fi ,
                                                               "Life Situation"@en ,
                                                               "Livssituation"@sv .


