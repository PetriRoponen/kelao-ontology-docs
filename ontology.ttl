###  https://kela.fi/ontology/kelao#hasCustomerRole
:hasCustomerRole rdf:type owl:ObjectProperty ;
                 owl:inverseOf :roleOfCustomer ;
                 rdfs:domain :Customer ;
                 rdfs:range [ rdf:type owl:Class ;
                              owl:unionOf ( :Applicant
                                            :Beneficiary
                                            :User
                                          )
                            ] ;
                 rdfs:comment "Asiakkaalla on tämä rooli (hakija, käyttäjä tai etuuden saaja). Sama asiakas voi olla useassa roolissa samanaikaisesti tai eri yhteyksissä."@fi ,
                              "The customer has this role (applicant, user or beneficiary). The same customer may hold several roles simultaneously or in different contexts."@en ;
                 rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                 rdfs:label "asiakkaan rooli"@fi ,
                            "has customer role"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Relation stating a role (applicant, user or beneficiary) in which a customer acts."@en ,
                                                                  "Suhde, joka ilmaisee roolin (hakija, käyttäjä tai etuudensaaja), jossa asiakas toimii."@fi ;
                 <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                     "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "asiakkaan rooli"@fi ,
                                                                 "has customer role"@en .


