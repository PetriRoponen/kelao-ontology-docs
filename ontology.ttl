<http://www.w3.org/2004/02/skos/core#inScheme> rdf:type owl:ObjectProperty .


###  https://kela.fi/ontology/kelao#advancePayment
:advancePayment rdf:type owl:ObjectProperty ;
                rdfs:domain :Benefit ;
                rdfs:range :Benefit ;
                rdfs:comment "Käytetään etuuksien välisen ennakkosuoritussuhteen kuvaamiseen. Käyttöala tarkistettava."@fi ;
                rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                rdfs:label "advance payment"@en ,
                           "ennakkosuoritus"@fi ;
                <http://www.w3.org/2004/02/skos/core#definition> "Relation stating that a benefit may be paid as an advance for the waiting period of another benefit."@en ,
                                                                 "Suhde, joka ilmaisee, että etuutta voidaan maksaa ennakkona toisen etuuden odotusajalta."@fi ;
                <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                    "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "advance payment"@en ,
                                                                "ennakkosuoritus"@fi ;
                :relationshipAbbreviation "ENN" .


###  https://kela.fi/ontology/kelao#appealHandledBy
:appealHandledBy rdf:type owl:ObjectProperty ;
                 rdfs:domain :Appeal ;
                 rdfs:range :AppealBody ;
                 rdfs:comment "The appeal is handled by this appeal body."@en ,
                              "Valituksen käsittelee tämä muutoksenhakuelin."@fi ;
                 rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                 rdfs:label "appeal handled by"@en ,
                            "käsittelevä muutoksenhakuelin"@fi ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Relation stating the appeal body that handles the appeal."@en ,
                                                                  "Suhde, joka ilmaisee muutoksenhakuelimen, joka käsittelee muutoksenhaun."@fi ;
                 <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                     "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "appeal handled by"@en ,
                                                                 "käsittelevä muutoksenhakuelin"@fi .


###  https://kela.fi/ontology/kelao#appealsDecision
:appealsDecision rdf:type owl:ObjectProperty ;
                 rdfs:domain :Appeal ;
                 rdfs:range :Decision ;
                 rdfs:comment "Päätös, johon muutoksenhaku kohdistuu."@fi ,
                              "The decision the appeal is directed against."@en ;
                 rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                 rdfs:label "appeals decision"@en ,
                            "kohdistuu päätökseen"@fi ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Relation stating the decision that the appeal concerns."@en ,
                                                                  "Suhde, joka ilmaisee päätöksen, johon muutoksenhaku kohdistuu."@fi ;
                 <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                     "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "appeals decision"@en ,
                                                                 "kohdistuu päätökseen"@fi .


###  https://kela.fi/ontology/kelao#applicationConcerns
:applicationConcerns rdf:type owl:ObjectProperty ;
                     rdfs:domain :Application ;
                     rdfs:range :Benefit ;
                     rdfs:comment "Etuus jota hakemus koskee."@fi ,
                                  "The benefit the application concerns."@en ;
                     rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                     rdfs:label "application concerns"@en ,
                                "hakemus koskee etuutta"@fi ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Relation stating the benefit that the application concerns."@en ,
                                                                      "Suhde, joka ilmaisee etuuden, jota hakemus koskee."@fi ;
                     <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                         "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "application concerns"@en ,
                                                                     "hakemus koskee etuutta"@fi .


###  https://kela.fi/ontology/kelao#appliesFor
:appliesFor rdf:type owl:ObjectProperty ;
            rdfs:domain :Applicant ;
            rdfs:range :Benefit ;
            rdfs:comment "Hakija hakee tätä etuutta."@fi ,
                         "The applicant applies for this benefit."@en ;
            rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
            rdfs:label "applies for"@en ,
                       "hakee etuutta"@fi ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relation stating the benefit that the applicant applies for."@en ,
                                                             "Suhde, joka ilmaisee etuuden, jota hakija hakee."@fi ;
            <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "applies for"@en ,
                                                            "hakee etuutta"@fi .


###  https://kela.fi/ontology/kelao#belongsToCountry
:belongsToCountry rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :isPartOfArea ;
                  rdfs:domain :Location ;
                  rdfs:range :Country ;
                  rdfs:comment "Alue kuuluu tähän valtioon. Käytetään maakunnille, hyvinvointialueille, työllisyysalueille ja tarvittaessa suoraan kunnille."@fi ,
                               "The area belongs to this country. Used for regions, wellbeing service counties, employment areas and, where needed, directly for municipalities."@en ;
                  rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                  rdfs:label "belongs to country"@en ,
                             "kuuluu valtioon"@fi ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relation stating the country to which an area belongs."@en ,
                                                                   "Suhde, joka ilmaisee valtion, johon alue kuuluu."@fi ;
                  <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                      "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "belongs to country"@en ,
                                                                  "kuuluu valtioon"@fi .


