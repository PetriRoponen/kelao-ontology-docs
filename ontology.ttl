              rdfs:label "contains area"@en ,
                         "sisältää alueen"@fi ;
              <http://www.w3.org/2004/02/skos/core#closeMatch> <http://schema.org/containsPlace> ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relation stating that an area contains another geographic area."@en ,
                                                               "Suhde, joka ilmaisee, että alue sisältää toisen maantieteellisen alueen."@fi ;
              <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                  "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "contains area"@en ,
                                                              "sisältää alueen"@fi .


