###  https://kela.fi/ontology/kelao#inhibiting
:inhibiting rdf:type owl:ObjectProperty ;
            rdfs:domain :Benefit ;
            rdfs:range :Benefit ;
            <http://purl.org/dc/terms/source> <https://iri.suomi.fi/terminology/kela/c66> ;
            rdfs:comment "Esimerkiksi työkyvyttömyyseläke on estävä etuus ansiopäivärahan, yleistuen ja opintotuen suhteen. Käsite: sanasto c66 (estävä etuus)."@fi ;
            rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
            rdfs:label "estävä etuus"@fi ,
                       "hindrande förmån"@sv ,
                       "inhibiting benefit"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Relation stating a benefit taken into account that prevents this benefit from being granted to the applicant."@en ,
                                                             "Suhde, joka ilmaisee huomioon otettavan etuuden, jonka vuoksi etuudenhakijalle ei myönnetä tätä etuutta."@fi ,
                                                             "förmån som ska beaktas och på grund av vilken den förmånssökande inte beviljas en annan förmån"@sv ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "estävä etuus"@fi ,
                                                            "hindrande förmån"@sv ,
