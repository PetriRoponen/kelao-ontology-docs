                     "Takaisinperintä"@fi ,
                     "Återkrav"@sv ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "Claim for recovery"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "Liikaa tai perusteetta maksetun etuuden periminen takaisin saajalta."@fi ,
                                                           "The reclaiming from the recipient of a benefit that was paid in excess or without grounds."@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Recovery"@en ,
                                                          "Takaisinperintä"@fi ,
                                                          "Återkrav"@sv .


###  https://kela.fi/ontology/kelao#Region
:Region rdf:type owl:Class ;
        rdfs:subClassOf :Location ;
        rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
        rdfs:label "Landskap"@sv ,
