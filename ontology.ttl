###  https://kela.fi/ontology/kelao#hasLocation
:hasLocation rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Organisation
                                         :ServiceUnit
                                       )
                         ] ;
             rdfs:range :Location ;
             owl:propertyChainAxiom ( :hasLocation
                                      :isPartOfArea
                                    ) ;
             rdfs:comment "Ominaisuusketju hasLocation o isPartOfArea → hasLocation periyttää sijainnin aluehierarkiassa ylöspäin. Domain on unioni (palvelupiste, organisaatio); ei OWL 2 RL -yhteensopiva, tarkistettava 0.6:ssa."@fi ;
             rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
             rdfs:label "is located in"@en ,
                        "sijaitsee alueella"@fi ;
             <http://www.w3.org/2004/02/skos/core#definition> "Relation stating the geographic area in which a service unit or organisation is located."@en ,
                                                              "Suhde, joka ilmaisee maantieteellisen alueen, jolla palvelupiste tai organisaatio sijaitsee."@fi ;
             <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                 "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "is located in"@en ,
                                                             "sijaitsee alueella"@fi .


