###  https://kela.fi/ontology/kelao#isPartOfArea
:isPartOfArea rdf:type owl:ObjectProperty ;
              owl:inverseOf :containsArea ;
              rdf:type owl:TransitiveProperty ;
              rdfs:domain :Location ;
              rdfs:range :Location ;
              rdfs:comment "A geographic area is part of another geographic area. Transitive generic property; specific administrative containment relations are its subproperties."@en ,
                           "Alue on osa toista maantieteellistä aluetta. Transitiivinen yleisominaisuus, jonka aliominaisuuksia hallinnolliset kuulumissuhteet (kunta-hyvinvointialue, kunta-maakunta, alue-valtio) ovat."@fi ;
              rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
              rdfs:label "is part of area"@en ,
                         "on osa aluetta"@fi ;
              <http://www.w3.org/2004/02/skos/core#closeMatch> <http://schema.org/containedInPlace> ,
                                                               <http://www.geonames.org/ontology#parentFeature> ;
              <http://www.w3.org/2004/02/skos/core#definition> "Relation stating that an area is part of another geographic area."@en ,
                                                               "Suhde, joka ilmaisee, että alue on osa toista maantieteellistä aluetta."@fi ;
              <http://www.w3.org/2004/02/skos/core#editorialNote> "Määritelmä on ontologian oma ehdotus; tarkistettava Kelan käsiteasiantuntijoiden kanssa (versio 0.6)."@fi ,
                                                                  "The definition is the ontology’s own proposal; to be reviewed with Kela’s terminology experts (version 0.6)."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "is part of area"@en ,
                                                              "on osa aluetta"@fi .


