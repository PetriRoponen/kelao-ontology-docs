###  https://kela.fi/ontology/kelao#Organisation
:Organisation rdf:type owl:Class ;
              rdfs:subClassOf <http://www.w3.org/ns/org#Organization> ;
              <http://purl.org/dc/terms/source> <http://iri.suomi.fi/model/suomiptv2/> ;
              rdfs:comment "Kattaa julkisen, yksityisen ja kolmannen sektorin toimijat. Vastaa PTV:n ja schema.orgin Organization-käsitettä; EU Core Public Organisation on erikoistapaus."@fi ;
              rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
              rdfs:label "Organisaatio"@fi ,
                         "Organisation"@sv ,
                         "Organization"@en ;
              <http://www.w3.org/2004/02/skos/core#broadMatch> <http://data.europa.eu/m8g/PublicOrganisation> ;
              <http://www.w3.org/2004/02/skos/core#closeMatch> <http://xmlns.com/foaf/0.1/Organization> ;
              <http://www.w3.org/2004/02/skos/core#definition> "An association of persons with a common goal and an appropriate structure."@en ,
                                                               "Henkilöiden muodostama yhteenliittymä, jolla on yhteinen tavoite ja tarkoituksenmukainen rakenne."@fi ;
              <http://www.w3.org/2004/02/skos/core#exactMatch> <http://iri.suomi.fi/model/suomiptv2/Organization> ,
