#    Object Properties
#################################################################

###  http://data.europa.eu/eli/ontology#has_part
<http://data.europa.eu/eli/ontology#has_part> rdf:type owl:ObjectProperty .


###  http://data.europa.eu/eli/ontology#type_document
<http://data.europa.eu/eli/ontology#type_document> rdf:type owl:ObjectProperty .


###  http://schema.org/hasPart
<http://schema.org/hasPart> rdf:type owl:ObjectProperty .


###  http://schema.org/legislationType
<http://schema.org/legislationType> rdf:type owl:ObjectProperty .


###  http://www.w3.org/2004/02/skos/core#inScheme
<http://www.w3.org/2004/02/skos/core#inScheme> rdf:type owl:ObjectProperty .


###  https://kela.fi/ontology/kelao#advancePayment
:advancePayment rdf:type owl:ObjectProperty ;
                rdfs:domain :Benefit ;
                rdfs:range :Benefit ;
                rdfs:comment "Advance payment"@en ,
                             "Ennakkosuoritus"@fi ;
                rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                rdfs:label "advance payment"@en ,
                           "ennakkosuoritus"@fi ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "advance payment"@en ,
                                                                "ennakkosuoritus"@fi ;
                :relationshipAbbreviation "ENN" .


###  https://kela.fi/ontology/kelao#appealHandledBy
:appealHandledBy rdf:type owl:ObjectProperty ;
                 rdfs:domain :Appeal ;
                 rdfs:range :AppealBody ;
                 rdfs:comment "The appeal is handled by this appeal body."@en ,
                              "Valituksen käsittelee tämä muutoksenhakuelin."@fi ;
                 rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                 rdfs:label "appeal handled by"@en ,
                            "käsittelevä muutoksenhakuelin"@fi ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "appeal handled by"@en ,
                                                                 "käsittelevä muutoksenhakuelin"@fi .


###  https://kela.fi/ontology/kelao#appealsDecision
:appealsDecision rdf:type owl:ObjectProperty ;
                 rdfs:domain :Appeal ;
                 rdfs:range :Decision ;
                 rdfs:comment "Päätös, johon muutoksenhaku kohdistuu."@fi ,
                              "The decision the appeal is directed against."@en ;
                 rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                 rdfs:label "appeals decision"@en ,
                            "kohdistuu päätökseen"@fi ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "appeals decision"@en ,
                                                                 "kohdistuu päätökseen"@fi .


###  https://kela.fi/ontology/kelao#applicationConcerns
:applicationConcerns rdf:type owl:ObjectProperty ;
                     rdfs:domain :Application ;
                     rdfs:range :Benefit ;
                     rdfs:comment "Etuus jota hakemus koskee."@fi ,
                                  "The benefit the application concerns."@en ;
                     rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                     rdfs:label "application concerns"@en ,
                                "hakemus koskee etuutta"@fi ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "application concerns"@en ,
                                                                     "hakemus koskee etuutta"@fi .


###  https://kela.fi/ontology/kelao#appliesFor
:appliesFor rdf:type owl:ObjectProperty ;
            rdfs:domain :Applicant ;
            rdfs:range :Benefit ;
            rdfs:comment "Hakija hakee tätä etuutta."@fi ,
                         "The applicant applies for this benefit."@en ;
            rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
            rdfs:label "applies for"@en ,
                       "hakee etuutta"@fi ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "applies for"@en ,
                                                            "hakee etuutta"@fi .


###  https://kela.fi/ontology/kelao#belongsToCountry
:belongsToCountry rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :isPartOfArea ;
                  rdfs:domain :Location ;
                  rdfs:range :Country ;
                  rdfs:comment "Alue kuuluu tähän valtioon. Käytetään maakunnille, hyvinvointialueille, työllisyysalueille ja tarvittaessa suoraan kunnille."@fi ,
                               "The area belongs to this country. Used for regions, wellbeing service counties, employment areas and, where needed, directly for municipalities."@en ;
                  rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                  rdfs:label "belongs to country"@en ,
                             "kuuluu valtioon"@fi ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "belongs to country"@en ,
                                                                  "kuuluu valtioon"@fi .


###  https://kela.fi/ontology/kelao#belongsToEmploymentArea
:belongsToEmploymentArea rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :isPartOfArea ;
                         rdfs:domain :Municipality ;
                         rdfs:range :EmploymentArea ;
                         rdfs:comment "Kunta kuuluu tähän työllisyysalueeseen. Ei pakollinen: esim. Ahvenanmaan kunnilla ei ole työllisyysaluetta."@fi ,
                                      "The municipality belongs to this employment area. Optional: e.g. municipalities in Åland have no employment area."@en ;
                         rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                         rdfs:label "belongs to employment area"@en ,
                                    "kuuluu työllisyysalueeseen"@fi ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "belongs to employment area"@en ,
                                                                         "kuuluu työllisyysalueeseen"@fi .


###  https://kela.fi/ontology/kelao#belongsToRegion
:belongsToRegion rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :isPartOfArea ;
                 rdfs:domain :Municipality ;
                 rdfs:range :Region ;
                 rdfs:comment "Kunta kuuluu tähän maakuntaan. Rinnakkainen hierarkia hyvinvointialueeseen kuulumisen kanssa: kunta kuuluu sekä maakuntaan että hyvinvointialueeseen."@fi ,
                              "The municipality belongs to this region (maakunta). Parallel to wellbeing service county membership; the two hierarchies are independent."@en ;
                 rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                 rdfs:label "belongs to region"@en ,
                            "kuuluu maakuntaan"@fi ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "belongs to region"@en ,
                                                                 "kuuluu maakuntaan"@fi .


###  https://kela.fi/ontology/kelao#belongsToWellbeingServiceCounty
:belongsToWellbeingServiceCounty rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf :isPartOfArea ;
                                 rdfs:domain :Municipality ;
                                 rdfs:range :WellbeingServiceCounty ;
                                 rdfs:comment "Belongs to wellbeing service county"@en ,
                                              "Kunta kuuluu tähän hyvinvointialueeseen."@fi ;
                                 rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                                 rdfs:label "belongs to wellbeing service county"@en ,
                                            "kuuluu hyvinvointialueeseen"@fi ;
                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "belongs to wellbeing service county"@en ,
                                                                                 "kuuluu hyvinvointialueeseen"@fi .


###  https://kela.fi/ontology/kelao#broaderBenefit
:broaderBenefit rdf:type owl:ObjectProperty ;
                rdfs:domain :Benefit ;
                rdfs:range :Benefit ;
                rdfs:comment "Broader benefit"@en ,
                             "Laajempi etuus"@fi ;
                rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                rdfs:label "broader benefit"@en ,
                           "laajempi etuus"@fi ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "broader benefit"@en ,
                                                                "laajempi etuus"@fi .


###  https://kela.fi/ontology/kelao#containsArea
:containsArea rdf:type owl:ObjectProperty ,
                       owl:TransitiveProperty ;
              rdfs:domain :Location ;
              rdfs:range :Location ;
              rdfs:comment "A geographic area contains another geographic area. Inverse of 'is part of area'."@en ,
                           "Alue sisältää toisen maantieteellisen alueen. Käänteisominaisuus ominaisuudelle 'on osa aluetta'."@fi ;
              rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
              rdfs:label "contains area"@en ,
                         "sisältää alueen"@fi ;
              <http://www.w3.org/2004/02/skos/core#closeMatch> <http://schema.org/containsPlace> ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "contains area"@en ,
                                                              "sisältää alueen"@fi .


###  https://kela.fi/ontology/kelao#criterionLegalBasis
:criterionLegalBasis rdf:type owl:ObjectProperty ;
                     rdfs:domain :EligibilityCriterion ;
                     rdfs:range :LegalResource ;
                     rdfs:comment "Kriteerin oikeusperusta: viittaus säädökseen tai sen osaan (ELI-URI, pykälätaso)."@fi ,
                                  "Legal basis of the criterion: reference to a legal resource or its subdivision (ELI URI, section level)."@en ;
                     rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                     rdfs:label "criterion legal basis"@en ,
                                "kriteerin oikeusperusta"@fi ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "criterion legal basis"@en ,
                                                                     "kriteerin oikeusperusta"@fi .


###  https://kela.fi/ontology/kelao#dataProductOwner
:dataProductOwner rdf:type owl:ObjectProperty ;
                  rdfs:domain :DataProduct ;
                  rdfs:range :Organisation ;
                  rdfs:comment "Data product owner"@en ,
                               "Tietotuotteen vastuuorganisaatio"@fi ;
                  rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                  rdfs:label "data product owner"@en ,
                             "tietotuotteen vastuuorganisaatio"@fi ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "data product owner"@en ,
                                                                  "tietotuotteen vastuuorganisaatio"@fi .


###  https://kela.fi/ontology/kelao#hasApplication
:hasApplication rdf:type owl:ObjectProperty ;
                rdfs:domain :Applicant ;
                rdfs:range :Application ;
                rdfs:comment "An application submitted by the applicant."@en ,
                             "Hakijan jättämä hakemus."@fi ;
                rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                rdfs:label "has application"@en ,
                           "jätti hakemuksen"@fi ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "has application"@en ,
                                                                "jätti hakemuksen"@fi .


###  https://kela.fi/ontology/kelao#hasAttachment
:hasAttachment rdf:type owl:ObjectProperty ;
               rdfs:domain :Application ;
               rdfs:range :Attachment ;
               rdfs:comment "An attachment belonging to the application."@en ,
                            "Hakemukseen liittyvä liite."@fi ;
               rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
               rdfs:label "hakemuksen liite"@fi ,
                          "has attachment"@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "hakemuksen liite"@fi ,
                                                               "has attachment"@en .


###  https://kela.fi/ontology/kelao#hasBenefitGroup
:hasBenefitGroup rdf:type owl:ObjectProperty ;
                 rdfs:domain :Benefit ;
                 rdfs:range :BenefitGroup ;
                 rdfs:comment "Etuusryhmä"@fi ,
                              "Has benefit group"@en ;
                 rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                 rdfs:label "etuusryhmä"@fi ,
