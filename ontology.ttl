                    rdfs:label "huomioidaan etuudessa"@fi ,
                               "income considered in"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Relation stating the benefit in whose calculation or means test an income item is taken into account."@en ,
                                                                     "Suhde, joka ilmaisee etuuden, jonka määrää laskettaessa tai tarveharkinnassa tuloerä otetaan huomioon."@fi ;
