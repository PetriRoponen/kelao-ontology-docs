###  https://kela.fi/ontology/kelao#Organisation
:Organisation rdf:type owl:Class ;
              rdfs:subClassOf <http://www.w3.org/ns/org#Organization> ;
              rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
              rdfs:label "Organisaatio"@fi ,
                         "Organisation"@sv ,
                         "Organization"@en ;
              <http://www.w3.org/2004/02/skos/core#broadMatch> <http://data.europa.eu/m8g/PublicOrganisation> ;
              <http://www.w3.org/2004/02/skos/core#closeMatch> <http://xmlns.com/foaf/0.1/Organization> ;
              <http://www.w3.org/2004/02/skos/core#definition> "An actor that is an association of individuals with a common goal and a purposeful structure."@en ,
                                                               "Toimija, joka on henkilöiden muodostama yhteenliittymä ja jolla on yhteinen tavoite ja tarkoituksenmukainen rakenne."@fi ;
              <http://www.w3.org/2004/02/skos/core#exactMatch> <http://iri.suomi.fi/model/suomiptv2/Organization> ,
                                                               <http://schema.org/Organization> ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Organisaatio"@fi ,
                                                              "Organisation"@sv ,
                                                              "Organization"@en ;
              <http://www.w3.org/2004/02/skos/core#scopeNote> """KELAO-kontekstissa vastaa PTV:n Organization-käsitettä ja 
        schema.org/Organization-käsitettä. Käytetään kuvaamaan kaikkia 
         toimijaorganisaatioita sektorirajat ylittäen (julkinen, yksityinen, 
         kolmas sektori). EU Core Public Organisation on tämän erikoistapaus."""@fi .


###  https://kela.fi/ontology/kelao#Payment
:Payment rdf:type owl:Class ;
         rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
         rdfs:comment "Maksu tai maksuerä: ratkaisun perusteella maksettu etuussuoritus. Kytkee ratkaisun, etuuden ja saajan rahavirtaan."@fi ,
                      "Payment or instalment: a benefit disbursement made on the basis of a decision. Links the decision, benefit and recipient to the money flow."@en ;
         rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
         rdfs:label "Betalning"@sv ,
                    "Maksu"@fi ,
                    "Payment"@en ;
         <http://www.w3.org/2004/02/skos/core#definition> "A benefit disbursement, or an instalment of one, made on the basis of a decision, linking the decision, benefit and recipient to the money flow."@en ,
                                                          "Ratkaisun perusteella maksettu etuussuoritus tai sen maksuerä, joka kytkee ratkaisun, etuuden ja saajan rahavirtaan."@fi ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Betalning"@sv ,
                                                         "Maksu"@fi ,
                                                         "Payment"@en .


###  https://kela.fi/ontology/kelao#Recovery
:Recovery rdf:type owl:Class ;
          rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
          rdfs:comment "Recovery: reclaiming a benefit paid in excess or without grounds from the recipient."@en ,
                       "Takaisinperintä: liikaa tai perusteetta maksetun etuuden perintä takaisin saajalta."@fi ;
          rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
