                       <http://www.w3.org/2004/02/skos/core#scopeNote> "Käsitteellinen suhde. KELAO-tietämysgraafi ei sisällä hakijakohtaisia instansseja."@fi .


###  https://kela.fi/ontology/kelao#roleOfCustomer
:roleOfCustomer rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain [ rdf:type owl:Class ;
                              owl:unionOf ( :Applicant
                                            :Beneficiary
                                            :User
                                          )
                            ] ;
                rdfs:range :Customer ;
                rdfs:comment "Rooli (hakija, käyttäjä tai etuuden saaja) kuuluu tälle asiakkaalle. Funktionaalinen: yksi rooli-instanssi kiinnittyy täsmälleen yhteen asiakkaaseen."@fi ,
                             "The role (applicant, user or beneficiary) belongs to this customer. Functional: one role instance is attached to exactly one customer."@en ;
                rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                rdfs:label "asiakkaan roolina"@fi ,
                           "role of customer"@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "asiakkaan roolina"@fi ,
                                                                "role of customer"@en .


###  https://kela.fi/ontology/kelao#serviceUnitOrganization
:serviceUnitOrganization rdf:type owl:ObjectProperty ;
                         owl:inverseOf :hasServiceUnit ;
                         rdfs:domain :ServiceUnit ;
                         rdfs:range :Organisation ;
                         rdfs:comment "Palvelupisteen vastuuorganisaatio."@fi ,
                                      "Service unit has organisation"@en ;
                         rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
                         rdfs:label "palvelupisteen organisaatio"@fi ,
                                    "service unit organisation"@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "palvelupisteen organisaatio"@fi ,
                                                                         "service unit organisation"@en .


###  https://kela.fi/ontology/kelao#type_document
:type_document rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://data.europa.eu/eli/ontology#type_document> ,
                                  <http://schema.org/legislationType> ;
               rdfs:domain :LegalResource ;
               rdfs:range :StatuteType ;
               rdfs:comment "Lain tai muun säädöksen tyyppi"@fi ,
                            "Statute type"@en ;
               rdfs:isDefinedBy <https://kela.fi/ontology/kelao> ;
               rdfs:label "säädöksen tyyppi"@fi ,
                          "type"@sv ,
                          "type of document"@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "säädöksen tyyppi"@fi ,
                                                               "type"@sv ,
                                                               "type of document"@en .


